# ButtonsCLI shell integration for bash (4.4+ for command start marks).
# ButtonsCLI starts bash with --rcfile pointing here, so this file first
# loads what bash would have loaded, then adds OSC 133 marks:
# A prompt start, B input start, C command start, D;<exit code> finished.
# To use it over SSH or in a shell ButtonsCLI did not start, source it from
# ~/.bashrc (the guard keeps it from loading twice).
if [ -n "$BUTTONSCLI_SHELL_INTEGRATION" ]; then
    # Started by ButtonsCLI: load your startup files first. Unset the
    # markers first, so a ~/.bashrc that sources this file does not loop.
    unset BUTTONSCLI_SHELL_INTEGRATION
    if [ -n "$BUTTONSCLI_LOGIN_SHELL" ]; then
        unset BUTTONSCLI_LOGIN_SHELL
        [ -r /etc/profile ] && . /etc/profile
        for __bcli_file in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
            if [ -r "$__bcli_file" ]; then
                . "$__bcli_file"
                break
            fi
        done
        unset __bcli_file
    else
        [ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"
    fi
fi
if [ -z "$__bcli_loaded" ] && [[ $- == *i* ]]; then
    __bcli_loaded=1
    __bcli_prompt() {
        local code=$?
        printf '\033]133;D;%s\007\033]133;A\007' "$code"
        return $code
    }
    case ";${PROMPT_COMMAND};" in
        *";__bcli_prompt;"*) ;;
        *) PROMPT_COMMAND="__bcli_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
    esac
    PS1="${PS1}\[\033]133;B\007\]"
    # PS0 is not a prompt line: no \[ \] (they would print raw bytes).
    PS0="${PS0}\033]133;C\007"
fi
