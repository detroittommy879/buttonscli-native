      "custom": {
        "expression": "let drift = 0.16 * sin(t * 0.18);\nlet mist = cloud(p * vec2<f32>(1.15, 1.8) + vec2<f32>(t * 0.025, 0.0));\nlet veil = smoothstep(0.28, 0.85, mist);\nlet winter = mix(c1, c2, 0.18 + 0.48 * veil);\nlet dusk = mix(winter, c4, 0.18 * (0.5 + 0.5 * sin(p.y * 1.7 + mist * 2.0)));\nlet base = dusk * vec3<f32>(0.68 + mist_glow * 0.32);\n\nlet q1 = p * vec2<f32>(7.0 * snow_density) + vec2<f32>(drift, t * fall_speed);\nlet id1 = floor(q1);\nlet seed1 = hash(id1);\nlet center1 = vec2<f32>(0.18) + vec2<f32>(hash(id1 + vec2<f32>(3.7, 9.2)), hash(id1 + vec2<f32>(8.1, 2.4))) * vec2<f32>(0.64);\nlet radius1 = 0.025 + 0.032 * seed1;\nlet flake1 = (1.0 - smoothstep(radius1 * 0.25, radius1, length(fract(q1) - center1))) * (0.45 + 0.55 * seed1);\n\nlet q2 = p * vec2<f32>(12.0 * snow_density) + vec2<f32>(drift * 0.65 + 5.3, t * fall_speed * 0.72);\nlet id2 = floor(q2);\nlet center2 = vec2<f32>(0.18) + vec2<f32>(hash(id2 + vec2<f32>(1.3, 7.8)), hash(id2 + vec2<f32>(4.6, 2.9))) * vec2<f32>(0.64);\nlet flake2 = (1.0 - smoothstep(0.009, 0.037, length(fract(q2) - center2))) * 0.38;\nlet snow = clamp(flake1 + flake2, 0.0, 0.9);\nlet color = mix(base, c3, snow);\nreturn mix(bg, color, strength);",
