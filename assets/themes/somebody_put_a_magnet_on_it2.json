    "shaderLabFragmentShader": "precision mediump float;\n\nuniform sampler2D u_composite;\nuniform vec2 u_resolution;\nuniform vec2 u_texel;\nuniform float u_time;\nuniform float u_strength;\n\nvec2 shaderLabUv() {\n  return vec2(\n    gl_FragCoord.x / u_resolution.x,\n    1.0 - gl_FragCoord.y / u_resolution.y\n  );\n}\n\nvec4 sampleComposite(vec2 uv) {\n  return texture2D(u_composite, clamp(uv, vec2(0.0), vec2(1.0)));\n}\n\nfloat shaderLabLuma(vec3 color) {\n  return dot(color, vec3(0.299, 0.587, 0.114));\n}\n\n\nvoid main() {\n  vec2 uv = shaderLabUv();\n  vec2 centered = uv - 0.5;\n  vec2 warped = centered * (1.0 + vec2(centered.y * centered.y, centered.x * centered.x) * (0.32 + u_strength * 0.38)) + 0.5;\n\n  if (warped.x < 0.0 || warped.x > 1.0 || warped.y < 0.0 || warped.y > 1.0) {\n    gl_FragColor = vec4(0.0);\n    return;\n  }\n\n  vec4 color = sampleComposite(warped);\n  float scan = 0.93 - abs(sin(gl_FragCoord.y * 1.65)) * (0.10 + u_strength * 0.12);\n  float vignette = clamp(1.12 - dot(centered, centered) * (1.1 + u_strength * 0.65), 0.0, 1.0);\n\n  gl_FragColor = vec4(color.rgb * scan * vignette, color.a);\n}",
