      "custom": {
        "expression": "let drift = drift_speed;\nlet band = floor(p.y * 45.0);\nlet gate = hash(vec2<f32>(band, floor(t * 8.0)));\nlet jolt = step(1.0 - 0.08 * glitch_rate, gate) * (hash(vec2<f32>(band + 3.0, floor(t * 8.0))) - 0.5) * 0.14;\nlet q = vec2<f32>(p.x + jolt + t * 0.02 * drift, p.y + t * 0.03 * drift);\nlet local = fract(q * vec2<f32>(0.8, 1.0)) - 0.5;\nlet mask = fill(sd_box(local, vec2<f32>(0.4, 0.4)));\nlet kr = clamp(floor((local.x + 0.412) * 6.25), 0.0, 4.0);\nlet kc = clamp(floor((local.x + 0.4) * 6.25), 0.0, 4.0);\nlet kb = clamp(floor((local.x + 0.388) * 6.25), 0.0, 4.0);\nlet cr1 = mix(c1, c2, step(0.5, kr));\nlet cr2 = mix(cr1, c3, step(1.5, kr));\nlet cr3 = mix(cr2, c5, step(2.5, kr));\nlet bar_r = mix(cr3, c4, step(3.5, kr));\nlet cc1 = mix(c1, c2, step(0.5, kc));\nlet cc2 = mix(cc1, c3, step(1.5, kc));\nlet cc3 = mix(cc2, c5, step(2.5, kc));\nlet bar_c = mix(cc3, c4, step(3.5, kc));\nlet cb1 = mix(c1, c2, step(0.5, kb));\nlet cb2 = mix(cb1, c3, step(1.5, kb));\nlet cb3 = mix(cb2, c5, step(2.5, kb));\nlet bar_b = mix(cb3, c4, step(3.5, kb));\nlet picture = vec3<f32>(bar_r.x, bar_c.y, bar_b.z) * mask * 0.75;\nlet scan = 0.8 + 0.2 * sin(p.y * 942.478);\nlet grain = hash(floor(vec2<f32>((p.x + jolt) * 240.0, p.y * 160.0)) + vec2<f32>(floor(t * 30.0) * 13.0, 0.0));\nlet snow_col = c1 * grain * snow_level * 0.3;\nlet col = (picture + snow_col) * scan;\nreturn mix(bg, col, strength);",
