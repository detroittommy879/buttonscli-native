      "custom": {
        "expression": "var col = vec3<f32>(0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let sc = density * (1.6 - 0.3 * k);\n    let g = p * sc + vec2<f32>(t * (0.03 + 0.04 * k), t * 0.01 * k);\n    let cell = floor(g);\n    let seed = hash(cell + vec2<f32>(k * 13.0, k * 7.0));\n    let dir = select(-1.0, 1.0, seed > 0.5);\n    let r = rotate(fract(g) - 0.5, t * (0.2 + 0.5 * seed) * dir);\n    let morph = 0.5 + 0.5 * sin(t * morph_rate * (0.8 + seed) + seed * 6.28);\n    let oval = length(r * vec2<f32>(1.0, 1.0 + 0.6 * morph)) - 0.18;\n    let morphs = mix(oval, sd_box(r, vec2<f32>(0.15, 0.15)), morph);\n    let lshape = min(sd_segment(r, vec2<f32>(-0.2, -0.2), vec2<f32>(0.2, -0.2)), sd_segment(r, vec2<f32>(-0.2, -0.2), vec2<f32>(-0.2, 0.2))) - 0.015;\n    let dotline = min(sd_circle(r - vec2<f32>(0.2, 0.0), 0.05), sd_segment(r, vec2<f32>(-0.3, 0.0), vec2<f32>(0.1, 0.0)) - 0.01);\n    let pickA = 1.0 - step(0.333, seed);\n    let pickB = step(0.333, seed) * (1.0 - step(0.666, seed));\n    let pickC = step(0.666, seed);\n    let d = pickA * morphs + pickB * lshape + pickC * dotline;\n    let edge = 1.0 - smoothstep(0.0, 0.012, abs(d));\n    let fillv = smoothstep(0.01, -0.01, d) * 0.2;\n    let tint = mix(mix(c1, c2, seed), c3, step(0.85, seed));\n    col += tint * (edge + fillv) * (0.35 + 0.3 * k);\n}\nlet band_d = abs(p.y + 0.28 - 0.05 * cos(p.x * 10.0 - t * 1.2)) - 0.004;\nlet band = (1.0 - smoothstep(0.0, 0.01, band_d)) * c5;\nlet haze = c4 * 0.12 * clamp(1.0 - length(p) * 1.4, 0.0, 1.0);\nlet lit = tonemap(col + band * 0.9 + haze);\nreturn mix(bg, clamp(bg + lit, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
