      "custom": {
        "expression": "var col = mix(c4 * 0.3, c1 * 0.15, smoothstep(-0.5, 0.5, p.y));\nlet r = cat_size;\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let scale = 3.0 + k * 2.5;\n    let speed = drift_speed * (1.0 - 0.25 * k);\n    let g = p * scale + vec2<f32>(t * speed * (1.0 + k), 0.1 * sin(t * 0.2 + k));\n    let cell = floor(g);\n    let seed = hash(cell + vec2<f32>(k * 13.0, 7.0));\n    let spin = 0.5 * (seed - 0.5) * sin(t * 0.6 + seed * 6.28);\n    let bob = vec2<f32>(0.0, 0.04 * sin(t * 1.5 + seed * 6.28));\n    let q = rotate(fract(g) - 0.5 - bob, spin);\n    let morph = 0.85 + 0.2 * sin(t * 0.9 + seed * 9.0);\n    let head = sd_circle(vec2<f32>(q.x, q.y * morph), r);\n    let ears = min(sd_circle(q - vec2<f32>(0.7 * r, 0.8 * r), 0.4 * r), sd_circle(q - vec2<f32>(-0.7 * r, 0.8 * r), 0.4 * r));\n    let body = smin(head, ears, 0.04 * r);\n    let blink = 1.0 - 0.9 * step(0.96, fract(t * 0.35 + seed));\n    let eyes = min(sd_circle(q - vec2<f32>(0.35 * r, 0.1 * r), 0.1 * r * blink), sd_circle(q - vec2<f32>(-0.35 * r, 0.1 * r), 0.1 * r * blink));\n    let present = step(0.45, seed);\n    let tint = mix(c1, c2, seed);\n    let ink = stroke(body, 0.035) + fill(eyes);\n    let face = fill(body) * 0.2;\n    let layer_col = (mix(tint * face, c3, fill(eyes)) + tint * ink) * present * (1.0 - 0.25 * k);\n    col += layer_col;\n}\nlet wave = wave_height * cos(p.x * 6.0 + t * 0.8);\nlet line_glow = halo(abs(p.y - wave), 0.03) * c5 * 0.6;\nlet dot_x = 0.6 * sin(t * 0.25);\nlet dot_pos = vec2<f32>(dot_x, wave_height * cos(dot_x * 6.0 + t * 0.8));\nlet dot = halo(sd_circle(p - dot_pos, 0.02), 0.04) * c3;\nlet corner = vec2<f32>(0.55, -0.25);\nlet rp = rotate(p - corner, t * 0.2);\nlet angle = min(sd_segment(rp, vec2<f32>(0.0, 0.0), vec2<f32>(0.0, 0.12)), sd_segment(rp, vec2<f32>(0.0, 0.0), vec2<f32>(0.12, 0.0)));\nlet corner_glow = stroke(angle, 0.008) * c4 * 1.2;\ncol += line_glow + dot + corner_glow;\nreturn mix(bg, tonemap(col), strength);",
