      "custom": {
        "expression": "let x = p.x * frequency;\nlet phase = x - t * 1.3;\nlet overtone = sin(phase * 2.0 + t * 0.35) * 0.12 + sin(phase * 3.0 - t * 0.2) * 0.06;\nlet wave_a = sin(phase) * 0.23 + overtone * harmonic_mix;\nlet wave_b = sin(x * 1.25 + t * 1.05) * 0.22 + sin(x * 2.5 + t * 0.8) * harmonic_mix * 0.1;\nlet wave_c = (wave_a + wave_b) * 0.65;\nlet da = abs(p.y - 0.58 - wave_a);\nlet db = abs(p.y + 0.58 - wave_b);\nlet dc = abs(p.y - wave_c);\nlet trace_a = exp(-da * 80.0) + exp(-da * 12.0) * 0.3 * glow;\nlet trace_b = exp(-db * 80.0) + exp(-db * 12.0) * 0.3 * glow;\nlet trace_c = exp(-dc * 70.0) + exp(-dc * 10.0) * 0.4 * glow;\nlet beat = 0.5 + 0.5 * sin(x * 0.25 + t * 0.55);\nlet interference = 0.5 + 0.5 * sin(p.y * 9.0 + sin(phase) * 1.8 + sin(x * 1.25 + t) * 1.5);\nlet field = mix(c2, c3, interference) * vec3<f32>(0.25 + 0.13 * beat);\nlet grid_x = pow(0.5 + 0.5 * cos(p.x * 24.0), 24.0);\nlet grid_y = pow(0.5 + 0.5 * cos(p.y * 24.0), 24.0);\nlet grid = c1 * vec3<f32>((grid_x + grid_y) * 0.035);\nlet signal_a = c1 * vec3<f32>(trace_a * 0.8);\nlet signal_b = c3 * vec3<f32>(trace_b * 0.8);\nlet signal_c = mix(c4, c5, beat) * vec3<f32>(trace_c * 0.85);\nlet color = clamp(field + grid + signal_a + signal_b + signal_c, vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
        "name": "Harmonic Fusion",
