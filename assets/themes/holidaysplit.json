    "shaderLabFragmentShader": "precision mediump float;\n\nuniform sampler2D u_composite;\nuniform vec2 u_resolution;\nuniform vec2 u_texel;\nuniform float u_time;\nuniform float u_strength;\n\nvec2 shaderLabUv() {\n  return vec2(\n    gl_FragCoord.x / u_resolution.x,\n    1.0 - gl_FragCoord.y / u_resolution.y\n  );\n}\n\nvec4 sampleComposite(vec2 uv) {\n  return texture2D(u_composite, clamp(uv, vec2(0.0), vec2(1.0)));\n}\n\nfloat shaderLabLuma(vec3 color) {\n  return dot(color, vec3(0.299, 0.587, 0.114));\n}\n\n\nvoid main() {\n  vec2 uv = shaderLabUv();\n\n  vec4 center = sampleComposite(uv);\n  vec4 left = sampleComposite(uv + vec2(-u_texel.x, 0.0));\n  vec4 right = sampleComposite(uv + vec2(u_texel.x, 0.0));\n  vec4 up = sampleComposite(uv + vec2(0.0, u_texel.y));\n  vec4 down = sampleComposite(uv + vec2(0.0, -u_texel.y));\n\n  float surroundAlpha = (left.a + right.a + up.a + down.a) * 0.25;\n  float erosion = smoothstep(0.28, 0.95, surroundAlpha) * u_strength * 0.7;\n  float alpha = max(0.0, center.a - erosion);\n\n  gl_FragColor = vec4(center.rgb, alpha);\n}",
