      "custom": {
        "expression": "let density = 1.2 + amount * 0.27;\nlet flow = p * vec2<f32>(density) + vec2<f32>(t * gravity * 0.08, t * gravity * 0.12);\nlet row = floor(flow.y);\nlet grid = flow + vec2<f32>(row * 0.5, 0.0);\nlet cell = floor(grid);\nlet seed = hash(cell);\nlet q = fract(grid) - vec2<f32>(0.5, 0.57);\nlet size = shape_size * (0.8 + seed * 0.15);\nlet u = q / vec2<f32>(size);\nlet d = (max(abs(u.x) * 0.866025 - u.y * 0.5, u.y) - 0.5) * size;\nlet fill = 1.0 - smoothstep(-0.008, 0.008, d);\nlet courses = u.y * 9.0;\nlet course = floor(courses);\nlet mortarY = 1.0 - smoothstep(0.035, 0.095, abs(fract(courses) - 0.5));\nlet mortarX = 1.0 - smoothstep(0.025, 0.07, abs(fract(u.x * 7.0 + course * 0.5) - 0.5));\nlet mortar = max(mortarY, mortarX * 0.75);\nlet face = smoothstep(-0.025, 0.025, u.x + u.y * 0.2);\nlet sandstone = mix(vec3<f32>(1.0, 0.67, 0.20), vec3<f32>(0.72, 0.29, 0.075), face);\nlet grain = noise(p * vec2<f32>(95.0)) * 0.07;\nlet stone = sandstone * vec3<f32>(0.87 + grain - mortar * 0.28);\nlet rim = exp(-abs(d) * 100.0);\nlet halo = exp(-max(d, 0.0) * 18.0) * (1.0 - fill);\nlet tide = sin(p.y * 2.1 + sin(p.x * 1.8 + t * 0.17) * 0.8 - t * gravity * 0.3);\nlet shore = smoothstep(-0.35, 0.5, tide);\nlet ripples = pow(0.5 + 0.5 * sin(p.y * 32.0 + sin(p.x * 6.0 - t * 0.6) * 2.0 + t * gravity), 9.0);\nlet sea = mix(vec3<f32>(0.015, 0.30, 0.40), vec3<f32>(0.035, 0.74, 0.73), ripples * 0.65 + 0.2);\nlet sand = vec3<f32>(0.76, 0.48, 0.20) + vec3<f32>(grain);\nlet base = mix(sea, sand, shore);\nlet presence = smoothstep(0.0, 0.8, amount);\nlet pyramids = mix(base, stone, fill * presence);\nlet color = clamp(pyramids + vec3<f32>(1.0, 0.61, 0.16) * vec3<f32>(presence * (rim * 0.24 + halo * glow * 0.19)), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
