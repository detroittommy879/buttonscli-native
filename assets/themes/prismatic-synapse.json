        "expression": "let density = 2.0 + amount * 0.55;\nlet clock = t * gravity * 0.22;\nlet radius = length(p);\nlet angle = atan2(p.y, p.x) + clock * 0.22;\nlet wedge = abs(fract(angle / 1.047198 + 0.5) - 0.5) * 1.047198;\nlet folded = vec2<f32>(cos(wedge), sin(wedge)) * vec2<f32>(radius);\nlet q = folded * vec2<f32>(density) + vec2<f32>(clock, -clock * 0.35);\nlet skew = vec2<f32>(q.x + q.y * 0.57735, q.y * 1.1547);\nlet cell = floor(skew);\nlet uv = fract(skew) - vec2<f32>(0.5);\nlet diamond = abs(uv.x) + abs(uv.y);\nlet size = 0.17 + shape_size * 0.95;\nlet tile = 1.0 - smoothstep(size - 0.015, size + 0.015, diamond);\nlet outline = exp(-abs(diamond - size) * 75.0);\nlet aura = exp(-abs(diamond - size) * 12.0);\nlet inner = abs(diamond - size * 0.48);\nlet inset = 1.0 - smoothstep(0.012, 0.027, inner);\nlet lines = min(abs(uv.x), min(abs(uv.y), abs(uv.x + uv.y)));\nlet lattice = 1.0 - smoothstep(0.008, 0.024, lines);\nlet seed = hash(cell);\nlet hue = radius * 0.16 - clock * 0.12 + seed * 0.3 + sin(wedge * 6.0 + radius * 2.0 - clock) * 0.09;\nlet jewel = hsv(fract(hue), 0.86, 0.95);\nlet counter = hsv(fract(hue + 0.47), 0.88, 0.8);\nlet bands = 0.5 + 0.5 * sin(radius * density * 3.0 - clock * 2.0);\nlet ground = mix(vec3<f32>(0.12, 0.035, 0.29), vec3<f32>(0.025, 0.26, 0.34), bands);\nlet facet = mix(0.54, 1.0, step(0.0, uv.x - uv.y));\nlet face = jewel * vec3<f32>(facet);\nlet mosaic = mix(ground, face, tile * 0.9);\nlet tracing = counter * vec3<f32>(inset * tile * 0.65 + lattice * 0.17);\nlet radiance = jewel * vec3<f32>(outline * 0.35 + aura * glow * 0.19);\nlet center = exp(-radius * 4.0) * 0.18;\nlet color = clamp(mosaic + tracing + radiance + counter * vec3<f32>(center), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
