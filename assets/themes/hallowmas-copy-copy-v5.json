      "custom": {
        "expression": "let sun_p = vec2<f32>(0.42, 0.24);\nlet sky_t = smoothstep(-0.05, 0.5, p.y);\nvar col = mix(c2 * 0.7, c4, sky_t * 0.8);\ncol += c5 * 0.28 * (1.0 - smoothstep(0.0, 0.32, p.y + 0.02));\ncol += c3 * halo(sd_circle(p - sun_p, 0.1), 0.45) * sun_glow * 0.8;\ncol = mix(col, c3, fill(sd_circle(p - sun_p, 0.085)));\nfor (var i = 0; i < 5; i++) {\n    let k = f32(i);\n    let bx = fract(t * bird_speed * 0.05 + k * 0.23) * 2.6 - 1.3;\n    let by = 0.3 + 0.12 * hash(vec2<f32>(k, 3.0)) + 0.03 * sin(t * 0.7 + k);\n    let flap = sin(t * 9.0 + k * 2.1) * 0.025;\n    let q = p - vec2<f32>(bx, by);\n    let wing = min(sd_segment(q, vec2<f32>(0.0, 0.0), vec2<f32>(-0.035, flap + 0.012)), sd_segment(q, vec2<f32>(0.0, 0.0), vec2<f32>(0.035, flap + 0.012)));\n    let bird = 1.0 - smoothstep(0.0, 0.004, wing);\n    col = mix(col, c4 * 0.3, bird);\n}\nfor (var i = 0; i < 4; i++) {\n    let k = f32(i) / 3.0;\n    let seed = f32(i);\n    let spd = mix(0.6, 1.5, k) * wave_speed;\n    let amp = mix(0.012, 0.045, k);\n    let surface = mix(0.05, -0.24, k) + amp * sin(p.x * mix(5.0, 2.0, k) + t * spd + seed * 1.9) + amp * 0.5 * sin(p.x * mix(13.0, 6.0, k) - t * spd * 1.7);\n    let edge = smoothstep(-0.003, 0.003, p.y - surface);\n    let water = 1.0 - edge;\n    let deep = mix(c1, c2, k);\n    let wcol = mix(deep, c5, 0.15 * (1.0 - k));\n    let foam = (1.0 - smoothstep(0.0, 0.008, abs(p.y - surface))) * mix(0.5, 0.9, k);\n    col = mix(col, wcol, water);\n    col = mix(col, c3, foam * 0.8 * water);\n    let fx = fract(t * fish_speed * 0.06 * mix(1.0, 0.7, k) + hash(vec2<f32>(seed, 7.0))) * 2.8 - 1.4;\n    let fy = surface - 0.09 - 0.04 * hash(vec2<f32>(seed, 2.0));\n    let fq = p - vec2<f32>(fx, fy);\n    let body = sd_circle(vec2<f32>(fq.x * 2.2, fq.y * 6.0), 0.1);\n    let tail = sd_circle(vec2<f32>((fq.x + 0.042) * 2.5, fq.y * 5.0), 0.1);\n    let fish = 1.0 - smoothstep(0.0, 0.003, min(body, tail));\n    col = mix(col, c4 * 0.3, fish * water);\n}\nreturn mix(bg, tonemap(col), strength);",
