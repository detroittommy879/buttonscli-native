{
  "version": 1,
  "metadata": {
    "id": "pane-focus-canopy-plum",
    "name": "After Rain / Plum",
    "nativeThemeVersion": 1,
    "description": "Slow diffuse light through muted botanical colors. Plum pane; stable hue, dark background, gentle contrast."
  },
  "theme": {
    "mode": "dark",
    "app": {
      "shell": {
        "background": "#090c12",
        "backgroundSecondary": "#141215",
        "buttonBackground": "#141215",
        "border": "#3b323e",
        "textMain": "#e5eaf2",
        "textDim": "#a4afbf",
        "accent": "#b890c3",
        "accentHover": "#c6a8ce",
        "paneDivider": {
          "color": "#b890c3",
          "thickness": 2.0
        }
      },
      "tabs": {
        "background": "#090c12",
        "idleBackground": "#141215",
        "activeBackground": "#3b323e",
        "activeBorder": "#b890c3"
      },
      "presetDock": {
        "background": "#141215",
        "buttonBackground": "#141215",
        "buttonHover": "#3b323e",
        "buttonText": "#e5eaf2",
        "accent": "#b890c3"
      },
      "settings": {
        "background": "#0d111a"
      },
      "statusBar": {
        "background": "#090c12",
        "border": "#3b323e",
        "text": "#bac5d4",
        "warning": "#e8ce8a"
      }
    },
    "terminal": {
      "background": "#09080a",
      "foreground": "#e5eaf2",
      "ansiColors": {
        "black": "#586174",
        "red": "#ed919b",
        "green": "#a3d6a0",
        "yellow": "#e8ce8a",
        "blue": "#95b9f1",
        "magenta": "#ceb0ec",
        "cyan": "#94d6d9",
        "white": "#dce3ed",
        "brightBlack": "#99a3b6",
        "brightRed": "#ffb0b9",
        "brightGreen": "#c1ebbc",
        "brightYellow": "#f5e2ac",
        "brightBlue": "#bad2ff",
        "brightMagenta": "#e0c7ff",
        "brightCyan": "#b6eceb",
        "brightWhite": "#f6f8fc"
      },
      "useGradient": true,
      "gradientType": "linear",
      "gradientAngle": 135.0,
      "gradientColors": [
        "#030408",
        "#100d11",
        "#2e2531",
        "#261e28"
      ],
      "gradientAnimation": false
    }
  },
  "effects": {
    "masterDisabled": false,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "simpleNoiseEnabled": false,
    "shaderBackground": {
      "version": 1,
      "preset": "aurora",
      "strength": 0.9,
      "speed": 0.22,
      "scale": 1.0,
      "animated": true,
      "colors": [
        "#030408",
        "#100d11",
        "#2e2531",
        "#261e28",
        "#392d3c"
      ],
      "theme_colors": false,
      "custom": {
        "name": "Pane Focus / Canopy Haze",
        "expression": "let drift = vec2<f32>(t * 0.025, -t * 0.018);\nlet haze = noise(p * softness + drift);\nlet light = noise(p * softness * 0.6 - drift + vec2<f32>(7.0, 3.0));\nlet ground = mix(c1, c2, 0.35 + haze * 0.45);\nlet canopy = mix(c3, c4, light * 0.4);\nreturn mix(bg, mix(ground, canopy, haze * depth) + c5 * light * 0.035, strength);",
        "y_up": true,
        "variables": [
          {
            "name": "softness",
            "min": 0.3,
            "max": 3.0,
            "value": 1.1
          },
          {
            "name": "depth",
            "min": 0.2,
            "max": 1.0,
            "value": 0.85
          }
        ]
      }
    }
  }
}
