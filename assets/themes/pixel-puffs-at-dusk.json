        "expression": "let qp = floor(p / pixel_size);\nlet row = floor(qp.y / 3.0);\nlet sp = 0.15 + 0.5 * hash(vec2<f32>(row, 7.0));\nlet drifted = qp.x + t * sp * drift * 0.5;\nlet n1 = noise(vec2<f32>(drifted * 0.22, qp.y * 0.55 + 3.0));\nlet n2 = noise(vec2<f32>(drifted * 0.5 + 11.0, qp.y * 1.1));\nlet dens = n1 * 0.7 + n2 * 0.3;\nlet thr = mix(0.62, 0.38, cover);\nlet puff = smoothstep(thr, thr + 0.04, dens);\nlet below = noise(vec2<f32>(drifted * 0.22, (qp.y - 1.0) * 0.55 + 3.0));\nlet shade = clamp(0.5 + (n1 - below) * 4.0, 0.0, 1.0);\nlet dusk = 0.5 + 0.5 * sin(t * 0.03);\nlet grad = smoothstep(-0.5, 0.5, p.y);\nlet sky = mix(mix(c3, c4, grad), mix(c1, c2, grad), dusk);\nlet cloudcol = mix(mix(c1, c5, 0.4), mix(c4, c2, dusk * 0.5), shade);\nlet color = mix(sky, cloudcol, puff * 0.9);\nreturn mix(bg, color, strength);",
