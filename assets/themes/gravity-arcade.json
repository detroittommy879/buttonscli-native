        "expression": "let density = 0.7 + amount * 0.24;\nlet column = floor(p.x * density);\nlet seed = hash(vec2<f32>(column, 7.3));\nlet phase = fract(t * gravity * 0.16 + seed);\nlet fall = 4.0 * phase * phase;\nlet grid = vec2<f32>(p.x * density, p.y * density + fall + seed * 5.0);\nlet cell = floor(grid);\nlet q = fract(grid) - vec2<f32>(0.5);\nlet angle = t * (seed - 0.5) * 1.5 + seed * 6.283;\nlet r = vec2<f32>(q.x * cos(angle) - q.y * sin(angle), q.x * sin(angle) + q.y * cos(angle));\nlet size = shape_size * (0.42 + seed * 0.14);\nlet circle = length(r) - size;\nlet square = max(abs(r.x), abs(r.y)) - size * 0.85;\nlet diamond = (abs(r.x) + abs(r.y)) * 0.7071 - size * 0.85;\nlet triangle = max(abs(r.x) * 0.866 + r.y * 0.5, -r.y) - size * 0.55;\nlet kind = fract(seed * 13.7);\nlet d = select(select(circle, square, kind > 0.25), select(diamond, triangle, kind > 0.75), kind > 0.5);\nlet fill = 1.0 - smoothstep(-0.012, 0.018, d);\nlet edge = exp(-abs(d) * 65.0);\nlet halo = exp(-max(d, 0.0) * 13.0) * (1.0 - fill);\nlet hue = fract(seed + cell.y * 0.117 + t * 0.035);\nlet neon = mix(palette(hue), mix(c1, c2, seed), 0.25);\nlet streak = exp(-abs(q.x) * 55.0) * smoothstep(-0.12, 0.42, q.y) * (0.2 + phase * 0.8);\nlet base = mix(bg, c3 * vec3<f32>(0.22, 0.26, 0.38), 0.6) + mix(c1, c2, 0.5) * vec3<f32>(0.035);\nlet activity = smoothstep(0.0, 0.5, amount);\nlet color = clamp(base + activity * (neon * (fill * 0.78 + halo * glow * 0.48 + streak * glow * 0.24) + mix(neon, c2, 0.35) * edge * 0.45), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
