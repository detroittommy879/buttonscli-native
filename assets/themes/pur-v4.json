        "expression": "let x = p.x;\nlet envA = 0.06 + 0.62 * pow(noise(vec2<f32>(x * 1.8 - t * 0.12, t * 0.17)), 2.0);\nlet envB = 0.05 + 0.53 * pow(noise(vec2<f32>(x * 2.1 + t * 0.14, t * 0.11)), 2.0);\nlet phaseA = x * (13.0 + amount * 2.4) + noise(vec2<f32>(x * 2.7 - t * 0.35, t * 0.21)) * 20.0 - t * 2.4;\nlet phaseB = x * (18.0 + amount * 1.7) + noise(vec2<f32>(x * 1.3, t * 0.28)) * 15.0 + t * 2.1;\nlet waveA = envA * (0.68 * sin(phaseA) + 0.24 * sin(x * 39.0 + t * 1.7));\nlet waveB = -0.10 + envB * (0.72 * sin(phaseB) + 0.22 * sin(x * 52.0 - t * 1.3));\nlet waveC = 0.02 + 0.38 * sin(x * 8.0 + noise(vec2<f32>(x * 3.0, t * 0.18)) * 12.0 - t * 3.0);\nlet da = abs(p.y - waveA);\nlet db = abs(p.y - waveB);\nlet dc = abs(p.y - waveC);\nlet lineA = 0.88 * exp(-da * 300.0) + 0.04 * exp(-da * 32.0);\nlet lineB = 0.80 * exp(-db * 340.0) + 0.035 * exp(-db * 35.0);\nlet lineC = 0.45 * exp(-dc * 250.0) + 0.025 * exp(-dc * 30.0);\nlet colorA = hsv(fract(0.50 + t * 0.01), 0.92, 1.0);\nlet colorB = hsv(fract(0.91 + t * 0.008), 0.96, 1.0);\nlet colorC = mix(c2, hsv(0.19, 0.92, 1.0), 0.65);\nlet signal = colorA * vec3<f32>(lineA) + colorB * vec3<f32>(lineB) + colorC * vec3<f32>(lineC);\nreturn clamp(c1 * vec3<f32>(0.006) + signal, vec3<f32>(0.0), vec3<f32>(0.92));",
