      "custom": {
        "expression": "let spacing = 1.4 / (0.7 + amount * 0.23);\nlet column = floor(p.x / spacing + 0.5);\nlet seed = hash(vec2<f32>(column, 7.3));\nlet phase = fract(t * 0.19 * sqrt(gravity) + seed);\nlet fall = 2.4 - 4.8 * phase * phase;\nlet x = p.x - column * spacing;\nlet y = (fract((p.y - fall) / 4.8 + 0.5) - 0.5) * 4.8;\nlet angle = t * (seed - 0.5) * 1.7 + seed * 6.28318;\nlet q = vec2<f32>(cos(angle) * x - sin(angle) * y, sin(angle) * x + cos(angle) * y);\nlet radius = shape_size * (0.7 + 0.5 * seed);\nlet sides = select(3.0, 6.0, seed > 0.35);\nlet sector = 6.28318 / sides;\nlet a = atan2(q.y, q.x) + 3.14159;\nlet polygon = length(q) * cos(floor(a / sector + 0.5) * sector - a) - radius;\nlet square = max(abs(q.x), abs(q.y)) - radius * 0.86;\nlet d = select(polygon, square, seed > 0.72);\nlet fill = 1.0 - smoothstep(-0.012, 0.012, d);\nlet rim = exp(-abs(d) * 80.0);\nlet glow = exp(-max(d, 0.0) * 10.0);\nlet tint = mix(mix(c1, c2, seed), c3, 0.25 * sin(seed * 18.0) + 0.25);\nlet face = tint * (0.63 + 0.26 * clamp(q.y / radius + 0.5, 0.0, 1.0));\nlet backdrop = mix(c1, c3, 0.5 + 0.5 * sin(p.y * 0.6 + t * 0.12)) * 0.24;\nlet color = backdrop + tint * glow * 0.17 + face * fill + mix(c2, vec3<f32>(0.65, 0.87, 1.0), 0.35) * rim * 0.23;\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
