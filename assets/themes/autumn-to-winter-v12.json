      "custom": {
        "expression": "let void_bg = mix(bg, c4, smoothstep(0.25, 0.85, noise(p * 2.5 + vec2<f32>(t * 0.02, 0.0))));\nlet twinkle = stars(p * 22.0, t) * c5 * 0.7;\nvar acc = vec3<f32>(0.0, 0.0, 0.0);\nfor (var i = 0; i < 8; i++) {\n    let fi = f32(i);\n    let alive = step(fi + 0.5, wave_count);\n    let y0 = -0.42 + fi * 0.12;\n    let x = p.x * (2.0 + 0.3 * fi);\n    let swing = sin(x + t * wave_speed * (1.0 + 0.1 * fi) + fi * 0.7) + 0.5 * sin(2.3 * x - t * 0.7 + fi * 1.4);\n    let wy = y0 + 0.06 * swing;\n    let d = abs(p.y - wy);\n    let u = fi / 7.0;\n    let tint = select(mix(c1, c2, u * 2.0), mix(c2, c3, u * 2.0 - 1.0), u > 0.5);\n    let sharp = 1.0 - smoothstep(0.0, 0.004, d);\n    let glow_l = exp(-d * 40.0) * 0.5;\n    acc += tint * (sharp * 1.4 + glow_l) * alive;\n}\nlet color = tonemap(void_bg + twinkle + acc * 0.9);\nreturn mix(bg, color, strength);",
        "name": "Oscilloscope Nebula",
        "variables": [
          {
            "max": 8.0,
            "min": 3.0,
            "name": "wave_count",
            "value": 6.0
          },
          {
            "max": 1.5,
            "min": 0.10000000149011612,
            "name": "wave_speed",
            "value": 0.5
          }
        ],
        "y_up": true
