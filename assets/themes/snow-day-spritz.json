      "custom": {
        "expression": "let drift = p * vec2<f32>(1.3, 1.8) + vec2<f32>(t * 0.045, t * 0.018);\nlet mist = cloud(drift);\nlet clouds = cloud(drift * vec2<f32>(2.1) + vec2<f32>(mist * 1.7, 0.0));\nlet horizon = exp(-abs(p.y + 0.55) * 1.6);\nlet sky = mix(c1, c2, clamp(mist * 0.8 + horizon * 0.25, 0.0, 1.0));\nlet atmosphere = sky * vec3<f32>(0.32 + clouds * 0.48) + c3 * vec3<f32>(horizon * 0.11);\n\nlet beat = t * lightning_rate;\nlet event = floor(beat * 0.5);\nlet seed = hash(vec2<f32>(event, 13.7));\nlet flash = pow(max(sin(beat * 6.28318), 0.0), 28.0);\nlet echo = pow(max(sin(beat * 6.28318 - 0.72), 0.0), 42.0) * 0.45;\nlet pulse = max(flash, echo);\nlet bolt_center = (seed - 0.5) * 2.8;\nlet jag = (noise(vec2<f32>(p.y * 18.0, event * 9.7)) - 0.5) * 0.22;\nlet bolt_x = bolt_center + sin(p.y * 5.5 + seed * 8.0) * 0.12 + jag;\nlet trunk = abs(p.x - bolt_x);\nlet branch_x = bolt_x + (0.28 - p.y) * 0.62;\nlet branch_gate = smoothstep(-0.85, -0.65, p.y) * (1.0 - smoothstep(0.2, 0.3, p.y));\nlet branch = exp(-abs(p.x - branch_x) * 135.0) * branch_gate;\nlet bolt = exp(-trunk * 180.0) + branch * 0.75;\nlet halo = exp(-trunk * 8.0);\nlet illumination = pulse * storm_glow;\nlet storm = atmosphere + c4 * vec3<f32>(illumination * (bolt * 1.35 + halo * 0.32 + clouds * 0.23));\n\nlet rain_uv = vec2<f32>(p.x + p.y * 0.19, p.y) * vec2<f32>(42.0 * rain_density, 5.5);\nlet lane = floor(rain_uv.x);\nlet rain_seed = hash(vec2<f32>(lane, 8.1));\nlet fall = fract(rain_uv.y + t * (2.8 + rain_seed * 2.0) + rain_seed * 12.0);\nlet width = abs(fract(rain_uv.x) - 0.5);\nlet streak = (1.0 - smoothstep(0.018, 0.075, width)) * smoothstep(0.48, 0.95, fall);\nlet rain = streak * (0.22 + rain_seed * 0.48) * step(0.24, rain_seed);\nlet rain_color = mix(c3, c4, rain_seed);\nlet color = storm + rain_color * vec3<f32>(rain * (0.8 + illumination)) + c5 * vec3<f32>(horizon * 0.035);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
        "name": "Evening Thunder",
