      "custom": {
        "expression": "let density = 1.1 + amount * 0.13;\nlet row = floor(p.y * density);\nlet seed = hash(vec2<f32>(row, 8.7));\nlet grid = vec2<f32>(p.x * density - t * (0.22 + gravity * 0.16) * (0.7 + seed * 0.6) + seed * 4.0, p.y * density);\nlet cell = floor(grid);\nlet id = hash(cell + vec2<f32>(3.1, 9.2));\nlet q = fract(grid) - vec2<f32>(0.5, 0.5 + sin(t * (2.0 + gravity) + cell.x * 3.0 + row) * 0.045);\nlet size = shape_size * (0.65 + id * 0.18);\nlet body = (length(q / vec2<f32>(size, size * 0.56)) - 1.0) * size * 0.56;\nlet tail = max(abs(q.y + sin(t * 7.0 + id * 9.0) * 0.025) - (-q.x - size * 0.55) * 0.65, max(-q.x - size * 1.65, q.x + size * 0.7));\nlet d = min(body, tail);\nlet fish = (1.0 - smoothstep(-0.008, 0.012, d)) * smoothstep(0.0, 0.8, amount);\nlet eye = 1.0 - smoothstep(size * 0.085, size * 0.13, length(q - vec2<f32>(size * 0.55, size * 0.15)));\nlet fishColor = mix(mix(c1, c2, id) * vec3<f32>(0.75 + 0.25 * sin(q.x / size * 15.0)), vec3<f32>(0.015, 0.04, 0.09), eye);\nlet water = cloud(p * vec2<f32>(1.4, 2.4) + vec2<f32>(t * 0.08, -t * 0.04));\nlet rays = pow(0.5 + 0.5 * sin(p.x * 4.5 + p.y * 1.3 + water * 5.0 + t * 0.3), 5.0);\nlet sea = mix(vec3<f32>(0.015, 0.13, 0.24), c1 * vec3<f32>(0.32, 0.48, 0.52), water) + c2 * vec3<f32>(rays * 0.18);\nlet halo = exp(-max(d, 0.0) * 18.0) * glow * 0.16 * smoothstep(0.0, 0.8, amount);\nlet color = mix(sea + mix(c2, c3, 0.25) * vec3<f32>(halo), fishColor, fish);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
