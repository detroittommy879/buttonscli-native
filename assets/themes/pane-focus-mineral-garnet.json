{
  "version": 1,
  "metadata": {
    "id": "pane-focus-mineral-garnet",
    "name": "Mineral Rooms / Garnet",
    "nativeThemeVersion": 1,
    "description": "Still faceted planes, one gemstone per pane. Garnet pane; stable hue, dark background, gentle contrast."
  },
  "theme": {
    "mode": "dark",
    "app": {
