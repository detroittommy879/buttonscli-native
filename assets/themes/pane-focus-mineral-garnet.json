  "effects": {
    "masterDisabled": false,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "simpleNoiseEnabled": false,
    "shaderBackground": {
      "version": 1,
      "preset": "aurora",
      "strength": 0.9,
      "speed": 0.0,
      "scale": 1.0,
      "animated": false,
      "colors": [
        "#030408",
        "#110b0c",
        "#331d23",
        "#2a191d",
        "#3f242b"
      ],
      "theme_colors": false,
      "custom": {
        "name": "Pane Focus / Quiet Facets",
        "expression": "let q = p * facets;\nlet a = clamp(q.x * 0.23 + q.y * 0.31 + 0.5, 0.0, 1.0);\nlet b = clamp(-q.x * 0.31 + q.y * 0.16 + 0.45, 0.0, 1.0);\nlet plane = abs(a - b);\nlet stone = mix(c2, c3, a);\nlet cut = mix(stone, c4, b * 0.35);\nreturn mix(bg, mix(c1, cut, 0.35 + depth * plane * 0.6) + c5 * plane * 0.06, strength);",
        "y_up": true,
        "variables": [
          {
            "name": "facets",
            "min": 0.5,
            "max": 3.0,
            "value": 1.3
          },
          {
            "name": "depth",
            "min": 0.2,
            "max": 1.0,
            "value": 0.85
          }
        ]
      }
    }
  }
