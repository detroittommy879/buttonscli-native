      "custom": {
        "expression": "let g1 = p * 4.0 + vec2<f32>(t * 0.02 * drift, 0.0);\nlet g2 = p * 7.0 + vec2<f32>(t * 0.05 * drift, 0.0);\nlet g3 = p * 12.0 + vec2<f32>(t * 0.12 * drift, 0.0);\nlet cellA = floor(g1);\nlet cellB = floor(g2);\nlet cellC = floor(g3);\nlet oA = (hash2(cellA) - 0.5) * 0.6;\nlet oB = (hash2(cellB) - 0.5) * 0.6;\nlet oC = (hash2(cellC) - 0.5) * 0.6;\nlet dA = sd_circle(fract(g1) - 0.5 - oA, 0.03);\nlet dB = sd_circle(fract(g2) - 0.5 - oB, 0.028);\nlet dC = sd_circle(fract(g3) - 0.5 - oC, 0.022);\nlet hA = hash(cellA + vec2<f32>(3.1, 1.7));\nlet hB = hash(cellB + vec2<f32>(5.3, 2.9));\nlet hC = hash(cellC + vec2<f32>(7.7, 4.1));\nlet twA = 0.6 + 0.4 * sin(t * (0.5 + hA) + hA * 6.28);\nlet twB = 0.6 + 0.4 * sin(t * (0.7 + hB) + hB * 6.28);\nlet twC = 0.6 + 0.4 * sin(t * (0.9 + hC) + hC * 6.28);\nlet wash = mix(bg, c4 * 0.45, smoothstep(-0.5, 0.5, -p.y));\nlet layerA = mix(c4, c5, hA) * halo(dA, 0.05) * twA;\nlet layerB = mix(c2, c1, hB) * halo(dB, 0.05) * twB;\nlet layerC = mix(c1, c3, hC) * (halo(dC, 0.06) * 0.8 + fill(dC) * 0.6) * twC;\nlet color = tonemap(wash + layerA * 1.2 + layerB * 1.3 + layerC * 1.4);\nreturn mix(bg, color, strength);",
        "name": "Cold Parallax Drift",
        "variables": [
          {
            "max": 2.0,
            "min": 0.0,
            "name": "drift",
            "value": 1.0
          }
        ],
