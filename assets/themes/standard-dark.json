        "expression": "let wind = sin(t * 0.7 + p.y * 1.8) * 0.18;\nlet sky = cloud(p * vec2<f32>(1.4, 2.8) + vec2<f32>(t * 0.12, 0.0));\nlet haze = mix(c1 * vec3<f32>(0.48), c3 * vec3<f32>(0.85), smoothstep(0.15, 0.85, sky));\nlet spacing = 1.15 - amount * 0.065;\nlet drift = vec2<f32>(p.x + wind - t * 0.22, p.y + t * gravity * 0.32);\nlet grid = drift / vec2<f32>(spacing);\nlet cell = floor(grid);\nlet seed = hash(cell);\nlet local = (fract(grid) - vec2<f32>(0.5)) * vec2<f32>(spacing);\nlet angle = seed * 6.2831853 + sin(t * 1.8 + seed * 12.0) * 0.9;\nlet q = vec2<f32>(local.x * cos(angle) - local.y * sin(angle), local.x * sin(angle) + local.y * cos(angle)) / vec2<f32>(shape_size * (0.65 + seed * 0.45));\nlet taper = max(0.0, 1.0 - q.y * q.y);\nlet edge = abs(q.x) - taper * (0.42 + 0.09 * cos(q.y * 19.0));\nlet leaf = (1.0 - smoothstep(-0.025, 0.025, edge)) * (1.0 - smoothstep(0.92, 1.02, abs(q.y)));\nlet vein = exp(-abs(q.x) * 65.0) * leaf;\nlet leafColor = mix(mix(c1, c3, smoothstep(0.1, 0.7, seed)), c2, step(0.84, seed));\nlet litLeaf = leafColor * vec3<f32>(0.78 + 0.22 * sin(q.y * 3.0 + seed * 5.0)) + c3 * vec3<f32>(vein * 0.3);\nlet rainCoord = p.x * 28.0 + p.y * 5.0;\nlet rain = pow(0.5 + 0.5 * cos(rainCoord), 28.0) * pow(0.5 + 0.5 * sin(p.y * 20.0 + t * gravity * 9.0 + floor(rainCoord) * 2.7), 12.0);\nlet halo = exp(-max(edge, 0.0) * 12.0) * exp(-max(abs(q.y) - 0.9, 0.0) * 12.0);\nlet color = mix(haze, litLeaf, leaf) + c3 * vec3<f32>(rain * 0.22 + glow * halo * 0.22);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
