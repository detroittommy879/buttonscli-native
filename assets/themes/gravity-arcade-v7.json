      "custom": {
        "expression": "let drift_t = t * drift;\nlet sun_p = vec2<f32>(0.25, 0.2);\nlet sun_d = length(p - sun_p);\nlet sun = fill(sun_d - 0.085);\nlet glow = halo(sun_d - 0.085, 0.4);\nlet n1 = noise(vec2<f32>(p.x * 2.5 + drift_t * 0.04, 1.0));\nlet n2 = noise(vec2<f32>(p.x * 3.5 - drift_t * 0.06, 5.0));\nlet n3 = noise(vec2<f32>(p.x * 2.0 + drift_t * 0.03, 9.0));\nlet h1 = -0.14 + 0.07 * sin(p.x * 3.0 + drift_t * 0.12) + 0.05 * (n1 - 0.5);\nlet h2 = -0.03 + 0.06 * sin(p.x * 4.5 - drift_t * 0.09 + 1.3) + 0.05 * (n2 - 0.5);\nlet h3 = 0.07 + 0.05 * sin(p.x * 6.0 + drift_t * 0.07 + 2.6) + 0.04 * (n3 - 0.5);\nlet haze_col = mix(c5, c1, 0.4);\nlet sky = mix(c4 * 0.6, c2 * 0.55, smoothstep(-0.5, 0.5, p.y)) + haze_col * (glow * 0.45 + sun * 0.7);\nvar scene = sky + c5 * sun;\nscene = mix(scene, mix(c3 * 0.85, haze_col, 0.35), fill(p.y - h3));\nscene = mix(scene, c2 * 0.95, fill(p.y - h2));\nscene = mix(scene, c4 * 0.8, fill(p.y - h1));\nlet crest = stroke(p.y - h2, 0.008) * c1 * 0.8 + stroke(p.y - h1, 0.006) * c1 * 0.5;\nlet color = tonemap(scene + crest);\nreturn mix(bg, color, strength);",
        "name": "Dusk Dunes",
