      "custom": {
        "expression": "let trip = m * 0.1;\nlet drift = p * vec2<f32>(density) + vec2<f32>(t * 0.045, -t * 0.025);\nlet warp = vec2<f32>(sin(drift.y * 3.2 + t * 0.7), cos(drift.x * 2.8 - t * 0.6)) * vec2<f32>(wobble * (0.04 + trip * 0.18));\nlet uv = drift + warp;\nlet id = floor(uv);\nlet seed = hash(id);\nlet q = fract(uv) - vec2<f32>(0.5);\nlet radius = length(q);\nlet angle = atan2(q.y, q.x);\nlet vision = radius * (5.0 + trip * 7.0) + sin(angle * 6.0 + radius * 14.0 - t * 0.8) * trip * 0.16;\nlet hue = seed * 0.27 + vision * 0.12 - t * 0.045;\nlet violet = clamp(c3 * vec3<f32>(4.0) + vec3<f32>(0.15, 0.025, 0.24), vec3<f32>(0.0), vec3<f32>(1.0));\nlet spectral = palette(hue);\nlet tile_color = mix(violet, spectral, 0.55 + trip * 0.28);\nlet body_distance = length(max(abs(q) - vec2<f32>(0.24, 0.20), vec2<f32>(0.0))) - 0.15;\nlet body = 1.0 - smoothstep(-0.008, 0.015, body_distance);\nlet rim = exp(-100.0 * abs(body_distance));\nlet ripple = 0.5 + 0.5 * sin(vision * 6.28318 - t * 1.1);\nlet ground = mix(c1 * vec3<f32>(3.0), palette(hue + 0.35), 0.36 + 0.18 * ripple);\nlet cheeks = tile_color * vec3<f32>(0.62 + 0.30 * ripple);\nlet eye_y = -0.075 + 0.018 * sin(t * 1.4 + seed * 12.0);\nlet eye_q = vec2<f32>(abs(q.x) - 0.125, q.y - eye_y);\nlet eyes = 1.0 - smoothstep(0.052, 0.064, length(eye_q));\nlet pupil_q = eye_q - vec2<f32>(0.013 * sin(t + seed * 8.0), 0.006 * cos(t * 1.3));\nlet pupils = 1.0 - smoothstep(0.019, 0.026, length(pupil_q));\nlet iris = palette(hue + 0.48) * vec3<f32>(0.9);\nlet smile_q = q - vec2<f32>(0.0, 0.015);\nlet smile = (1.0 - smoothstep(0.010, 0.022, abs(length(smile_q) - 0.18))) * smoothstep(0.025, 0.065, smile_q.y);\nlet face = mix(ground, cheeks, body);\nlet outlined = mix(face, palette(hue + 0.25), rim * (0.45 + glow * 0.4));\nlet eyed = mix(outlined, iris, eyes);\nlet looking = mix(eyed, c2, pupils);\nlet grinning = mix(looking, c1, smile);\nlet aura = palette(hue + 0.15) * vec3<f32>(exp(-24.0 * abs(body_distance)) * glow * 0.28);\nlet color = clamp(grinning + aura, vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
