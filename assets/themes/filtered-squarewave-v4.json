      "custom": {
        "expression": "let hz = -0.03;\nlet below = max(hz - p.y, 0.015);\nlet depth = 1.0 / below;\nlet X = p.x * depth;\nlet Z = depth;\nlet tw = t * wave_speed;\nlet a1 = X * 1.3 + Z * 0.7 - tw * 1.1;\nlet a2 = X * 2.1 - Z * 1.1 + tw * 1.4;\nlet a3 = X * 0.6 + Z * 2.3 - tw * 0.8;\nlet a4 = X * 3.7 + Z * 3.1 + tw * 2.0;\nlet h = sin(a1) * 0.5 + sin(a2) * 0.3 + sin(a3) * 0.2 + sin(a4) * 0.12;\nlet gx = 0.65 * cos(a1) + 0.63 * cos(a2) + 0.12 * cos(a3) + 0.44 * cos(a4);\nlet gz = 0.35 * cos(a1) - 0.33 * cos(a2) + 0.46 * cos(a3) + 0.37 * cos(a4);\nlet slope = 0.2 * wave_height;\nlet fine = noise(vec2<f32>(X * 4.0 - tw * 0.6, Z * 2.0 + tw * 0.3));\nlet nx = (-gx) * slope + (fine - 0.5) * 0.075;\nlet nz = (-gz) * slope;\nlet n = normalize(vec3<f32>(nx, 1.0, nz));\nlet refl_mix = clamp(0.3 + 4.0 * (1.0 - n.y), 0.0, 1.0);\nlet fog = exp(-below * 2.5);\nlet mirror = vec2<f32>(p.x + nx * 0.6, hz + 0.05 + clamp(below * 0.9, 0.0, 0.5));\nlet neb = fbm(mirror * vec2<f32>(3.0, 4.0) + vec2<f32>(t * 0.02, 0.0));\nlet sky_refl = mix(c1 * 0.5, c5 * 0.6, smoothstep(hz, 0.5, mirror.y)) + mix(c5, c4, neb) * neb * nebula_glow * 0.8 + c3 * stars(mirror * 22.0, t) * 0.5;\nlet neb_d = noise(p * vec2<f32>(3.0, 4.0) + vec2<f32>(t * 0.02, 0.0));\nlet stars_v = stars(p * 22.0, t);\nlet moon_d = sd_circle(p - vec2<f32>(0.42, 0.3), 0.05);\nlet moon = fill(moon_d) + halo(moon_d, 0.2) * 0.4;\nlet sky_d = mix(c5 * 0.4, c1 * 0.3, smoothstep(hz, 0.5, p.y)) + mix(c5, c4, neb_d) * neb_d * nebula_glow * 0.8 + c3 * stars_v * 0.8 + c4 * moon;\nlet deep = mix(c1 * 0.8, c2, clamp(0.5 + h * 0.5, 0.0, 1.0)) * (0.5 + 0.5 * fog);\nlet water_base = mix(deep, sky_refl, refl_mix * 0.7);\nlet crest = smoothstep(0.6, 0.95, h * 0.5 + 0.5);\nlet glint_x = p.x - 0.42 + nx * 0.35;\nlet glint = (1.0 - smoothstep(0.0, 0.1, abs(glint_x))) * (0.4 + 0.6 * fog) * (0.4 + 0.6 * crest);\nlet water = water_base + c3 * crest * 0.35 + c4 * glint * 0.9;\nlet foam = (1.0 - smoothstep(0.0, 0.02, abs(p.y - hz))) * (0.5 + 0.5 * fine) * c3;\nlet scene = mix(water + foam, sky_d, smoothstep(hz - 0.004, hz + 0.004, p.y));\nreturn mix(bg, tonemap(scene * 1.2), strength);",
