      "custom": {
        "expression": "let wave_a = sin(p.x * 7.0 + t * wave_speed) + cos(p.y * 5.0 - t * wave_speed * 0.7);\nlet wash = mix(c4, c2, 0.25 + 0.25 * wave_a);\nlet qa = p * ring_density * 0.6 + vec2<f32>(t * 0.02, 0.0);\nlet ca = floor(qa);\nlet la = fract(qa) - 0.5;\nlet sa = hash(ca);\nlet ang_a = atan2(la.y, la.x);\nlet ra = (0.22 + 0.06 * sin(t * 0.5 + sa * 6.28)) * (1.0 + 0.2 * cos(ang_a * 5.0 + t * 0.3));\nlet ring_a = stroke(length(la) - ra, 0.02);\nlet layer_a = ring_a * mix(c2, c3, sa) * 0.55;\nlet qb = p * ring_density + vec2<f32>(t * 0.06, -t * 0.02);\nlet cb = floor(qb);\nlet lb = fract(qb) - 0.5;\nlet sb = hash(cb + vec2<f32>(3.0, 7.0));\nlet rb = 0.12 + 0.08 * sb;\nlet dot_b = fill(length(lb) - rb);\nlet pulse_b = 0.6 + 0.4 * sin(t * 0.8 + sb * 6.28);\nlet layer_b = dot_b * mix(c3, c5, step(0.8, sb)) * 0.45 * pulse_b;\nlet wave_y = 0.12 * sin(p.x * 4.0 + t * wave_speed * 2.0) + 0.04 * cos(p.x * 11.0 - t * wave_speed * 3.0) - 0.2;\nlet line = 1.0 - smoothstep(0.0, 0.012, abs(p.y - wave_y));\nlet line_col = line * c3 * 0.6 + halo(abs(p.y - wave_y), 0.05) * c1 * 0.5;\nlet scene = wash + layer_a + layer_b + line_col;\nlet color = tonemap(scene * 1.2);\nreturn mix(bg, color, strength);",
        "name": "Quiet Tide Rings",
