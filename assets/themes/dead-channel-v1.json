      "custom": {
        "expression": "let line = floor(p.y * 90.0);\nlet jitter = hash(vec2<f32>(line, floor(t * 15.0))) - 0.5;\nlet wob = 0.04 * sin(p.y * 18.0 + t * 1.5) + 0.03 * jitter;\nlet k = floor(fract((p.x + 1.0 + wob) * 0.5) * 5.0);\nlet pick_a = mix(c1, c5, step(0.5, fract(k * 0.37)));\nlet pick_b = mix(c2, c3, step(0.5, fract(k * 0.61)));\nlet pic = mix(pick_a, pick_b, step(0.5, fract(k * 0.5 + 0.25)));\nlet roll = fract(t * 0.08);\nlet d = fract(p.y - roll + 0.5) - 0.5;\nlet band = 1.0 - smoothstep(0.0, 0.08, abs(d));\nlet grain = hash(vec2<f32>(floor(p.x * 140.0), line + floor(t * 30.0)));\nlet amount = clamp(static_amount + band * 0.85, 0.0, 1.0);\nlet snow = c4 * grain * 0.8;\nlet frame = mix(pic * 0.9, snow, amount);\nlet scan = 0.78 + 0.22 * step(0.5, fract(line * 0.5));\nlet color = frame * scan;\nreturn mix(bg, color, strength);",
        "name": "Rolling channel static",
