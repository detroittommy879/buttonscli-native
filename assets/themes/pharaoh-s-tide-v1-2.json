      "custom": {
        "expression": "let grid = 24.0 * grid_scale;\nlet pix = (floor(p * grid) + 0.5) / grid;\nlet sky = mix(c4, c5 * 0.35, smoothstep(-0.5, 0.5, pix.y));\nlet sun_c = vec2<f32>(0.0, 0.12 + 0.02 * sin(t * 0.2));\nlet sun_on = step(length(pix - sun_c) - 0.24, 0.0);\nlet lower = step(pix.y, sun_c.y);\nlet band = lower * step(0.6, fract(pix.y * 10.0));\nlet sun_col = mix(c3, c1, clamp(pix.y * 3.0, 0.0, 1.0));\nlet world = mix(sky, sun_col, sun_on * (1.0 - band));\nlet ridge = -0.12 + 0.07 * sin(pix.x * 4.0 + t * 0.15 * scroll_speed) + 0.035 * sin(pix.x * 11.0 - t * 0.1 * scroll_speed);\nlet mid_on = step(pix.y, ridge);\nlet ridge_edge = mid_on * step(ridge - 0.02, pix.y);\nlet mid_col = mix(c5 * 0.5, c2, ridge_edge);\nlet with_mid = mix(world, mid_col, mid_on);\nlet rowy = floor(p.y * 18.0);\nlet drift = scroll_speed * (0.8 + hash(vec2<f32>(rowy, 3.0)));\nlet sx = floor((p.x + t * drift) * grid * 0.5);\nlet spark = step(0.97, hash(vec2<f32>(rowy, sx)));\nlet with_sparks = mix(with_mid, c2 * 1.4, spark);\nlet scan = 0.75 + 0.25 * smoothstep(0.0, 0.5, fract(p.y * grid));\nlet vignette = clamp(1.0 - 0.9 * dot(p, p), 0.0, 1.0);\nlet color = with_sparks * scan * vignette;\nreturn mix(bg, tonemap(color * 1.2), strength);",
        "name": "Phosphor Arcade",
        "variables": [
          {
            "max": 2.0,
            "min": 0.20000000298023224,
            "name": "scroll_speed",
            "value": 0.800000011920929
          },
          {
            "max": 2.5,
            "min": 0.5,
            "name": "grid_scale",
            "value": 1.0
          }
        ],
        "y_up": true
      },
