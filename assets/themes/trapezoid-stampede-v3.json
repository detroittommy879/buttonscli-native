        "expression": "let power = clamp(amount / 10.0, 0.0, 1.0);\nlet uv = p * vec2<f32>(2.0) + vec2<f32>(t * 0.035, -t * 0.025);\nlet cell = floor(uv);\nlet seed = hash(cell);\nlet local = (fract(uv) - vec2<f32>(0.5)) * vec2<f32>(2.0);\nlet angle = t * 0.16 * select(-1.0, 1.0, seed > 0.5) + seed * 6.28318;\nlet q = vec2<f32>(local.x * cos(angle) - local.y * sin(angle), local.x * sin(angle) + local.y * cos(angle));\nlet bounce = 0.93 + 0.07 * sin(t * 1.4 + seed * 12.0);\nlet v = q / vec2<f32>(bounce);\nlet a = abs(v);\nlet hex = max(a.y, a.x * 0.866025 + a.y * 0.5) - 0.59;\nlet outline = 1.0 - smoothstep(0.007, 0.023, abs(hex));\nlet halo = exp(-abs(hex) * 24.0);\nlet inside = 1.0 - smoothstep(-0.015, 0.005, hex);\nlet spokes = min(abs(v.y), min(abs(v.y * 0.5 + v.x * 0.866025), abs(v.y * 0.5 - v.x * 0.866025)));\nlet ribs = (1.0 - smoothstep(0.005, 0.016, spokes)) * inside;\nlet radius = length(v);\nlet hub = 1.0 - smoothstep(0.04, 0.055, radius);\nlet hubRing = 1.0 - smoothstep(0.006, 0.018, abs(radius - 0.095));\nlet sector = floor((atan2(v.y, v.x) + 3.141593) / 1.047198);\nlet hue = fract(seed * 0.8 + sector / 6.0 + t * 0.015);\nlet candy = mix(hsv(hue, 0.82, 1.0), clamp(c1, vec3<f32>(0.0), vec3<f32>(1.0)), 0.12);\nlet rim = hsv(fract(seed + t * 0.025), 0.63, 1.0);\nlet facet = inside * (0.025 + 0.025 * fract(sector * 0.37 + seed));\nlet brightness = 0.55 + power * 0.35;\nlet lines = rim * vec3<f32>((outline * 0.66 + halo * 0.065 + hubRing * 0.32) * brightness);\nlet panels = candy * vec3<f32>(facet + ribs * 0.28 * brightness);\nlet center = mix(c2, vec3<f32>(0.7, 0.9, 1.0), 0.6) * vec3<f32>(hub * 0.42);\nlet grid = abs(fract(uv) - vec2<f32>(0.5));\nlet peg = exp(-dot(grid, grid) * 800.0);\nlet base = vec3<f32>(0.006, 0.009, 0.02) + c3 * vec3<f32>(0.012 + peg * 0.06);\nlet vignette = 1.0 / (1.0 + dot(p, p) * 0.1);\nreturn clamp((base + lines + panels + center) * vec3<f32>(vignette), vec3<f32>(0.0), vec3<f32>(0.8));",
