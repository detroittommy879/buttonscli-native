        "expression": "let w = vec2<f32>(fbm(p * 2.0 + vec2<f32>(t * 0.03, 0.0)), fbm(p * 2.0 + vec2<f32>(5.2, 1.3) + vec2<f32>(0.0, t * 0.02)));\nlet far_n = fbm(p * 2.2 + 2.0 * w + vec2<f32>(0.0, t * 0.02));\nlet near_n = fbm(p * 3.8 + 2.5 * w + vec2<f32>(t * 0.05, 0.0));\nlet ground = 1.0 - smoothstep(-0.3, 0.1, p.y);\nlet far_mask = smoothstep(density, density + 0.12, far_n) * ground;\nlet near_mask = smoothstep(density + 0.05, density + 0.15, near_n) * (1.0 - smoothstep(-0.4, 0.0, p.y));\nlet sky = mix(c4 * 0.9, c2 * 0.6, smoothstep(-0.5, 0.5, p.y));\nlet far_col = mix(c3, c2, far_n) * far_mask * 0.75;\nlet near_col = mix(c5, c1, w.y) * near_mask;\nlet rays = pow(0.5 + 0.5 * sin(p.x * 16.0 + w.x * 5.0 + t * 0.4), 4.0) * (1.0 - smoothstep(-0.1, 0.5, p.y));\nlet beams = c1 * rays * beam;\nlet color = sky + far_col + near_col + beams;\nreturn mix(bg, tonemap(color * 1.25), strength);",
