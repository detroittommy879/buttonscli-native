        "expression": "let power = clamp(amount / 60.0, 0.0, 1.0);\nlet uv = p * vec2<f32>(2.1) + vec2<f32>(t * 0.035, -t * 0.025);\nlet cell = floor(uv);\nlet seed = hash(cell);\nlet local = fract(uv) - vec2<f32>(0.5);\nlet angle = seed * 6.28318 + t * 0.22 * sin(seed * 19.0);\nlet q = vec2<f32>(local.x * cos(angle) - local.y * sin(angle), local.x * sin(angle) + local.y * cos(angle));\nlet bounce = 0.018 * sin(t * 1.8 + seed * 25.0);\nlet radius = 0.26 + bounce;\nlet circle = length(q) - radius;\nlet box = max(abs(q.x), abs(q.y)) - radius * 0.86;\nlet triangle = max(abs(q.x) * 0.866025 + q.y * 0.5, -q.y) - radius * 0.62;\nlet shape = select(select(circle, box, seed > 0.33), triangle, seed > 0.67);\nlet edge = 1.0 - smoothstep(0.006, 0.018, abs(shape));\nlet glow = exp(-abs(shape) * 29.0);\nlet inside = 1.0 - smoothstep(-0.012, 0.0, shape);\nlet eyeA = length(q - vec2<f32>(-0.065, 0.015));\nlet eyeB = length(q - vec2<f32>(0.065, 0.015));\nlet eyes = (1.0 - smoothstep(0.009, 0.019, min(eyeA, eyeB))) * inside;\nlet smileDistance = abs(length(q - vec2<f32>(0.0, 0.015)) - 0.09);\nlet smile = (1.0 - smoothstep(0.004, 0.012, smileDistance)) * (1.0 - smoothstep(-0.035, -0.02, q.y)) * inside;\nlet orbit = abs(length(local) - 0.405);\nlet ticks = pow(max(0.0, cos(atan2(local.y, local.x) * 12.0 + seed * 6.0)), 12.0);\nlet ring = exp(-orbit * 180.0) * ticks * 0.12;\nlet color = mix(palette(seed * 0.83 + 0.04), mix(c1, c2, seed), 0.2);\nlet enabled = smoothstep(seed - 0.12, seed + 0.12, 0.25 + power * 0.75);\nlet base = vec3<f32>(0.007, 0.009, 0.022) + c3 * vec3<f32>(inside * 0.025);\nlet neon = color * vec3<f32>((edge * 0.62 + glow * 0.07 + inside * 0.018 + ring) * enabled);\nlet face = mix(color, vec3<f32>(0.65, 0.85, 1.0), 0.55) * vec3<f32>((eyes + smile) * 0.35 * enabled);\nlet vignette = 1.0 / (1.0 + dot(p, p) * 0.12);\nreturn clamp((base + neon + face) * vec3<f32>(vignette), vec3<f32>(0.0), vec3<f32>(0.78));",
