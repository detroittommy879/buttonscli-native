      "custom": {
        "expression": "let warp = sin(p.y * 9.0 + t * 1.3) * 0.25 + sin(p.x * 7.0 - t * 0.9) * 0.25;\nlet q = p * blob_scale + vec2<f32>(warp, warp * 0.6);\nlet veins = ridged(q + vec2<f32>(0.0, t * 0.12));\nlet blobs = smoothstep(0.35, 0.7, veins);\nlet edge = stroke(veins - 0.55, 0.05);\nlet beat = 0.5 + 0.5 * sin(t * pulse_speed * 3.0);\nlet outline = edge * (0.6 + 0.4 * beat);\nlet body = mix(c2, c1, blobs);\nlet q2 = p * blob_scale * 0.5 + vec2<f32>(-t * 0.04, 0.0);\nlet slow = ridged(q2 + vec2<f32>(sin(t * 0.2) * 0.3, 0.0));\nlet slow_fill = smoothstep(0.3, 0.7, slow);\nlet layer2 = mix(c4 * 1.6, c2 * 0.7, slow_fill);\nlet molten = mix(layer2, body, blobs * 0.9);\nlet glow = c3 * outline * 1.2 + c5 * outline * 0.4;\nlet color = molten + glow;\nreturn mix(bg, tonemap(color), strength);",
        "name": "Molten Gold Bounce",
        "variables": [
