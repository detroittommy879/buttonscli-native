{
  "version": 1,
  "metadata": {
    "id": "pane-focus-spectrum-ruby",
    "name": "Spectrum Steps / Ruby",
    "nativeThemeVersion": 1,
    "description": "Black-to-color gradients in rainbow order. Ruby pane; stable hue, dark background, gentle contrast."
  },
  "theme": {
    "mode": "dark",
    "app": {
      "shell": {
        "background": "#090c12",
        "backgroundSecondary": "#170f10",
        "buttonBackground": "#170f10",
        "border": "#482327",
        "textMain": "#e5eaf2",
        "textDim": "#a4afbf",
        "accent": "#ed5265",
        "accentHover": "#ee7a88",
        "paneDivider": {
          "color": "#ed5265",
          "thickness": 2.0
        }
      },
      "tabs": {
        "background": "#090c12",
        "idleBackground": "#170f10",
        "activeBackground": "#482327",
        "activeBorder": "#ed5265"
      },
      "presetDock": {
        "background": "#170f10",
        "buttonBackground": "#170f10",
        "buttonHover": "#482327",
        "buttonText": "#e5eaf2",
        "accent": "#ed5265"
      },
      "settings": {
        "background": "#0d111a"
      },
      "statusBar": {
        "background": "#090c12",
        "border": "#482327",
        "text": "#bac5d4",
        "warning": "#e8ce8a"
      }
    },
    "terminal": {
      "background": "#0b0607",
      "foreground": "#e5eaf2",
      "ansiColors": {
        "black": "#586174",
        "red": "#ed919b",
        "green": "#a3d6a0",
        "yellow": "#e8ce8a",
        "blue": "#95b9f1",
        "magenta": "#ceb0ec",
        "cyan": "#94d6d9",
        "white": "#dce3ed",
        "brightBlack": "#99a3b6",
        "brightRed": "#ffb0b9",
        "brightGreen": "#c1ebbc",
        "brightYellow": "#f5e2ac",
        "brightBlue": "#bad2ff",
        "brightMagenta": "#e0c7ff",
        "brightCyan": "#b6eceb",
        "brightWhite": "#f6f8fc"
      },
      "useGradient": true,
      "gradientType": "linear",
      "gradientAngle": 135.0,
      "gradientColors": [
        "#030408",
        "#14080a",
        "#3b161a",
        "#301316"
      ],
      "gradientAnimation": false
    }
  },
  "effects": {
    "masterDisabled": false,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "simpleNoiseEnabled": false,
    "shaderBackground": {
      "version": 1,
      "preset": "aurora",
      "strength": 0.9,
      "speed": 0.0,
      "scale": 1.0,
      "animated": false,
      "colors": [
        "#030408",
        "#14080a",
        "#3b161a",
        "#301316",
        "#491b20"
      ],
      "theme_colors": false,
      "custom": {
        "name": "Pane Focus / Ink Ramp",
        "expression": "let x = clamp(p.x * 0.35 + 0.5, 0.0, 1.0);\nlet y = clamp(p.y * 0.5 + 0.5, 0.0, 1.0);\nlet ramp = smoothstep(0.0, 1.0, mix(x, y, tilt));\nlet low = mix(c1, c2, ramp);\nlet high = mix(c3, c4, y * 0.25);\nlet color = mix(low, high, ramp * depth);\nreturn mix(bg, mix(color, c5, ramp * ramp * 0.08), strength);",
        "y_up": true,
        "variables": [
          {
            "name": "tilt",
            "min": 0.0,
            "max": 1.0,
            "value": 0.25
          },
          {
            "name": "depth",
            "min": 0.2,
            "max": 1.0,
            "value": 0.85
          }
        ]
      }
    }
  }
}
