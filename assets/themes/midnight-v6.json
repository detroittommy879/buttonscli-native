        "expression": "let g1 = p * 4.0 + vec2<f32>(t * 0.08, t * 0.03);\nlet tile1 = floor(g1);\nlet s1 = hash(tile1);\nlet r1 = rotate(fract(g1) - 0.5, t * 0.35 + s1 * 6.2832);\nlet m1 = 0.5 + 0.5 * sin(t * 0.6 + s1 * 9.0);\nlet d1 = mix(sd_circle(r1 * vec2<f32>(1.5, 1.0), 0.13), sd_box(r1, vec2<f32>(0.11, 0.11)), m1);\nlet sh1 = stroke(d1, 0.012) * step(0.5, s1);\nlet g2 = p * 2.5 + vec2<f32>(t * 0.04, 0.0);\nlet tile2 = floor(g2);\nlet s2 = hash(tile2);\nlet r2 = rotate(fract(g2) - 0.5, t * 0.2 + s2 * 6.2832);\nlet corner = sd_segment(r2, vec2<f32>(0.0, -0.12), vec2<f32>(0.0, 0.12));\nlet arm = sd_segment(r2, vec2<f32>(0.0, -0.12), vec2<f32>(0.14, -0.12));\nlet ell = stroke(min(corner, arm), 0.01);\nlet dot2 = halo(sd_circle(r2 - vec2<f32>(-0.18, 0.12), 0.02), 0.05);\nlet far = (ell + dot2) * step(0.55, s2);\nlet wave = 0.2 * cos(p.x * 7.0 + t * 0.6) + 0.05 * sin(p.x * 15.0 - t);\nlet wline = stroke(p.y - wave, 0.008) * (1.0 - smoothstep(0.2, 0.9, abs(p.x)));\nlet base = bg + c4 * 0.12 * smoothstep(-0.5, 0.5, p.y);\nlet color = base + mix(c1, c2, s1) * sh1 * 0.9 + c4 * far * 0.7 + c3 * wline * 0.8;\nreturn mix(bg, tonemap(color), strength);",
