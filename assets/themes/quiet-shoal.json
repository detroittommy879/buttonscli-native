        "expression": "let density = 0.8 + amount * 0.18;\nlet row = floor(p.y * density);\nlet seed = hash(vec2<f32>(row, 4.7));\nlet drift = t * (0.12 + gravity * 0.055) * (0.7 + seed * 0.6);\nlet grid = vec2<f32>(p.x * density + drift + seed * 6.0, p.y * density);\nlet cell = floor(grid);\nlet id = hash(cell + vec2<f32>(2.3, 8.1));\nlet q = fract(grid) - vec2<f32>(0.5);\nlet swim = sin(t * (1.0 + gravity * 0.45) + cell.x * 2.7 + seed * 6.28);\nlet v = vec2<f32>(q.x, q.y + swim * 0.035);\nlet size = shape_size * (0.65 + id * 0.2);\nlet body = (length(vec2<f32>(v.x / 1.0, v.y / 0.43)) - size) * 0.43;\nlet tailY = v.y - sin(t * 2.0 + id * 6.28) * max(v.x - size * 0.5, 0.0) * 0.22;\nlet tail = max(abs(tailY) - (v.x - size * 0.45) * 0.52, max(size * 0.55 - v.x, v.x - size * 1.55));\nlet d = min(body, tail);\nlet fill = 1.0 - smoothstep(-0.008, 0.012, d);\nlet halo = exp(-max(d, 0.0) * 28.0) * (1.0 - fill);\nlet eye = 1.0 - smoothstep(size * 0.045, size * 0.085, length(v - vec2<f32>(-size * 0.59, size * 0.09)));\nlet stripe = 0.5 + 0.5 * sin(v.x / size * 13.0 + id * 4.0);\nlet fishColor = mix(c1, c2, id) * vec3<f32>(0.6 + stripe * 0.2);\nlet depth = 0.5 + 0.5 * sin(p.y * 0.65 + 0.8);\nlet water = mix(vec3<f32>(0.018, 0.07, 0.13), vec3<f32>(0.035, 0.19, 0.27), depth);\nlet wave = sin(p.x * 3.0 + sin(p.y * 2.0 + t * 0.13) + t * 0.12);\nlet caustic = pow(0.5 + 0.5 * wave, 8.0);\nlet activity = smoothstep(0.0, 0.8, amount);\nlet shimmer = c3 * vec3<f32>(caustic * 0.07 * glow);\nlet fish = fishColor * fill * (1.0 - eye * 0.85) + c2 * vec3<f32>(halo * glow * 0.12);\nlet color = clamp(water + shimmer + fish * activity, vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
