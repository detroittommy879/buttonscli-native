        "expression": "let density = 1.6 + amount * 0.48;\nlet drift = vec2<f32>(sin(t * 0.43), t * gravity * 0.38);\nlet warp = p + vec2<f32>(sin(p.y * 3.0 + t * gravity), cos(p.x * 2.5 - t)) * vec2<f32>(0.16);\nlet grid = warp * vec2<f32>(density) + drift;\nlet cell = floor(grid);\nlet seed = hash(cell);\nlet q = fract(grid) - vec2<f32>(0.5);\nlet angle = t * gravity * (seed - 0.5) + seed * 6.2832;\nlet r = vec2<f32>(q.x * cos(angle) - q.y * sin(angle), q.x * sin(angle) + q.y * cos(angle));\nlet size = shape_size * (0.65 + 0.25 * sin(t * 2.0 + seed * 12.0));\nlet box = max(abs(r.x), abs(r.y)) - size;\nlet disk = length(r) - size;\nlet diamond = (abs(r.x) + abs(r.y)) * 0.7071 - size;\nlet d = select(select(box, disk, seed > 0.33), diamond, seed > 0.67);\nlet fill = 1.0 - smoothstep(-0.015, 0.015, d);\nlet ring = 1.0 - smoothstep(0.014, 0.033, abs(d));\nlet stripe = step(0.5, fract((r.x + r.y) * 9.0 + t * gravity));\nlet checker = step(0.5, fract((cell.x + cell.y) * 0.5));\nlet ink = mix(fill, max(ring, fill * stripe), step(0.45, seed));\nlet graphic = mix(ink, 1.0 - ink, checker);\nlet accent = select(mix(c1, c2, step(0.5, seed)), c3, seed > 0.8);\nlet accentMask = step(0.78, hash(cell + vec2<f32>(19.2, 4.6)));\nlet paper = mix(accent * vec3<f32>(0.025), mix(accent, vec3<f32>(1.0), 0.75), graphic);\nlet colored = mix(accent * vec3<f32>(0.12), accent, graphic);\nlet halo = exp(-abs(d) * 26.0) * glow * 0.22;\nlet color = clamp(mix(paper, colored, accentMask) + accent * vec3<f32>(halo * accentMask), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
