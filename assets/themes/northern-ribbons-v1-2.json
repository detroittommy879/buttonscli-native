      "custom": {
        "expression": "let amp = wave_height;\nvar col = vec3<f32>(0.0);\nvar lum = 0.0;\nfor (var i = 0; i < 6; i++) {\n    let k = f32(i);\n    let x = p.x * 2.2;\n    let ph = t * line_speed;\n    let w = sin(x * 3.0 + ph * 2.0 + k * 0.7) * 0.6 + sin(x * 7.3 - ph * 3.1 + k * 1.9) * 0.3 + sin(x * 13.0 + ph * 5.0 + k) * 0.1;\n    let env = 1.0 - smoothstep(0.6, 0.95, abs(p.x * 1.1));\n    let y = (k - 2.5) * 0.09 + amp * w * env;\n    let d = abs(p.y - y);\n    let core = exp(-d * 160.0);\n    let soft = exp(-d * 30.0) * 0.25;\n    let line_col = mix(c1, c2, k * 0.2);\n    col += line_col * (core + soft);\n    lum += core;\n}\nlet glow = tonemap(col * 1.3);\nlet color = glow + c5 * 0.02 * lum;\nreturn mix(bg, color, strength);",
        "name": "Audio Scanlines",
