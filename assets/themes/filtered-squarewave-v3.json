      "custom": {
        "expression": "var glow_acc = vec3<f32>(0.0);\nvar ink = vec3<f32>(0.0);\nfor (var i = 0; i < 6; i++) {\n    let k = f32(i);\n    let fk = k / 5.0;\n    let freq = 2.2 + 0.7 * k;\n    let phase = k * 1.3 + t * wave_speed * (0.6 + 0.15 * k);\n    let wy = (fk - 0.5) * 0.8 + wave_height * sin(p.x * freq + phase) * cos(p.x * 0.9 - 0.1 * t * k);\n    let d = abs(p.y - wy);\n    let wcol = mix(mix(c1, c2, fk), c5, fract(k * 0.37));\n    let trace = 1.0 - smoothstep(0.0, 0.0035, d);\n    let g = exp(-d / glow_size);\n    glow_acc += wcol * g * 0.35;\n    ink += wcol * trace;\n}\nlet haze = noise(p * 2.5 + vec2<f32>(t * 0.03, -t * 0.02));\nlet base = bg + c4 * haze * 0.6;\nlet color = base + glow_acc + ink * 1.2;\nreturn mix(bg, tonemap(color), strength);",
        "name": "Silk Waveforms",
