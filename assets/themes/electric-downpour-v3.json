      "custom": {
        "expression": "let col_idx = clamp(floor((p.x + 0.9) * 3.9), 0.0, 6.0);\nlet ph = col_idx / 6.0;\nlet bars_c = mix(mix(c1, c2, smoothstep(0.0, 0.4, ph)), mix(c3, c5, smoothstep(0.5, 0.9, ph)), smoothstep(0.35, 0.55, ph));\nlet lower_c = mix(c4, c1, step(0.5, fract(col_idx * 0.5)));\nlet lower = step(p.y, -0.36);\nlet bars_all = mix(bars_c, lower_c, lower);\nlet wrap = fract(p.y * 0.6 - t * roll_speed);\nlet roll = 0.6 + 0.4 * smoothstep(0.0, 0.3, wrap);\nlet scan = 0.82 + 0.18 * smoothstep(0.25, 0.5, fract(p.y * 90.0));\nlet base = bars_all * roll * scan;\nlet y0 = fract(t * 0.13) - 0.5;\nlet w = 1.0 - smoothstep(0.0, 0.05, abs(p.y - y0));\nlet n = hash(floor(p * vec2<f32>(140.0, 70.0)) + vec2<f32>(floor(t * 24.0) * 3.1, 0.0));\nlet color_a = mix(base, vec3<f32>(n), w * noise_amount * 0.8);\nlet frame = stroke(sd_box(p - vec2<f32>(-0.62, 0.36), vec2<f32>(0.12, 0.07)), 0.012);\nlet blink = step(0.5, fract(t * 0.8));\nlet lamp = fill(sd_circle(p - vec2<f32>(-0.5, 0.36), 0.02)) * blink;\nlet color_b = mix(color_a, c3, frame * 0.9);\nlet color = mix(color_b, c5, lamp);\nreturn mix(bg, tonemap(color * 1.1), strength);",
        "name": "Rolling Test Pattern",
