        "expression": "let tau = 6.2831853;\nlet drift = tau * fract(t / 120.0);\nlet clock = tau * fract(t * round(expansion_rate * 3600.0) / 3600.0);\nlet tide = vec2<f32>(cos(drift), sin(drift));\nlet g = p * 3.8 + tide * 0.37;\nlet warp = vec2<f32>(fbm(g), fbm(g + vec2<f32>(13.4, 7.1))) - vec2<f32>(0.5);\nlet q = p + warp * (0.11 + 0.14 * curl);\nlet a = polar(q - vec2<f32>(-0.30, 0.06) - tide * 0.055);\nlet b = polar(q - vec2<f32>(0.46, -0.19) + tide * 0.043);\nlet edge_a = smoothstep(0.02, 0.18, a.x);\nlet edge_b = smoothstep(0.02, 0.21, b.x);\nlet u = tau * a.x * ring_density - clock;\nlet v = tau * b.x * ring_density * 0.79 - clock + 2.1;\nlet angle_a = tau * a.y + 1.8 * a.x;\nlet angle_b = tau * b.y - 1.6 * b.x;\nlet fold_a = 1.45 * sin(7.0 * angle_a - u + 0.46 * sin(v)) +\n             0.62 * cos(4.0 * angle_a + u);\nlet fold_b = 1.23 * sin(6.0 * angle_b + v + 0.52 * sin(u));\nlet phase_a = u + curl * edge_a * fold_a + 0.42 * edge_b * sin(v);\nlet phase_b = v + curl * edge_b * fold_b + 0.36 * edge_a * sin(u);\nlet wave = cos(phase_a);\nlet echo = cos(phase_b);\nlet plume = cloud(q * 5.0 + tide * 0.23);\nlet bath = mix(c4, c1 * 0.81, smoothstep(0.18, 0.79, plume));\nlet stain_a = (0.23 + 0.77 * edge_a) * (1.0 - 0.33 * smoothstep(0.35, 1.35, a.x));\nlet stain_b = edge_b * (1.0 - 0.62 * smoothstep(0.28, 1.24, b.x));\nlet body_a = smoothstep(-0.55, 0.73, wave) * stain_a;\nlet body_b = smoothstep(0.12, 0.96, echo) * stain_b;\nlet under = mix(bath, mix(c1, c2, 0.64), body_b * ink_body * 0.8);\nlet dye = mix(c2 * 0.85, c2, smoothstep(0.22, 0.73, plume));\nlet ink = mix(under, dye, body_a * (0.34 + 0.66 * ink_body));\nlet lip = (1.0 - smoothstep(0.06, 0.25, abs(wave - 0.69))) *\n          smoothstep(-0.25, 0.23, sin(phase_a)) * stain_a;\nlet wet = smoothstep(0.24, 0.75, plume) * (0.63 + 0.37 * echo);\nlet seam = lip * smoothstep(0.62, 0.98, echo) * stain_b;\nlet rimmed = mix(ink, c3, lip * (0.33 + 0.49 * wet));\nlet finished = mix(rimmed, c5, seam * 0.36);\nreturn mix(bg, finished, strength);",
