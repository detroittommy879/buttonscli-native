      "custom": {
        "expression": "let pix = floor(p * 96.0) / 96.0;\nlet sc = floor(p * 140.0);\nlet hz = -0.02;\nlet above = step(hz, p.y);\nlet dy = max(hz - pix.y, 0.002);\nlet z = 0.06 / dy;\nlet gx = pix.x * z;\nlet vx = 1.0 - smoothstep(0.0, 0.05, abs(fract(gx + 0.5) - 0.5));\nlet vz = 1.0 - smoothstep(0.0, 0.05, abs(fract(z - t * grid_speed * 0.5 + 0.5) - 0.5));\nlet grid = clamp(vx + vz, 0.0, 1.0);\nlet glow = exp(-dy * 5.0);\nlet floor_col = c4 * 1.6 + c5 * glow * 0.35 + c1 * grid * (0.35 + glow);\nlet sky = mix(c4, c2 * 0.35, smoothstep(hz, 0.5, pix.y));\nlet sun_d = length(pix - vec2<f32>(0.0, 0.14)) - 0.3;\nlet sun_mask = 1.0 - step(0.0, sun_d);\nlet cut = step(pix.y, 0.1) * step(0.5, fract(pix.y * 40.0));\nlet sun_col = mix(c3, c1, clamp((pix.y + 0.1) * 2.0, 0.0, 1.0));\nlet tw = step(0.97, hash(sc + vec2<f32>(floor(t * 2.0), 3.0))) * step(hz + 0.15, pix.y);\nlet sky2 = sky + sun_col * sun_mask * (1.0 - cut) + c3 * tw * 0.8;\nlet far_h = hz + 0.03 + 0.1 * noise(vec2<f32>(pix.x * 2.5 + t * 0.02, 3.0));\nlet near_h = hz + 0.02 + 0.08 * noise(vec2<f32>(pix.x * 4.0 - t * 0.05, 8.0));\nlet m1 = step(pix.y, far_h);\nlet m2 = step(pix.y, near_h);\nlet edge = m1 * step(far_h - 0.012, pix.y) * c1;\nlet sky3 = mix(sky2, c4 * 2.2 + c2 * 0.15, m1) + edge * 0.8;\nlet sky4 = mix(sky3, c4 * 0.5, m2);\nlet world = mix(floor_col, sky4, above);\nlet scan = mix(1.0, 0.8 + 0.2 * sin(p.y * 1300.0), scan_amount);\nlet vig = clamp(1.0 - 0.7 * dot(p, p), 0.0, 1.0);\nlet color = tonemap(world * scan * vig * 1.2);\nreturn mix(bg, color, strength);",
