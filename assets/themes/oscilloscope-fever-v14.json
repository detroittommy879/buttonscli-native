      "custom": {
        "expression": "let cell = floor((p + vec2<f32>(0.5, 0.5)) * (120.0 / grain_size));\nlet frame = floor(t * 24.0);\nlet r = hash(cell + vec2<f32>(frame * 13.7, frame * 7.3));\nlet r2 = hash(cell * 1.37 + vec2<f32>(frame * 3.1, 11.0));\nlet grain = mix(r, r2, 0.25);\nlet contrast = smoothstep(0.1, 0.9, grain);\nlet band_y = fract(p.y + 0.5 - t * 0.09);\nlet band = smoothstep(0.0, 0.06, band_y) * (1.0 - smoothstep(0.06, 0.22, band_y));\nlet lift = band * roll * 0.35;\nlet scan = 0.92 + 0.08 * sin((p.y + 0.5) * (120.0 / grain_size) * 3.14159);\nlet base = mix(c4, c2, contrast);\nlet peak = mix(base, c5, smoothstep(0.75, 1.0, contrast) * 0.8);\nlet color = (peak + lift * c2) * scan;\nreturn mix(bg, color, strength);",
        "name": "Channel 3 Static",
        "variables": [
          {
            "max": 6.0,
            "min": 1.0,
            "name": "grain_size",
