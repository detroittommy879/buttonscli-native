        "expression": "var glow = vec3<f32>(0.0);\nfor (var i = 0; i < 6; i++) {\n    let n = f32(i);\n    let f = 2.0 + n * 0.7;\n    let ph = n * 1.3 + t * wave_speed * (0.6 + 0.15 * n);\n    let env = 0.6 + 0.4 * sin(p.x * 1.7 - t * 0.3 + n);\n    let y = wave_amp * sin(p.x * f * 3.0 + ph) * env + (n - 2.5) * 0.09;\n    let d = abs(p.y - y);\n    let core = 1.0 - smoothstep(0.0, line_width, d);\n    let glowv = halo(d, 0.05) * 0.35;\n    let pick = fract(n * 0.2 + p.y * 0.3);\n    let shade = mix(mix(c1, c2, pick), mix(c3, c5, pick), n / 5.0);\n    glow += shade * (core * 1.2 + glowv);\n}\nlet scan = 0.5 + 0.5 * sin(p.y * 220.0);\nlet base = c4 * (0.7 + 0.3 * scan) * (1.2 - abs(p.x) * 0.4);\nlet total = base + glow;\nreturn mix(bg, tonemap(total * 1.3), strength);",
