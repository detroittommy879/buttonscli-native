      "custom": {
        "expression": "let q = p / vec2<f32>(fan_scale) - vec2<f32>(0.0, t * rise_speed);\nlet smoke = cloud(q * vec2<f32>(1.5, 0.7) + vec2<f32>(0.13 * t, 0.0));\nlet curl = sin(q.y * 2.4 + t * 0.24) * 0.16 + (smoke - 0.5) * 0.5;\nlet ribbon = pow(0.5 + 0.5 * sin(q.x * 6.0 + curl * 7.0 + sin(q.y * 1.8)), 5.0);\nlet row = floor(q.y / 2.3);\nlet stagger = 0.5 * sin(row * 2.7);\nlet x = fract((q.x + curl + stagger) / 2.4 + 0.5) * 2.4 - 1.2;\nlet y = fract(q.y / 2.3) * 2.3;\nlet fold = sin(t * 0.32 + row * 1.3) * fold_amount;\nlet v = vec2<f32>(x * (1.0 + fold * 0.3), y + 0.16);\nlet radius = length(v);\nlet angle = atan2(v.x, v.y);\nlet sector = floor(angle * 7.0 + 0.5) / 7.0;\nlet stepped_radius = radius + abs(sector) * 0.24 + 0.06 * cos(sector * 14.0 + fold);\nlet fan = (1.0 - smoothstep(0.86, 1.04, abs(angle))) * smoothstep(0.18, 0.42, radius) * (1.0 - smoothstep(1.65, 1.95, stepped_radius));\nlet pleat = pow(0.5 + 0.5 * cos(angle * 42.0 + fold * sin(radius * 3.0)), 3.0);\nlet tier = pow(0.5 + 0.5 * cos(stepped_radius * 25.0), 10.0);\nlet rim = exp(-abs(stepped_radius - 1.66) * 42.0);\nlet haze = mix(c1, c4, clamp(smoke * 0.7 + ribbon * 0.3, 0.0, 1.0));\nlet fire = mix(c2, c5, 0.5 + 0.5 * sin(radius * 3.0 - t * 0.15));\nlet metal = mix(fire, c3, clamp(pleat * 0.3 + tier * 0.48 + rim * 0.65, 0.0, 1.0));\nlet color = mix(haze, metal, fan * (0.52 + pleat * 0.36)) + c2 * vec3<f32>(ribbon * 0.16);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
