      "custom": {
        "expression": "let power = clamp(amount / 10.0, 0.0, 1.0);\nlet uv = p * vec2<f32>(2.2) + vec2<f32>(t * 0.035, -t * 0.025);\nlet tile = floor(uv);\nlet seed = hash(tile);\nlet local = (fract(uv) - vec2<f32>(0.5)) * vec2<f32>(3.8);\nlet turn = select(local, vec2<f32>(-local.y, local.x), seed > 0.5);\nlet q = select(turn, -turn, fract(seed * 7.13) > 0.5);\nlet bar = abs(q - vec2<f32>(0.0, 0.5)) - vec2<f32>(1.45, 0.45);\nlet stem = abs(q - vec2<f32>(0.0, -0.5)) - vec2<f32>(0.45);\nlet db = length(max(bar, vec2<f32>(0.0))) + min(max(bar.x, bar.y), 0.0);\nlet ds = length(max(stem, vec2<f32>(0.0))) + min(max(stem.x, stem.y), 0.0);\nlet d = min(db, ds);\nlet fill = 1.0 - smoothstep(-0.008, 0.012, d);\nlet edge = 1.0 - smoothstep(0.009, 0.032, abs(d));\nlet inner = (1.0 - smoothstep(0.006, 0.018, abs(d + 0.085))) * fill;\nlet glow = exp(-abs(d) * 25.0);\nlet brick = fract(q + vec2<f32>(0.5, 0.0)) - vec2<f32>(0.5);\nlet diamond = abs(brick.x) + abs(brick.y);\nlet inset = (1.0 - smoothstep(0.009, 0.024, abs(diamond - 0.235))) * fill;\nlet seam = (1.0 - smoothstep(0.006, 0.018, 0.5 - abs(brick.x))) * fill;\nlet hue = fract(seed * 0.83 + t * 0.008);\nlet color = mix(hsv(hue, 0.82, 1.0), clamp(mix(c1, c2, seed), vec3<f32>(0.0), vec3<f32>(1.0)), 0.18);\nlet accent = hsv(fract(hue + 0.16), 0.72, 1.0);\nlet pulse = 0.94 + 0.06 * sin(t * 1.1 + seed * 15.0);\nlet grid = fract(uv);\nlet gridDistance = min(min(grid.x, 1.0 - grid.x), min(grid.y, 1.0 - grid.y));\nlet gridLine = 1.0 - smoothstep(0.001, 0.005, gridDistance);\nlet base = vec3<f32>(0.003, 0.005, 0.012) + clamp(c3, vec3<f32>(0.0), vec3<f32>(1.0)) * vec3<f32>(gridLine * 0.035);\nlet energy = 0.5 + power * 0.5;\nlet body = fill * 0.022;\nlet neon = color * vec3<f32>((edge * 0.78 + glow * 0.055 + body) * pulse * energy);\nlet details = accent * vec3<f32>((inner * 0.15 + inset * 0.25 + seam * 0.11) * energy);\nlet vignette = 1.0 / (1.0 + dot(p, p) * 0.1);\nreturn clamp((base + neon + details) * vec3<f32>(vignette), vec3<f32>(0.0), vec3<f32>(0.88));",
