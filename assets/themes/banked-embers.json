        "expression": "let clock = t * 0.00174532925;\nlet slow = vec2<f32>(sin(clock * 23.0), cos(clock * 23.0));\nlet fast = vec2<f32>(sin(clock * 47.0 + 1.4), cos(clock * 47.0 + 1.4));\nlet bed = -0.432 + 0.006 * sin(p.x * 14.0 + slow.x) + 0.004 * sin(p.x * 37.0);\nlet rise = p.y - bed;\n\nlet left = p - vec2<f32>(-0.70 + 0.045 * slow.x, -0.255 + 0.022 * slow.y);\nlet right = p - vec2<f32>(0.70 + 0.045 * fast.y, -0.252 + 0.022 * slow.x);\nlet dl = dot(left, left);\nlet dr = dot(right, right);\nlet twist_l = curl_amount * (2.75 + 0.45 * slow.y) * exp(-17.0 * dl);\nlet twist_r = curl_amount * (2.95 + 0.38 * fast.x) * exp(-16.0 * dr);\nlet bend = rotate(left, twist_l) - left + rotate(right, -twist_r) - right;\nlet q = p + bend + vec2<f32>(0.095 * sin(rise * 7.5 + slow.x), 0.0);\n\nlet a = q * vec2<f32>(2.8, 4.8) + slow * vec2<f32>(0.61, 0.24);\nlet warp_a = vec2<f32>(noise(a + vec2<f32>(4.2, 8.1)), noise(a + vec2<f32>(-5.4, 2.6))) - vec2<f32>(0.5);\nlet bank = fbm(a + warp_a * 2.7);\nlet b = (q + bend * 0.19) * vec2<f32>(4.7, 10.6) + fast * vec2<f32>(0.82, 0.39);\nlet warp_b = vec2<f32>(noise(b * 0.57 + vec2<f32>(8.3, -3.1)), noise(b * 0.57 + vec2<f32>(2.7, 5.8))) - vec2<f32>(0.5);\nlet filament = cloud(b + warp_b * 2.35);\n\nlet lift = smoothstep(-0.022, 0.075, rise);\nlet dissolve = 1.0 - smoothstep(0.17, 0.83, rise + 0.20 * (0.52 - bank));\nlet plume = lift * dissolve;\nlet corners = exp(-13.0 * min(dl, dr));\nlet body = smoothstep(0.27, 0.73, bank + (smoke_density - 1.0) * 0.13);\nlet thread = exp(-16.0 * abs(filament - 0.56)) * smoothstep(0.31, 0.61, bank);\nlet wash = c1 * (0.32 + plume * (0.53 + body));\nlet smoke_tint = mix(c2, c3, smoothstep(0.06, 0.48, rise));\nlet smoke = smoke_tint * plume * body * (0.58 + 0.38 * corners) * smoke_density;\nlet wisp_tint = mix(c3, c4, corners * (1.0 - smoothstep(0.07, 0.40, rise)));\nlet wisps = wisp_tint * plume * thread * (0.23 + 0.89 * corners) * smoke_density;\n\nlet coal = noise(vec2<f32>(p.x * 39.0 + 0.23 * fast.x, 4.0 + 0.28 * fast.y));\nlet seam = exp(-abs(rise) * 245.0) * (0.24 + 0.76 * smoothstep(0.28, 0.72, coal));\nlet ember = c2 * (seam * 0.66 + exp(-abs(rise) * 43.0) * 0.14) * ember_glow;\nreturn mix(bg, tonemap(wash + smoke + wisps + ember), strength);",
