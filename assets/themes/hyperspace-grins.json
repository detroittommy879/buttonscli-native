      "custom": {
        "expression": "let trip = m * 0.1;\nlet drift = p * vec2<f32>(density) + vec2<f32>(t * 0.055, -t * 0.035);\nlet warp = vec2<f32>(sin(drift.y * 3.4 + t * 0.7), cos(drift.x * 3.1 - t * 0.6)) * vec2<f32>(wobble * (0.06 + trip * 0.22));\nlet uv = drift + warp;\nlet id = floor(uv);\nlet seed = hash(id);\nlet q = fract(uv) - vec2<f32>(0.5);\nlet r = length(q);\nlet angle = atan2(q.y, q.x);\nlet wave = sin(r * (25.0 + trip * 35.0) - t * 2.0 + sin(angle * 6.0 + t * 0.4) * trip * 2.0);\nlet hue = seed * 0.65 + t * 0.045 + wave * 0.09 + trip * 0.12;\nlet electric = palette(hue);\nlet secondary = palette(hue + 0.32);\nlet ink = mix(c3, vec3<f32>(0.025, 0.008, 0.085), 0.65);\nlet ground = mix(c1, secondary * vec3<f32>(0.40), 0.75);\nlet lattice = pow(0.5 + 0.5 * wave, 7.0);\nlet backdrop = ground + electric * vec3<f32>(lattice * (0.12 + glow * 0.27));\nlet body_distance = length(max(abs(q) - vec2<f32>(0.24, 0.20), vec2<f32>(0.0))) - 0.15;\nlet body = 1.0 - smoothstep(-0.008, 0.014, body_distance);\nlet rim = exp(-100.0 * abs(body_distance));\nlet cheek = mix(electric, secondary, 0.25 + 0.16 * wave);\nlet shading = 0.78 + 0.22 * cos(q.y * 4.0 - q.x * 2.0);\nlet face = mix(backdrop, cheek * vec3<f32>(shading), body);\nlet outlined = mix(face, ink, rim * 0.85);\nlet eye_y = -0.075 + 0.018 * sin(t * 1.4 + seed * 12.0);\nlet eye_q = vec2<f32>(abs(q.x) - 0.125, q.y - eye_y);\nlet eyes = 1.0 - smoothstep(0.052, 0.066, length(eye_q));\nlet pupil_q = eye_q - vec2<f32>(0.013 * sin(t + seed * 8.0), 0.006 * cos(t * 1.3));\nlet pupils = 1.0 - smoothstep(0.019, 0.026, length(pupil_q));\nlet eye_color = mix(c2, secondary, 0.12);\nlet eyed = mix(outlined, eye_color, eyes);\nlet looking = mix(eyed, palette(hue + 0.55), pupils);\nlet smile_q = q - vec2<f32>(0.0, 0.015);\nlet smile = (1.0 - smoothstep(0.012, 0.025, abs(length(smile_q) - 0.18))) * smoothstep(0.025, 0.065, smile_q.y);\nlet grinning = mix(looking, ink, smile);\nlet aura = secondary * vec3<f32>(exp(-23.0 * abs(body_distance)) * glow * 0.32);\nlet color = clamp(grinning + aura, vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
