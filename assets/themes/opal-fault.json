      "custom": {
        "expression": "let q = rotate(p, -0.23);\nlet grain = noise(q * vec2<f32>(19.0, 83.0));\nlet warp = noise(q * 9.0) - 0.5;\nlet g = q * facet_density + vec2<f32>(0.17, -0.11) * warp;\nlet cell = voronoi(g);\n\nlet axis = dot(p, vec2<f32>(0.91, 0.41));\nlet rate = round(sweep_speed * 572.9578) / 572.9578;\nlet front = 1.23 * sin(t * rate);\nlet beam = axis - front;\nlet wash = 1.0 - smoothstep(0.04, 0.48, abs(beam));\nlet offset = (cell.z - 0.5) * 0.42;\nlet glint = 1.0 - smoothstep(0.015, 0.18, abs(beam + offset));\n\nlet prism = mix(c3, c4, smoothstep(0.18, 0.82, cell.z));\nlet relief = saturate(0.47 + 0.34 * cell.z - 0.20 * cell.x + 0.10 * grain + 0.14 * wash);\nlet slate = mix(c1, c2, relief);\nlet face = mix(slate, prism, 0.025 + 0.11 * glint);\n\nlet recess = 1.0 - smoothstep(seam_width, seam_width + 0.052, cell.y);\nlet bevel = 1.0 - smoothstep(seam_width, seam_width + 0.027, cell.y);\nlet thread = 1.0 - smoothstep(seam_width * 0.32, seam_width + 0.009, cell.y);\nlet bed = mix(face, c1, recess * 0.52);\nlet shimmer = mix(bed, prism, bevel * (0.04 + 0.31 * glint));\nlet color = mix(shimmer, prism, thread * (0.31 + 0.66 * glint));\nreturn mix(bg, color, strength);",
        "name": "Opal Fault",
