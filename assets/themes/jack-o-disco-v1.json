        "expression": "let density = 1.3 + amount * 0.32;\nlet drift = t * gravity * 0.24;\nlet wave = sin(p.y * 2.3 + t * 0.35) * 0.18 + sin(p.x * 1.7 - t * 0.22) * 0.12;\nlet flow = p + vec2<f32>(wave, drift);\nlet grid = flow * vec2<f32>(density);\nlet row = floor(grid.y);\nlet staggered = grid + vec2<f32>(sin(row * 2.4) * 0.28, 0.0);\nlet cell = floor(staggered);\nlet q = fract(staggered) - vec2<f32>(0.5);\nlet seed = hash(cell);\nlet angle = sin(t * 0.32 + seed * 6.283 + row * 0.45) * 0.65 + seed * 6.283;\nlet r = vec2<f32>(q.x * cos(angle) - q.y * sin(angle), q.x * sin(angle) + q.y * cos(angle));\nlet size = shape_size * (0.68 + seed * 0.18);\nlet d = max(abs(r.x) * 0.866025 + r.y * 0.5, -r.y) - size * 0.65;\nlet fill = 1.0 - smoothstep(-0.014, 0.012, d);\nlet rim = exp(-abs(d) * 85.0);\nlet halo = exp(-max(d, 0.0) * 17.0) * (1.0 - fill);\nlet bands = 0.5 + 0.5 * sin(d * 110.0 - t * 1.8 + seed * 8.0);\nlet interior = mix(0.32, 0.92, bands) * fill;\nlet contour = pow(0.5 + 0.5 * sin(d * 62.0 - t * 1.1), 14.0) * exp(-max(d, 0.0) * 7.0) * (1.0 - fill);\nlet tide = 0.5 + 0.5 * sin(p.x * 1.9 + p.y * 2.6 + sin(p.y * 3.0 - t * 0.4) + t * 0.23);\nlet blue = mix(vec3<f32>(0.025, 0.17, 0.85), vec3<f32>(0.02, 0.78, 1.0), seed);\nlet neon = mix(blue, vec3<f32>(0.39, 0.16, 1.0), smoothstep(0.7, 1.0, seed) * 0.65);\nlet base = mix(vec3<f32>(0.015, 0.045, 0.19), vec3<f32>(0.035, 0.19, 0.43), tide);\nlet activity = smoothstep(0.0, 0.7, amount);\nlet light = interior * 0.85 + rim * 0.8 + halo * glow * 0.4 + contour * glow * 0.18;\nlet color = clamp(base + neon * vec3<f32>(activity * light), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
