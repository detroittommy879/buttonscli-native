      "custom": {
        "expression": "let drift = vec2<f32>(sin(t * 0.11), cos(t * 0.09)) * vec2<f32>(0.12 * parallax);\nlet sky = smoothstep(-1.2, 1.4, p.y);\nlet mist = cloud(p * vec2<f32>(1.4, 2.1) + drift + vec2<f32>(t * 0.025, 0.0));\nlet base = mix(c2, c1, sky * 0.8);\nlet haze = mix(base, c3, 0.18 + mist * 0.34);\nlet bands = 0.5 + 0.5 * sin(p.y * 5.0 + mist * 3.0 + p.x * 0.4);\nlet atmosphere = mix(haze, c2, bands * 0.17);\n\nlet a = (p + drift * vec2<f32>(0.25)) * vec2<f32>(25.0 * rain_density, 5.5) + vec2<f32>(p.y * 1.4, t * rain_speed * 1.8);\nlet aid = floor(a);\nlet ar = hash(aid);\nlet af = fract(a);\nlet ax = abs(af.x - (0.25 + ar * 0.5));\nlet ay = abs(af.y - 0.5);\nlet far_rain = (1.0 - smoothstep(0.012, 0.06, ax)) * (1.0 - smoothstep(0.13, 0.42, ay)) * step(0.28, ar);\n\nlet b = (p + drift * vec2<f32>(0.65)) * vec2<f32>(16.0 * rain_density, 3.7) + vec2<f32>(p.y * 1.1, t * rain_speed * 2.7);\nlet bid = floor(b);\nlet br = hash(bid + vec2<f32>(31.0, 7.0));\nlet bf = fract(b);\nlet bx = abs(bf.x - (0.22 + br * 0.56));\nlet by = abs(bf.y - 0.5);\nlet mid_rain = (1.0 - smoothstep(0.009, 0.046, bx)) * (1.0 - smoothstep(0.18, 0.46, by)) * step(0.46, br);\n\nlet d = (p + drift) * vec2<f32>(9.0 * rain_density, 2.2) + vec2<f32>(p.y * 0.8, t * rain_speed * 3.5);\nlet did = floor(d);\nlet dr = hash(did + vec2<f32>(63.0, 19.0));\nlet df = fract(d);\nlet dx = abs(df.x - (0.2 + dr * 0.6));\nlet dy = abs(df.y - 0.5);\nlet near_rain = (1.0 - smoothstep(0.008, 0.034, dx)) * (1.0 - smoothstep(0.21, 0.48, dy)) * step(0.68, dr);\nlet halo = exp(-dx * 42.0) * (1.0 - smoothstep(0.2, 0.49, dy)) * step(0.68, dr);\nlet distant = mix(atmosphere, c3, far_rain * 0.38);\nlet middle = mix(distant, c4, mid_rain * 0.52);\nlet foreground = mix(middle, c5, near_rain * 0.72);\nlet color = clamp(foreground + c4 * vec3<f32>(halo * rain_glow * 0.16), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
