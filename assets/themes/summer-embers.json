      "custom": {
        "expression": "let base = mix(c3 * 0.25, c5 * 0.5, smoothstep(-0.5, 0.5, p.y));\nlet col_g = p.x * 9.0;\nlet col = floor(col_g);\nlet colseed = hash(vec2<f32>(col, 3.0));\nlet fall = (0.1 + 0.12 * colseed) * fall_speed;\nlet g = vec2<f32>(col_g, p.y * 6.0 + t * fall + colseed * 7.0);\nlet cell = floor(g);\nlet seed = hash(cell);\nlet jitter = (hash2(cell) - 0.5) * 0.3;\nlet sway = vec2<f32>(0.08 * sin(t * 0.5 + colseed * 6.28), 0.0);\nlet local = fract(g) - 0.5 - jitter - sway;\nlet arms = abs(local.x) + abs(local.y);\nlet size = (0.1 + 0.08 * seed) * flake_size;\nlet diamond = arms - size;\nlet cross_d = max(min(abs(local.x), abs(local.y)) - 0.012, arms - size * 1.5);\nlet lit = step(0.35, seed);\nlet twinkle = 0.65 + 0.35 * sin(t * (0.6 + seed) + seed * 9.0);\nlet rim = stroke(diamond, 0.018);\nlet core = fill(diamond + size * 0.5);\nlet spark = fill(cross_d);\nlet flakes = (mix(c1, c2, core) * max(rim, spark * 0.7) + c1 * halo(diamond, 0.05) * 0.3) * lit * twinkle;\nlet color = base + flakes * 1.2;\nreturn mix(bg, tonemap(color), strength);",
        "name": "Deco Snowfall",
        "variables": [
          {
            "max": 1.600000023841858,
            "min": 0.6000000238418579,
            "name": "flake_size",
            "value": 1.0
