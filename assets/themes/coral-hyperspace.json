      "custom": {
        "expression": "let time = t * (0.12 + gravity * 0.14);\nlet q = p + vec2<f32>(0.06 * sin(time), 0.06 * cos(time * 0.83));\nlet r = length(q);\nlet a = atan2(q.y, q.x);\nlet petals = 6.0 + floor(amount * 0.6);\nlet fold = abs(fract(a * petals / 6.283185 + time * 0.06) - 0.5) * 2.0;\nlet breath = r * (2.4 / (0.5 + shape_size)) - time;\nlet warp = breath + 0.32 * sin(fold * 6.283185 + breath * 1.8) + 0.18 * sin(a * petals - time);\nlet ribbon = 0.5 + 0.5 * sin(warp * 6.283185);\nlet lace = abs(sin(warp * 9.424778 + cos(fold * 12.56637) * 1.8));\nlet thread = exp(-lace * (16.0 + amount));\nlet jewels = pow(0.5 + 0.5 * cos(fold * 12.56637 + warp * 6.283185), 10.0);\nlet coral = mix(c1, c2, ribbon);\nlet spectral = palette(warp * 0.12 + fold * 0.28 + time * 0.035);\nlet base = mix(coral, spectral, 0.48) * vec3<f32>(0.48 + 0.38 * ribbon);\nlet filigree = mix(c2, c3, 0.32) * vec3<f32>(thread * (0.2 + glow * 0.32));\nlet sparks = spectral * vec3<f32>(jewels * (0.16 + glow * 0.2));\nlet color = clamp(base + filigree + sparks, vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
