      "custom": {
        "expression": "let sky = mix(c4, c1 * 0.8, smoothstep(-0.5, 0.5, p.y));\nlet far_cl = fbm(vec2<f32>(p.x * 1.4 + t * 0.03, p.y * 2.0 + 3.0));\nlet near_cl = fbm(vec2<f32>(p.x * 2.8 - t * 0.08, p.y * 3.5 + 7.0));\nlet far_mask = smoothstep(0.35, 0.8, far_cl);\nlet near_mask = smoothstep(0.4, 0.85, near_cl);\nlet far_col = mix(c4, c1, far_cl) * far_mask * 0.7;\nlet slot = floor(t * 0.35);\nlet ph = fract(t * 0.35);\nlet on = step(0.35, hash(vec2<f32>(slot, 3.0)));\nlet flash_amt = on * exp(-ph * 18.0) * flash_power;\nlet bolt_amt = on * exp(-ph * 10.0) * flash_power;\nlet near_lit = mix(c2 * 0.6, c2 * 1.2, smoothstep(-0.1, 0.5, p.y));\nlet near_col = near_lit * near_mask + c5 * flash_amt * near_mask * 0.6;\nlet bx = (hash(vec2<f32>(slot, 8.0)) - 0.5) * 1.2 + (noise(vec2<f32>(p.y * 6.0, slot)) - 0.5) * 0.3 + (noise(vec2<f32>(p.y * 14.0, slot + 1.0)) - 0.5) * 0.08;\nlet bd = abs(p.x - bx);\nlet bolt = smoothstep(0.012, 0.0, bd) * bolt_amt;\nlet bolt_glow = exp(-bd * 14.0) * bolt_amt * 0.6;\nlet g_far = vec2<f32>(p.x * 45.0, p.y * 3.0 + t * 1.2);\nlet c_far = floor(g_far);\nlet l_far = fract(g_far) - 0.5;\nlet xo_far = (hash(c_far + vec2<f32>(3.0, 1.0)) - 0.5) * 0.6;\nlet yo_far = hash(c_far + vec2<f32>(5.0, 2.0)) * 0.6 - 0.3;\nlet occ_far = step(1.0 - rain_density, hash(c_far));\nlet streak_far = smoothstep(0.05, 0.0, abs(l_far.x - xo_far)) * smoothstep(yo_far - 0.35, yo_far, l_far.y) * (1.0 - smoothstep(yo_far, yo_far + 0.05, l_far.y)) * occ_far;\nlet g_near = vec2<f32>(p.x * 22.0, p.y * 2.0 + t * 2.2);\nlet c_near = floor(g_near);\nlet l_near = fract(g_near) - 0.5;\nlet xo_near = (hash(c_near + vec2<f32>(4.0, 9.0)) - 0.5) * 0.6;\nlet yo_near = hash(c_near + vec2<f32>(6.0, 1.0)) * 0.6 - 0.3;\nlet occ_near = step(1.0 - rain_density * 0.7, hash(c_near + vec2<f32>(2.0, 5.0)));\nlet streak_near = smoothstep(0.04, 0.0, abs(l_near.x - xo_near)) * smoothstep(yo_near - 0.3, yo_near, l_near.y) * (1.0 - smoothstep(yo_near, yo_near + 0.05, l_near.y)) * occ_near;\nlet rain = c3 * (streak_far * 0.45 + streak_near * 0.9);\nlet color = sky + far_col + near_col + c3 * flash_amt * 0.25 + rain + c5 * bolt * 2.0 + c5 * bolt_glow;\nreturn mix(bg, tonemap(color), strength);",
        "name": "Electric Storm",
