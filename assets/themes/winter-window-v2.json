        "expression": "let haze = cloud(p * 1.3 + vec2<f32>(t * 0.025, 0.0));\nlet base = mix(c1, c2, 0.2 + 0.35 * haze);\nlet snow_uv = p * 5.0 + vec2<f32>(0.0, t * snow_speed);\nlet snow_id = floor(snow_uv);\nlet snow_rand = hash(snow_id);\nlet snow_center = vec2<f32>(0.2 + 0.6 * snow_rand, 0.2 + 0.6 * hash(snow_id + vec2<f32>(17.0, 31.0)));\nlet snow_dist = length(fract(snow_uv) - snow_center);\nlet snow = (1.0 - smoothstep(0.025, 0.12, snow_dist)) * step(0.48, snow_rand);\nlet rain_uv = vec2<f32>(p.x * 14.0 + p.y * 1.2, p.y * 4.0 + t * rain_speed);\nlet rain_id = floor(rain_uv);\nlet rain_rand = hash(rain_id + vec2<f32>(42.0, 9.0));\nlet rain_pos = fract(rain_uv) - vec2<f32>(0.2 + 0.6 * rain_rand, 0.5);\nlet rain = (1.0 - smoothstep(0.015, 0.055, abs(rain_pos.x))) * (1.0 - smoothstep(0.12, 0.42, abs(rain_pos.y))) * step(0.58, rain_rand);\nlet color = mix(mix(base, c3, rain * 0.55), c4, snow * 0.8);\nreturn mix(bg, color, strength);",
        "name": "Winter Window",
