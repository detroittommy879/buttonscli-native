      "custom": {
        "expression": "let depth = 0.75 - p.y;\nlet fl = vec2<f32>(p.x / depth, 1.0 / depth) * 0.9 + vec2<f32>(0.0, t * 0.15);\nlet cell = floor(fl);\nlet local = fract(fl) - 0.5;\nlet frame = max(abs(local.x), abs(local.y));\nlet tile_in = 1.0 - smoothstep(0.40, 0.42, frame);\nlet gold_rim = smoothstep(0.38, 0.41, frame) * (1.0 - smoothstep(0.44, 0.47, frame));\nlet beam_x = 0.8 * sin(t * 0.45) + 0.3 * p.y;\nlet dist_b = abs(p.x - beam_x);\nlet beam = exp(-(dist_b * dist_b) / (beam_width * (0.006 + 0.02 * depth)));\nlet hue = hash(cell + vec2<f32>(3.1, 7.7));\nlet tint = hsv(hue, 0.55, 0.95);\nlet flash = clamp(beam * (0.7 + 0.3 * hash(cell)) * 1.5, 0.0, 1.0);\nlet tile = mix(c4 * 1.4, tint, 0.3 + 0.7 * flash) * tile_in;\nlet rim = mix(c1, c5, beam) * gold_rim * (0.5 + 0.8 * beam);\nlet beam_glow = c2 * beam * 0.3;\nlet fade = clamp(1.3 - depth * 0.6, 0.0, 1.0);\nlet color = tonemap((tile + rim + beam_glow) * fade);\nreturn mix(bg, color, strength);",
        "name": "Gilded Searchlight",
