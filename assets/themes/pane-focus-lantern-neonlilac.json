{
  "version": 1,
  "metadata": {
    "id": "pane-focus-lantern-neonlilac",
    "name": "Night Signals / NeonLilac",
    "nativeThemeVersion": 1,
    "description": "Soft vertical light columns, colored like a city at night. NeonLilac pane; stable hue, dark background, gentle contrast."
  },
  "theme": {
    "mode": "dark",
    "app": {
      "shell": {
        "background": "#090c12",
        "backgroundSecondary": "#141217",
        "buttonBackground": "#141217",
        "border": "#3c3246",
        "textMain": "#e5eaf2",
        "textDim": "#a4afbf",
        "accent": "#bd93e5",
        "accentHover": "#caaae8",
        "paneDivider": {
          "color": "#bd93e5",
          "thickness": 2.0
        }
      },
      "tabs": {
        "background": "#090c12",
        "idleBackground": "#141217",
        "activeBackground": "#3c3246",
        "activeBorder": "#bd93e5"
      },
      "presetDock": {
        "background": "#141217",
        "buttonBackground": "#141217",
        "buttonHover": "#3c3246",
        "buttonText": "#e5eaf2",
        "accent": "#bd93e5"
      },
      "settings": {
        "background": "#0d111a"
      },
      "statusBar": {
        "background": "#090c12",
        "border": "#3c3246",
        "text": "#bac5d4",
        "warning": "#e8ce8a"
      }
    },
    "terminal": {
      "background": "#0a080b",
      "foreground": "#e5eaf2",
      "ansiColors": {
        "black": "#586174",
        "red": "#ed919b",
        "green": "#a3d6a0",
        "yellow": "#e8ce8a",
        "blue": "#95b9f1",
        "magenta": "#ceb0ec",
        "cyan": "#94d6d9",
        "white": "#dce3ed",
        "brightBlack": "#99a3b6",
        "brightRed": "#ffb0b9",
        "brightGreen": "#c1ebbc",
        "brightYellow": "#f5e2ac",
        "brightBlue": "#bad2ff",
        "brightMagenta": "#e0c7ff",
        "brightCyan": "#b6eceb",
        "brightWhite": "#f6f8fc"
      },
      "useGradient": true,
      "gradientType": "linear",
      "gradientAngle": 135.0,
      "gradientColors": [
        "#030408",
        "#100d13",
        "#2f2539",
        "#271f2f"
      ],
      "gradientAnimation": false
    }
  },
  "effects": {
    "masterDisabled": false,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "simpleNoiseEnabled": false,
    "shaderBackground": {
      "version": 1,
      "preset": "aurora",
      "strength": 0.9,
      "speed": 0.22,
      "scale": 1.0,
      "animated": true,
      "colors": [
        "#030408",
        "#100d13",
        "#2f2539",
        "#271f2f",
        "#3b2e47"
      ],
      "theme_colors": false,
      "custom": {
        "name": "Pane Focus / Signal Columns",
        "expression": "let sway = sin(p.y * 0.6 + t * 0.08) * 0.12;\nlet beam = pow(0.5 + 0.5 * cos(p.x * spacing + sway), 4.0);\nlet falloff = clamp(0.6 - p.y * 0.22, 0.15, 0.9);\nlet base = mix(c1, c2, falloff);\nlet light = mix(c3, c4, clamp(p.y * 0.25 + 0.5, 0.0, 1.0));\nreturn mix(bg, mix(base, light, 0.25 + beam * depth * 0.6) + c5 * beam * 0.04, strength);",
        "y_up": true,
        "variables": [
          {
            "name": "spacing",
            "min": 1.0,
            "max": 6.0,
            "value": 2.8
          },
          {
            "name": "depth",
            "min": 0.2,
            "max": 1.0,
            "value": 0.85
          }
        ]
      }
    }
  }
}
