      "custom": {
        "expression": "let tau = 6.2831853;\nlet hour = t / 3600.0;\nlet eye = wander * vec2<f32>(\n    0.103 * sin(tau * hour * 53.0) + 0.027 * sin(tau * hour * 127.0),\n    0.072 * sin(tau * hour * 41.0 + 1.2)\n);\nlet q = polar((p - eye) * vec2<f32>(0.91, 1.0) + vec2<f32>(0.000001, 0.0));\nlet r = q.x;\nlet depth = log(1.0 + r * 19.0);\nlet aperture = smoothstep(0.028, 0.215, r);\nlet rib = 0.5 + 0.5 * cos(tau * q.y * 9.0 + 0.42 * sin(depth * 2.1));\nlet wall = 0.32 + 0.34 * rib + 0.18 * smoothstep(0.18, 0.65, r);\nlet wash = mix(c1 * 0.72, mix(c2, c3, rib * 0.52), wall);\n\nlet wave = fract(r * 0.72 - hour * 219.0 + 0.31) - 0.5;\nlet crest = exp(-abs(wave) * 39.0);\nlet afterglow = exp(-abs(wave + 0.045) * 13.0);\nlet pulse = pulse_glow * (crest * 0.20 + afterglow * 0.17);\n\nvar wake = vec3<f32>(0.0);\nfor (var i = 0; i < 2; i++) {\n    let k = f32(i);\n    let lanes = mix(104.0, 59.0, k);\n    let a = fract(q.y + k * 0.173) * lanes;\n    let lane = floor(a);\n    let seed = hash(vec2<f32>(lane, 3.0 + k));\n    let cycles = round(3600.0 * wake_speed * (1.9 + 0.82 * k + 0.55 * seed) / 64.0);\n    let z = depth * (6.1 - 2.5 * k) - 64.0 * fract(hour * cycles) + seed * 23.0;\n    let tile = 64.0 * fract(floor(z) / 64.0);\n    let h = hash(vec2<f32>(lane + k * 133.0, tile));\n    let x = abs(fract(a) - (0.31 + 0.38 * seed));\n    let core = 1.0 - smoothstep(0.026 + 0.028 * h, 0.094 + 0.053 * h, x);\n    let fringe = 1.0 - smoothstep(0.07, 0.25, x);\n    let f = fract(z);\n    let start = 0.94 - streak_length * (0.54 + 0.44 * h);\n    let dash = smoothstep(start, 0.87, f) * (1.0 - smoothstep(0.91, 0.99, f));\n    let tint = mix(mix(c2, c3, h), c4, smoothstep(0.74, 1.0, h) * 0.7);\n    let lit = smoothstep(0.27, 0.68, h);\n    wake += tint * dash * lit * (core + 0.21 * fringe) * (0.78 + 0.42 * k + pulse);\n}\nlet scene = wash + c3 * pulse + wake;\nreturn mix(bg, tonemap(scene * aperture), strength);",
