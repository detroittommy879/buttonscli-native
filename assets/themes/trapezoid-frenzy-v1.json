      "custom": {
        "expression": "let density = (0.8 + amount * 0.13) / (0.45 + shape_size * 2.0);\nlet y = p.y * density + t * gravity * 0.32;\nlet row = floor(y);\nlet clock = t * (0.65 + gravity * 1.3) + hash(vec2<f32>(row, 8.0)) * 7.0;\nlet beat = floor(clock);\nlet dart = smoothstep(0.12, 0.38, fract(clock));\nlet start = hash(vec2<f32>(row, beat)) * 4.0;\nlet finish = hash(vec2<f32>(row, beat + 1.0)) * 4.0;\nlet x = p.x * density * 0.72 + mix(start, finish, dart);\nlet cell = floor(x);\nlet uv = vec2<f32>(fract(x), fract(y));\nlet lean = 0.22 * cos(row * 2.3);\nlet divider = 0.5 + lean * (uv.y * 2.0 - 1.0);\nlet side = step(divider, uv.x);\nlet seam = abs(uv.x - divider) / sqrt(1.0 + 4.0 * lean * lean);\nlet edge = min(min(uv.x, 1.0 - uv.x), min(min(uv.y, 1.0 - uv.y), seam));\nlet tile = smoothstep(0.012, 0.028, edge);\nlet seed = hash(vec2<f32>(cell * 2.0 + side, row));\nlet base = mix(c1, c2, seed);\nlet tint = mix(base, c3, 0.26 * step(0.76, seed));\nlet shading = 0.72 + 0.25 * uv.y + 0.08 * sin(seed * 6.283 + t * 1.4);\nlet rim = exp(-edge * 65.0) * tile;\nlet halo = exp(-edge * 22.0) * glow * 0.12;\nlet grout = mix(bg, c1, 0.2);\nlet color = mix(grout, tint * vec3<f32>(shading), tile)\n  + mix(c2, c3, 0.35) * vec3<f32>(rim * (0.18 + glow * 0.2) + halo);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
