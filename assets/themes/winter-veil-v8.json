      "custom": {
        "expression": "let sky = smoothstep(-1.2, 1.4, p.y);\nlet base = mix(c1, mix(c1, c3, 0.45), sky);\nlet wave = 0.35 * sin(p.x * 1.7 + t * 0.13) + 0.16 * sin(p.x * 3.8 - t * 0.19);\nlet veil = exp(-abs(p.y - 0.42 - wave) * 2.8);\nlet folds = 0.55 + 0.45 * sin(p.x * 8.0 + cloud(p * 1.2 + vec2<f32>(t * 0.06, 0.0)) * 5.0);\nlet ribbon = mix(c2, c3, 0.5 + 0.5 * sin(p.x * 1.1 + t * 0.12));\nlet sky_color = mix(base, ribbon, veil * folds * aurora * 0.85);\nlet q = (p + vec2<f32>(-t * wind * 0.12, t * 0.19)) * (5.0 * sqrt(snowfall));\nlet cell = floor(q);\nlet seed = hash(cell);\nlet center = vec2<f32>(0.2 + 0.6 * seed, 0.2 + 0.6 * hash(cell + vec2<f32>(7.1, 3.2)));\nlet offset = fract(q) - center;\nlet radius = (0.025 + 0.045 * seed) * flake_size;\nlet flakes = 1.0 - smoothstep(radius * 0.35, radius, length(offset));\nlet q2 = (p + vec2<f32>(-t * wind * 0.22 + 0.06 * sin(t * 0.5 + p.y), t * 0.36)) * (3.3 * sqrt(snowfall));\nlet cell2 = floor(q2);\nlet seed2 = hash(cell2 + vec2<f32>(13.2, 2.8));\nlet center2 = vec2<f32>(0.2 + 0.6 * seed2, 0.2 + 0.6 * hash(cell2 + vec2<f32>(4.6, 17.3)));\nlet d2 = length(fract(q2) - center2);\nlet flakes2 = (1.0 - smoothstep(0.018 * flake_size, 0.055 * flake_size, d2)) * 0.85;\nlet shimmer = stars(p * 1.8, t * 0.3) * smoothstep(-0.2, 0.9, p.y) * 0.3;\nlet snow = clamp(flakes * 0.75 + flakes2 + shimmer, 0.0, 1.0);\nlet color = mix(sky_color, c4, snow);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
