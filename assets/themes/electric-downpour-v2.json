      "custom": {
        "expression": "let jitter = (hash(vec2<f32>(floor(p.y * 90.0), floor(t * 12.0))) - 0.5) * 0.035;\nlet px = p.x + jitter;\nlet u = clamp((px + 0.9) / 1.8, 0.0, 0.9999);\nlet k = floor(u * 5.0);\nlet fx = fract(u * 5.0);\nlet c_a = mix(c1, c2, step(1.0, k));\nlet c_b = mix(c_a, c3, step(2.0, k));\nlet c_c = mix(c_b, c4, step(3.0, k));\nlet bars = mix(c_c, c5, step(4.0, k));\nlet edge_d = min(fx, 1.0 - fx) * 0.36;\nlet outline = stroke(edge_d, 0.012);\nlet scan = 0.82 + 0.18 * sin(p.y * 376.99);\nlet rb = fract(p.y - t * 0.08);\nlet roll = mix(0.5, 1.0, smoothstep(0.0, 0.1, rb));\nlet snow = hash(floor(p * vec2<f32>(160.0, 110.0)) + vec2<f32>(floor(t * 24.0) * 7.0, 3.0));\nlet base_col = mix(bars, c4 * 0.3, outline * 0.85) * scan * roll;\nlet grain = base_col + vec3<f32>(snow * 0.12);\nlet sway = 0.03 * sin(t * 0.5);\nlet ant_base = vec2<f32>(0.0, 0.2);\nlet tip_l = vec2<f32>(-0.26 + sway, 0.46);\nlet tip_r = vec2<f32>(0.26 - sway, 0.46);\nlet ant_d = min(sd_segment(p, ant_base, tip_l), sd_segment(p, ant_base, tip_r));\nlet ant = max(stroke(ant_d, 0.016), fill(sd_circle(p - ant_base, 0.035)));\nlet color = mix(grain, c3, ant * 0.9);\nreturn mix(bg, color, strength);",
