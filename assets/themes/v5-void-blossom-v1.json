      "custom": {
        "expression": "let hz = -0.03;\nlet below = max(hz - p.y, 0.015);\nlet depth = 1.0 / below;\nlet px = p.x * depth;\nlet fog = exp(-below * 2.5);\nvar swell = 0.0;\nvar ridge = 0.0;\nfor (var i = 0; i < 4; i++) {\n    let k = f32(i);\n    let drift = noise(vec2<f32>(px * 0.3 + k * 5.0, depth * 0.4 + t * 0.05 * wave_speed));\n    let ph = px * (1.2 + k * 0.7) + drift * 4.0 * wave_height + depth * 0.25 * (1.0 + k * 0.4) - t * wave_speed * (0.9 + k * 0.5);\n    let wv = 0.5 + 0.5 * sin(ph);\n    swell += wv / (1.0 + k);\n    ridge = max(ridge, pow(wv, 6.0 + 4.0 * k));\n}\nlet swell_n = swell / 2.083;\nlet crest = smoothstep(0.3, 1.0, ridge);\nlet glint_x = p.x - 0.42 + (swell_n - 0.5) * 0.15 * (1.0 + depth * 0.2);\nlet glint = (1.0 - smoothstep(0.0, 0.1, abs(glint_x))) * (0.3 + 0.7 * fog) * (0.4 + 0.6 * crest);\nlet spark_cell = floor(vec2<f32>(px * 10.0, depth * 3.0 - t * wave_speed * 0.5));\nlet sparkle = step(0.985, hash(spark_cell)) * crest * fog;\nlet water = mix(c1 * 0.8, c2, swell_n) * (0.5 + 0.5 * fog) + c3 * crest * 0.7 + c4 * glint * 0.9 + c4 * sparkle * 1.2 + c5 * (1.0 - fog) * 0.4;\nlet stars_v = stars(p * 22.0, t);\nlet sky = mix(c3 * 0.3, c5 * 0.6, smoothstep(hz, 0.5, p.y));\nlet moon_d = sd_circle(p - vec2<f32>(0.42, 0.3), 0.05);\nlet moon = fill(moon_d) + halo(moon_d, 0.2) * 0.4;\nlet skyc = sky + c3 * stars_v * 0.8 + c4 * moon;\nlet foam = (1.0 - smoothstep(0.0, 0.02, abs(p.y - hz))) * (0.4 + 0.6 * swell_n) * c3;\nlet scene = mix(water + foam, skyc, smoothstep(hz - 0.004, hz + 0.004, p.y));\nreturn mix(bg, tonemap(scene * 1.1), strength);",
