        "expression": "let q = p + vec2<f32>(0.0, 0.12);\nlet swell = 0.11 * sin(q.x * 3.8 + t * 0.9) + 0.05 * sin(q.x * 8.0 - t * 1.3);\nlet horizon = -0.12 + swell;\nlet sky = mix(c1, c2, smoothstep(-0.1, 1.2, q.y));\nlet sunPos = q - vec2<f32>(0.35 + 0.07 * sin(t * 0.23), 0.49);\nlet radius = length(sunPos);\nlet angle = atan2(sunPos.y, sunPos.x);\nlet rays = pow(0.5 + 0.5 * sin(angle * 14.0 + t * 0.65), 4.0);\nlet halo = exp(-radius * 2.3) * (0.22 + 0.42 * rays);\nlet sunshine = mix(sky, c3, clamp(halo + 1.0 - smoothstep(0.24, 0.265, radius), 0.0, 1.0));\nlet depth = max(horizon - q.y, 0.0);\nlet ripple = sin(q.y * 23.0 + sin(q.x * 4.0 - t) * 1.9 + t * 2.3);\nlet water = mix(c5, c4, 0.44 + 0.34 * sin(q.x * 2.3 + q.y * 3.7 + t * 0.7));\nlet glints = smoothstep(0.76, 0.99, ripple) * exp(-depth * 0.65);\nlet reflection = exp(-pow((q.x - 0.35 + 0.1 * sin(q.y * 19.0 + t)) / (0.17 + depth * 0.25), 2.0));\nlet sea = mix(water, c3, clamp(glints * (0.19 + 0.7 * reflection), 0.0, 0.86));\nlet shore = 1.0 - smoothstep(0.015, 0.055, abs(q.y - horizon));\nlet scene = mix(sea, sunshine, smoothstep(horizon - 0.015, horizon + 0.015, q.y));\nlet color = mix(scene, c3, shore * 0.65);\nreturn mix(bg, color, strength);",
