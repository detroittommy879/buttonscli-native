      "custom": {
        "expression": "let below = 0.27 - p.y;\nlet depth = max(below, 0.08);\nlet travel = 24.0 * fract(t * round(floor_speed * 150.0) / 3600.0);\nlet grid = vec2<f32>(4.3 * p.x / depth, 2.2 / depth + travel);\nlet cell = floor(grid);\nlet tile = vec2<f32>(cell.x, 24.0 * fract(cell.y / 24.0));\nlet local = fract(grid) - vec2<f32>(0.5);\nlet group = floor((tile + vec2<f32>(1.0, 0.0)) / 3.0);\nlet seed = hash(tile);\nlet cue = hash(group + vec2<f32>(19.0, 4.0));\nlet beat = t * round(pulse_rate * 3600.0) / 3600.0;\nlet phase = fract(beat + cue + 0.14 * seed);\nlet hit = smoothstep(0.01, 0.09, phase) * (1.0 - smoothstep(0.10, 0.40, phase));\nlet echo = smoothstep(0.48, 0.53, phase) * (1.0 - smoothstep(0.55, 0.71, phase));\nlet cluster_gate = smoothstep(1.0 - lit_clusters - 0.06, 1.0 - lit_clusters + 0.06, cue);\nlet pulse = cluster_gate * (hit + 0.57 * echo * smoothstep(0.23, 0.77, seed));\n\nlet resolved = smoothstep(0.10, 0.25, below);\nlet aa = min(0.10, 0.008 + 0.0012 / (depth * depth));\nlet edge = sd_box(local, vec2<f32>(0.43, 0.42)) - 0.016;\nlet face = 1.0 - smoothstep(-aa, aa, edge);\nlet rim = (1.0 - smoothstep(0.008, 0.034 + aa, abs(edge + 0.025))) * face;\nlet sheen = 1.0 - smoothstep(0.0, 0.20, abs(local.y + 0.32 + 0.20 * local.x));\nlet checker = 0.5 + 0.5 * cos(3.141593 * (tile.x + tile.y));\nlet finish = mix(c1 * 0.72, c5 * 0.76, checker * 0.46 + seed * 0.34);\nlet enamel = mix(c5, c2, 0.54 + 0.46 * seed);\n\nlet horizon = exp(-abs(below) * 10.0) * exp(-1.6 * p.x * p.x);\nlet air = mix(c4, c1, 0.58 * horizon) + c2 * (0.085 * horizon);\nlet grout = mix(c4, c1 * 0.66, 0.42 + 0.38 * exp(-depth * 2.7));\nlet glaze = mix(finish, enamel, clamp(pulse * tile_glow, 0.0, 0.95));\nlet lacquer = glaze * (0.88 + 0.18 * sheen) + c3 * (rim * (0.044 + 0.24 * pulse * tile_glow));\nlet floor_rgb = mix(grout, lacquer, face);\nlet haze = mix(air, mix(c1 * 0.84, c2 * 0.63, 0.27), smoothstep(0.0, 0.20, below));\nlet scene = mix(haze, floor_rgb, resolved);\nlet vignette = 0.80 + 0.20 * exp(-1.1 * p.x * p.x);\nreturn mix(bg, clamp(scene * vignette, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
