      "custom": {
        "expression": "let moon_p = vec2<f32>(0.32, 0.24);\nlet md = sd_circle(p - moon_p, moon_size);\nlet moon = fill(md) * c4 * 1.1 + halo(md, 0.22) * c4 * 0.35 + halo(md, 0.05) * c3 * 0.3;\nlet warm = c4 * 0.5 * (1.0 - smoothstep(-0.08, 0.4, p.y));\nlet sky_base = mix(c5 * 0.55, c1 * 0.5, smoothstep(-0.08, 0.5, p.y));\nlet stars_l = stars(p * 26.0 * star_density, t) * smoothstep(-0.02, 0.1, p.y);\nlet sky = sky_base + warm + moon + c3 * stars_l;\nvar col = sky;\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let top = -0.08 - 0.13 * k;\n    let dd = max(top - p.y, 0.0) + 0.03;\n    let z = (0.1 + 0.08 * k) / dd;\n    let wx = p.x * z;\n    let n1 = noise(vec2<f32>(wx * 0.9 + t * 0.2, z * 0.6 - t * 0.4 + k * 3.0));\n    let n2 = noise(vec2<f32>(wx * 1.9 - t * 0.35, z * 1.4 + t * 0.7 + k * 5.0));\n    let h = n1 * 0.6 + n2 * 0.4 * wave_height;\n    let crest = smoothstep(0.55, 0.9, h);\n    let trough = 1.0 - smoothstep(0.25, 0.55, h);\n    let base = mix(c1, c2, 0.35 + 0.3 * k);\n    let body = mix(base * 0.5, base * 1.3, crest) * (1.0 - 0.3 * trough);\n    let refl_x = p.x - moon_p.x + (n2 - 0.5) * 0.15 * wave_height;\n    let streak = exp(-abs(refl_x) * 7.0) * crest;\n    let layer = body + c3 * crest * 0.25 + c4 * streak * 0.9;\n    let mask = 1.0 - smoothstep(top - 0.004, top + 0.004, p.y);\n    col = mix(col, layer, mask);\n}\nreturn mix(bg, tonemap(col * 1.15), strength);",
        "name": "Night swim",
