        "expression": "let scale = 1.2 + amount * 0.32;\nlet clock = t * (0.5 + gravity * 0.85);\nlet pos = p * vec2<f32>(scale) + vec2<f32>(0.0, clock * 0.16);\nlet row = floor(pos.y);\nlet seed = hash(vec2<f32>(row, 7.3));\nlet direction = select(-1.0, 1.0, fract(row * 0.5) > 0.25);\nlet dash = clock * (0.6 + seed) + 1.3 * smoothstep(-0.7, 0.7, sin(clock * 1.7 + seed * 12.0));\nlet x = pos.x + direction * dash + seed * 8.0;\nlet y = fract(pos.y) - 0.5;\nlet pair = floor(x * 0.5);\nlet u = fract(x * 0.5) * 2.0;\nlet slope = select(-0.76, 0.76, fract(row * 0.5) > 0.25);\nlet split = 1.0 + slope * y;\nlet side = step(split, u);\nlet center = mix(split * 0.5, 1.0 + split * 0.5, side);\nlet halfwidth = mix(split * 0.5, 1.0 - split * 0.5, side);\nlet inset = 0.11 - shape_size * 0.13;\nlet edge = min((halfwidth - abs(u - center)) * 0.93, 0.5 - abs(y)) - inset;\nlet body = smoothstep(-0.018, 0.018, edge);\nlet bevel = 1.0 - smoothstep(0.018, 0.085, edge);\nlet id = hash(vec2<f32>(pair * 2.0 + side, row));\nlet paint = mix(c1, c2, 0.15 + 0.75 * id);\nlet shading = 0.72 + 0.28 * (y + 0.5) + 0.12 * sin(id * 18.0 + clock * 2.0);\nlet face = paint * vec3<f32>(shading);\nlet rim = mix(c2, c3, 0.3) * vec3<f32>(bevel * 0.35);\nlet halo = exp(-max(-edge, 0.0) * 18.0) * (1.0 - body) * glow;\nlet ground = c1 * vec3<f32>(0.23) + c2 * vec3<f32>(0.07);\nlet color = mix(ground, face + rim, body) + c1 * vec3<f32>(halo * 0.38);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
