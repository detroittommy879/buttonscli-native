        "expression": "let density = 1.2 + amount * 0.28;\nlet warp = vec2<f32>(sin(p.y * 3.0 + t * 0.7), cos(p.x * 2.6 - t * 0.6)) * vec2<f32>(0.16);\nlet pos = (p + warp) * vec2<f32>(density);\nlet column = floor(pos.x);\nlet seed = hash(vec2<f32>(column, 7.3));\nlet fall = t * gravity * (0.4 + seed * 0.55);\nlet grid = pos + vec2<f32>(0.0, fall + seed * 8.0);\nlet cell = floor(grid);\nlet id = hash(cell);\nlet q = fract(grid) - vec2<f32>(0.5);\nlet angle = t * (seed - 0.5) * 3.0 + id * 6.283;\nlet r = vec2<f32>(q.x * cos(angle) - q.y * sin(angle), q.x * sin(angle) + q.y * cos(angle));\nlet size = shape_size * (0.55 + id * 0.25);\nlet circle = length(r) - size;\nlet square = max(abs(r.x), abs(r.y)) - size * 0.85;\nlet diamond = (abs(r.x) + abs(r.y)) * 0.7071 - size * 0.8;\nlet triangle = max(abs(r.x) * 0.866 + r.y * 0.5, -r.y) - size * 0.55;\nlet d = select(select(circle, square, id > 0.25), select(diamond, triangle, id > 0.75), id > 0.5);\nlet fill = 1.0 - smoothstep(-0.012, 0.015, d);\nlet outline = exp(-abs(d) * 70.0);\nlet hollow = step(0.48, fract(id * 7.9));\nlet graphic = mix(fill, outline, hollow);\nlet halo = exp(-max(d, 0.0) * 15.0) * (1.0 - fill);\nlet stripe = smoothstep(0.4, 0.6, sin((r.x + r.y) * 65.0 + t * 2.0));\nlet hatch = fill * stripe * hollow * 0.32;\nlet trail = exp(-abs(q.x) * 60.0) * smoothstep(0.0, 0.48, q.y) * 0.17;\nlet source = mix(mix(c1, c2, seed), c3, id);\nlet activity = smoothstep(0.0, 0.6, amount);\nlet paper = 0.14 + 0.06 * noise(p * vec2<f32>(3.0) + vec2<f32>(t * 0.08));\nlet light = paper + activity * (0.8 * graphic + hatch + glow * (halo * 0.19 + trail));\nlet color = clamp(source * vec3<f32>(light), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
