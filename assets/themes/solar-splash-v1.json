      "custom": {
        "expression": "let drift = p / vec2<f32>(molecule_size) + vec2<f32>(0.06 * sin(t * 0.21), -t * float_speed);\nlet stagger = 0.25 * cos(floor(drift.y) * 3.141593);\nlet grid = drift + vec2<f32>(stagger, 0.0);\nlet cell = floor(grid);\nlet seed = hash(cell);\nlet phase = seed * 6.283185;\nlet wobble = vec2<f32>(sin(t * 0.43 + phase), cos(t * 0.37 + phase)) * vec2<f32>(0.075);\nlet local = (fract(grid) - vec2<f32>(0.5) - wobble) * vec2<f32>(1.8);\nlet angle = phase + t * (seed - 0.5) * 0.18 + 0.12 * sin(t * 0.31 + phase);\nlet rotated = vec2<f32>(local.x * cos(angle) - local.y * sin(angle), local.x * sin(angle) + local.y * cos(angle));\nlet elastic = stretch * smoothstep(0.38, 0.85, seed) * sin(t * 0.72 + phase);\nlet v = rotated / vec2<f32>(1.0 + 0.30 * elastic, 1.0 - 0.22 * elastic);\nlet a = abs(v);\nlet hex = max(a.y, a.x * 0.866025 + a.y * 0.5);\nlet radius = 0.46 + 0.035 * sin(phase);\nlet outer_distance = abs(hex - radius);\nlet theta = atan2(v.y, v.x);\nlet alternating = smoothstep(0.18, 0.38, cos(theta * 3.0));\nlet inner_distance = abs(hex - radius * 0.73);\nlet outer = 1.0 - smoothstep(0.014, 0.031, outer_distance);\nlet inner = (1.0 - smoothstep(0.012, 0.027, inner_distance)) * alternating;\nlet bonds = max(outer, inner);\nlet halo = exp(-outer_distance * 24.0) + 0.45 * exp(-inner_distance * 30.0) * alternating;\nlet tint = mix(mix(c1, c2, smoothstep(0.0, 0.65, seed)), c3, smoothstep(0.57, 0.96, seed));\nlet mist = cloud(p * vec2<f32>(0.8) + vec2<f32>(t * 0.025, -t * 0.018));\nlet field = c4 * vec3<f32>(0.28 + 0.35 * mist) + c2 * vec3<f32>(0.035 * mist);\nlet interior = (1.0 - smoothstep(radius - 0.03, radius + 0.03, hex)) * 0.055;\nlet color = field + tint * vec3<f32>(interior + bonds * 0.88 + halo * glow * 0.32);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
