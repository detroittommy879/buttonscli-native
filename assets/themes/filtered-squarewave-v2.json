      "custom": {
        "expression": "let x = p.x * (1.4 + amount * 0.48) - t * (0.22 + gravity * 0.16);\nlet phase = x * 3.141593;\nlet cutoff = 2.2 + 1.2 * sin(t * 0.35);\nlet h3 = exp(-3.0 / cutoff);\nlet h5 = exp(-5.0 / cutoff);\nlet h7 = exp(-7.0 / cutoff);\nlet filtered = (sin(phase) + sin(phase * 3.0) * (h3 / 3.0) + sin(phase * 5.0) * (h5 / 5.0) + sin(phase * 7.0) * (h7 / 7.0)) * 0.57;\nlet square = select(-0.57, 0.57, sin(phase) >= 0.0);\nlet edge = abs(fract(x * 0.5) - 0.5);\nlet vertical = min(edge, 0.5 - edge) * 2.0 / (1.4 + amount * 0.48);\nlet rawDistance = min(abs(p.y - square), max(vertical, abs(p.y) - 0.57));\nlet d = abs(p.y - filtered);\nlet width = 0.006 + shape_size * 0.035;\nlet line = 1.0 - smoothstep(width, width + 0.012, d);\nlet rawLine = 1.0 - smoothstep(0.004, 0.012, rawDistance);\nlet halo = exp(-d * 11.0) * glow * 0.3;\nlet water = cloud(p * vec2<f32>(1.4, 2.4) + vec2<f32>(t * 0.08, -t * 0.04));\nlet base = mix(c3, c1, water) * vec3<f32>(0.16, 0.23, 0.30);\nlet gridCoord = abs(fract(p * 4.0 + vec2<f32>(0.5)) - vec2<f32>(0.5));\nlet grid = 1.0 - smoothstep(0.008, 0.022, min(gridCoord.x, gridCoord.y));\nlet traceColor = mix(c1, c2, 0.5 + 0.5 * sin(phase * 0.3 + t * 0.4));\nlet field = base + c3 * vec3<f32>(grid * 0.065) + c4 * vec3<f32>(rawLine * 0.3) + traceColor * vec3<f32>(halo);\nlet color = mix(field, traceColor, line);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
        "name": "Filtered Squarewave",
