      "custom": {
        "expression": "let sky = mix(c4 + c1 * 0.5, c2 * 0.45 + c1 * 0.2, smoothstep(-0.5, 0.5, p.y));\nlet g1 = vec2<f32>(p.x * 8.0, p.y * 6.0 + t * 0.25 * fall_speed);\nlet cell1 = floor(g1);\nlet s1 = hash(cell1);\nlet h1 = hash2(cell1);\nlet o1 = vec2<f32>((h1.x - 0.5) * 0.6 + 0.08 * sin(t * 0.8 + s1 * 6.28), (h1.y - 0.5) * 0.6);\nlet d1 = sd_circle(fract(g1) - 0.5 - o1, flake_size * (0.035 + 0.03 * s1));\nlet on1 = step(0.25, s1);\nlet flake1 = fill(d1) * on1;\nlet glow1 = halo(d1, 0.05) * on1;\nlet g2 = vec2<f32>(p.x * 14.0, p.y * 10.0 + t * 0.125 * fall_speed);\nlet cell2 = floor(g2);\nlet s2 = hash(cell2 + vec2<f32>(17.0, 5.0));\nlet h2 = hash2(cell2 + vec2<f32>(17.0, 5.0));\nlet o2 = vec2<f32>((h2.x - 0.5) * 0.6 + 0.05 * sin(t * 0.5 + s2 * 6.28), (h2.y - 0.5) * 0.6);\nlet d2 = sd_circle(fract(g2) - 0.5 - o2, flake_size * (0.025 + 0.02 * s2));\nlet on2 = step(0.3, s2);\nlet flake2 = fill(d2) * on2 * 0.5;\nlet glow2 = halo(d2, 0.04) * on2;\nlet light = c5 * (flake1 + flake2) + c3 * (glow1 * 0.5 + glow2 * 0.2);\nlet color = tonemap(sky + light);\nreturn mix(bg, color, strength);",
        "name": "Drifting Snowfall",
