        "expression": "let intensity = clamp(amount * 0.1, 0.0, 1.0);\nlet radius = length(p);\nlet angle = atan2(p.y, p.x);\nlet fold = abs(fract(angle * 0.95493 + t * 0.025) - 0.5);\nlet tunnel = vec2<f32>(fold * 7.0, log2(radius + 0.2) * 2.1 - t * 0.22);\nlet drift = vec2<f32>(sin(tunnel.y * 2.0 + t * 0.4), cos(tunnel.x * 3.0 - t * 0.3)) * vec2<f32>(0.16 * intensity);\nlet uv = tunnel + drift;\nlet cell = floor(uv);\nlet q = fract(uv) - vec2<f32>(0.5);\nlet seed = hash(cell);\nlet wobble = 1.0 + 0.09 * sin(t * 1.4 + seed * 6.283);\nlet bodyDistance = length(q * vec2<f32>(1.0, 1.12) * vec2<f32>(wobble));\nlet body = 1.0 - smoothstep(0.31, 0.34, bodyDistance);\nlet rim = exp(-abs(bodyDistance - 0.325) * 65.0);\nlet eyeA = 1.0 - smoothstep(0.026, 0.044, length(q - vec2<f32>(-0.105, 0.065)));\nlet eyeB = 1.0 - smoothstep(0.026, 0.044, length(q - vec2<f32>(0.105, 0.065)));\nlet smileRadius = length((q - vec2<f32>(0.0, 0.005)) * vec2<f32>(1.0, 1.2));\nlet smile = exp(-abs(smileRadius - 0.17) * 95.0) * (1.0 - smoothstep(-0.035, -0.015, q.y));\nlet face = clamp(eyeA + eyeB + smile, 0.0, 1.0);\nlet hue = seed * 0.45 + radius * 0.18 - t * 0.035;\nlet candy = mix(palette(hue), mix(c1, c2, seed), 0.3);\nlet shimmer = 0.5 + 0.5 * sin(radius * 19.0 - t * 0.8 + fold * 12.0);\nlet base = vec3<f32>(0.012, 0.008, 0.026) + c3 * vec3<f32>(0.025 + shimmer * 0.018);\nlet glow = candy * vec3<f32>((body * 0.17 + rim * 0.11) * (0.35 + intensity * 0.65));\nlet ink = 1.0 - face * 0.86;\nlet vignette = 1.0 / (1.0 + radius * radius * 0.16);\nreturn clamp((base + glow * vec3<f32>(ink)) * vec3<f32>(vignette), vec3<f32>(0.0), vec3<f32>(0.45));",
