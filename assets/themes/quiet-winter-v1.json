      "custom": {
        "expression": "let wind = sin(t * 0.35 + p.y * 1.2) * 0.09;\nlet sky = cloud(p * vec2<f32>(1.4, 2.8) + vec2<f32>(t * 0.035, 0.0));\nlet haze = mix(c1 * vec3<f32>(0.42), c2 * vec3<f32>(0.36), smoothstep(0.15, 0.85, sky));\nlet spacing = 1.15 - amount * 0.065;\nlet drift = vec2<f32>(p.x + wind - t * 0.045, p.y + t * gravity * 0.22);\nlet grid = drift / vec2<f32>(spacing);\nlet cell = floor(grid);\nlet seed = hash(cell);\nlet local = (fract(grid) - vec2<f32>(0.5)) * vec2<f32>(spacing);\nlet angle = seed * 6.2831853 + sin(t * 0.45 + seed * 12.0) * 0.25;\nlet q = vec2<f32>(local.x * cos(angle) - local.y * sin(angle), local.x * sin(angle) + local.y * cos(angle)) / vec2<f32>(shape_size * (0.34 + seed * 0.22));\nlet radius = length(q);\nlet axis = min(abs(q.x), min(abs(dot(q, vec2<f32>(0.5, 0.8660254))), abs(dot(q, vec2<f32>(-0.5, 0.8660254)))));\nlet arms = (1.0 - smoothstep(0.035, 0.075, axis)) * (1.0 - smoothstep(0.76, 0.96, radius));\nlet ring = exp(-abs(radius - 0.49) * 45.0) * (1.0 - smoothstep(0.12, 0.24, axis));\nlet core = 1.0 - smoothstep(0.07, 0.17, radius);\nlet visibility = smoothstep(0.0, 1.0, amount);\nlet flake = clamp(max(arms, core) + ring * 0.5, 0.0, 1.0) * visibility;\nlet flakeColor = mix(c2, c3, seed) * vec3<f32>(0.74 + 0.18 * seed);\nlet farGrid = (p + vec2<f32>(t * 0.018, t * gravity * 0.12)) * vec2<f32>(6.0);\nlet farCell = floor(farGrid);\nlet farSeed = hash(farCell + vec2<f32>(17.0, 3.0));\nlet farLocal = fract(farGrid) - vec2<f32>(0.2 + farSeed * 0.6);\nlet dust = (1.0 - smoothstep(0.025, 0.09, length(farLocal))) * step(0.66, farSeed) * visibility;\nlet halo = exp(-radius * radius * 3.0) * visibility;\nlet color = mix(haze, flakeColor, flake) + c2 * vec3<f32>(dust * 0.28 + glow * halo * 0.12);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
