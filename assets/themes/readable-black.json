{
  "version": 1,
  "metadata": {
    "id": "readable-black",
    "name": "Readable Black",
    "nativeThemeVersion": 1,
    "description": "Plain black, no gradient or shader, every ANSI color at least 4.5:1 against the background. Used by Look → Basic."
  },
  "theme": {
    "mode": "dark",
    "terminal": {
      "background": "#000000",
      "foreground": "#e8e8e8",
      "cursor": "#ffffff",
      "cursorAccent": "#000000",
      "selectionBackground": "#3a4a66",
      "fontFamily": "Recursive Mono Csl St Bundled",
      "fontSize": 15,
      "fontWeight": 400,
      "useGradient": false,
      "gradientAnimation": false,
      "ansiColors": {
        "black": "#80868f",
        "red": "#ff6b6b",
        "green": "#5fd068",
        "yellow": "#e8d44d",
        "blue": "#6cb6ff",
        "magenta": "#e08cf0",
        "cyan": "#4fd6e0",
        "white": "#d8d8d8",
        "brightBlack": "#a0a6af",
        "brightRed": "#ff9a9a",
        "brightGreen": "#8ee89a",
        "brightYellow": "#fff07a",
        "brightBlue": "#9fd0ff",
        "brightMagenta": "#f0b4ff",
        "brightCyan": "#8eeef4",
        "brightWhite": "#ffffff"
      }
    },
    "app": {
      "shell": {
        "background": "#000000",
        "backgroundSecondary": "#0c0c0c",
        "border": "#3a3a3a",
        "textMain": "#e8e8e8",
        "textDim": "#b8b8b8",
        "accent": "#6cb6ff",
        "accentHover": "#9fd0ff",
        "statusBar": {
          "background": "#000000",
          "foreground": "#d8d8d8"
        }
      }
    }
  },
  "effects": {
    "masterDisabled": true,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "shaderBackground": null
  }
}
