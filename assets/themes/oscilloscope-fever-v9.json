      "custom": {
        "expression": "let sky = mix(c4, c2 * 0.6, smoothstep(-0.5, 0.5, p.y));\nlet sun_d = sd_circle(p - vec2<f32>(0.3, 0.2), 0.12);\nvar scene = mix(sky, c3, fill(sun_d));\nscene = mix(scene, c4, stroke(sun_d, 0.008));\nfor (var i = 0; i < 4; i++) {\n    let k = f32(i);\n    let base = 0.1 - 0.15 * k;\n    let freq = 2.5 + 1.2 * k;\n    let spd = wave_speed * (0.5 + 0.3 * k);\n    let edge = base + wave_height * 0.05 * sin(p.x * freq + t * spd + k * 2.1) + wave_height * 0.02 * sin(p.x * freq * 2.7 - t * spd * 1.3);\n    let dd = p.y - edge;\n    let inside_w = smoothstep(0.004, -0.004, dd);\n    let rim = smoothstep(0.012, 0.0, abs(dd));\n    let body = mix(c2, c1, 0.3 + 0.2 * k);\n    scene = mix(scene, body, inside_w);\n    scene = mix(scene, c4, rim * 0.9);\n}\nvar air = scene;\nfor (var j = 0; j < 3; j++) {\n    let m = f32(j);\n    let bx = fract(t * 0.03 * bird_speed + m * 0.37) * 2.4 - 1.2;\n    let by = 0.35 + 0.08 * m - 0.03 * sin(t * 0.7 * bird_speed + m);\n    let wing = 0.012 * sin(t * 6.0 * bird_speed + m * 1.7);\n    let q = p - vec2<f32>(bx, by);\n    let bd = min(sd_segment(q, vec2<f32>(-0.035, wing), vec2<f32>(0.0, 0.0)), sd_segment(q, vec2<f32>(0.0, 0.0), vec2<f32>(0.035, wing))) - 0.003;\n    air = mix(air, c5, smoothstep(0.003, -0.003, bd));\n}\nlet fr = fract(t * 0.05);\nlet fx = -0.7 + 1.4 * fr;\nlet fy = -0.05 + 0.25 * sin(fr * 3.14159);\nlet fq = p - vec2<f32>(fx, fy);\nlet fish_body = sd_circle(vec2<f32>(fq.x * 0.5, fq.y), 0.04);\nlet fish_tail = sd_segment(fq, vec2<f32>(-0.05, 0.0), vec2<f32>(-0.09, 0.02)) - 0.012;\nlet fish = min(fish_body, fish_tail);\nvar col = mix(air, c5, fill(fish));\ncol = mix(col, c4, stroke(fish, 0.006));\nreturn mix(bg, col, strength);",
