      "custom": {
        "expression": "let hz = -0.03;\nlet below = max(hz - p.y, 0.015);\nlet depth = 1.0 / below;\nlet px = p.x * depth;\nlet fog = exp(-below * 2.5);\nvar swell = 0.0;\nvar crest_acc = 0.0;\nfor (var i = 0; i < 4; i++) {\n    let k = f32(i);\n    let spd = wave_speed * (0.4 + 0.2 * k);\n    let n = noise(vec2<f32>(px * (0.5 + 0.4 * k) - t * 0.2 * spd, depth * (1.2 + 0.7 * k) + t * 0.5 * spd));\n    swell += n * (0.5 - 0.08 * k);\n    crest_acc += (1.0 - abs(2.0 * n - 1.0)) * (0.3 + 0.1 * k);\n}\nlet crest = smoothstep(0.75 - 0.1 * wave_height, 0.95, crest_acc / 1.8);\nlet refl_x = p.x - 0.42 + (swell - 0.76) * 0.2 * wave_height;\nlet road = smoothstep(0.12, 0.0, abs(refl_x)) * (0.4 + 0.6 * fog);\nlet stripes = smoothstep(0.35, 0.65, 0.5 + 0.5 * sin(depth * 5.0 - t * 2.0 * wave_speed + swell * 3.0));\nlet glint = road * stripes;\nlet bp = vec2<f32>(px * 2.0, depth * 3.0 - t * 0.8 * wave_speed);\nlet bc = floor(bp);\nlet hb = hash(bc);\nlet bub = stroke(sd_circle(fract(bp) - 0.5, 0.05 + 0.1 * hb), 0.02) * step(0.92, hb);\nlet water = mix(c1 * 0.7, c2, clamp(swell, 0.0, 1.0)) * (0.5 + 0.5 * fog) + c3 * crest * (0.25 + 0.5 * fog) + c4 * glint * 0.8 + c3 * bub * fog * 0.6;\nlet stars_v = stars(p * 22.0, t);\nlet sky = mix(c5 * 0.45, c1 * 0.3, smoothstep(hz, 0.5, p.y));\nlet moon_d = sd_circle(p - vec2<f32>(0.42, 0.3), 0.05);\nlet moon = fill(moon_d) + halo(moon_d, 0.2) * 0.4;\nlet skyc = sky + c3 * stars_v * 0.8 + c4 * moon;\nlet foam = smoothstep(0.02, 0.0, abs(p.y - hz)) * (0.4 + 0.6 * crest_acc / 1.8) * c3;\nlet scene = mix(water + foam, skyc, smoothstep(hz - 0.004, hz + 0.004, p.y));\nreturn mix(bg, tonemap(scene), strength);",
