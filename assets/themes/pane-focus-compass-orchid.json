{
  "version": 1,
  "metadata": {
    "id": "pane-focus-compass-orchid",
    "name": "Opposite Shores / Orchid",
    "nativeThemeVersion": 1,
    "description": "Warm and cool colors alternate around a quiet center. Orchid pane; stable hue, dark background, gentle contrast."
  },
  "theme": {
    "mode": "dark",
    "app": {
      "shell": {
