  "effects": {
    "masterDisabled": false,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "simpleNoiseEnabled": false,
    "shaderBackground": {
      "version": 1,
      "preset": "aurora",
      "strength": 0.9,
      "speed": 0.0,
      "scale": 1.0,
      "animated": false,
      "colors": [
        "#030408",
        "#120d11",
        "#362432",
        "#2c1e29",
        "#432c3d"
      ],
      "theme_colors": false,
      "custom": {
        "name": "Pane Focus / Corner Lantern",
        "expression": "let center = vec2<f32>(0.75, -0.62);\nlet light = exp(-length(p - center) * spread);\nlet floorlight = smoothstep(-0.8, 0.9, -p.y) * 0.25;\nlet base = mix(c1, c2, 0.4 + floorlight);\nlet glow = mix(c3, c4, clamp(p.x * 0.2 + 0.5, 0.0, 1.0));\nreturn mix(bg, mix(base, glow, light * depth) + c5 * light * 0.06, strength);",
        "y_up": true,
        "variables": [
          {
            "name": "spread",
            "min": 0.3,
            "max": 3.0,
            "value": 0.85
          },
          {
            "name": "depth",
            "min": 0.2,
            "max": 1.0,
            "value": 0.85
          }
        ]
      }
    }
  }
