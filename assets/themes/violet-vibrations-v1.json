      "custom": {
        "expression": "let fp = p * smoke_scale;\nlet warp = vec2<f32>(fbm(fp + vec2<f32>(t * 0.03, 0.0)), fbm(fp + vec2<f32>(4.1, 1.7) - vec2<f32>(0.0, t * 0.025)));\nlet smoke = fbm(fp + 1.8 * warp + vec2<f32>(0.0, t * 0.04));\nlet drift = clamp(0.5 + 0.5 * (p.y * 1.4 + 0.6 * warp.x - 0.3), 0.0, 1.0);\nlet hue = mix(c1, c2, drift);\nlet ink = mix(c4 * 0.8, hue, smoothstep(0.35, 0.75, smoke));\nlet ph1 = fract(t * 0.06 * drop_speed);\nlet ph2 = fract(t * 0.05 * drop_speed + 0.37);\nlet ph3 = fract(t * 0.07 * drop_speed + 0.71);\nlet r1 = stroke(sd_circle(p - vec2<f32>(-0.32, 0.1), ph1 * 0.8), 0.004 + 0.01 * (1.0 - ph1)) * (1.0 - ph1);\nlet r2 = stroke(sd_circle(p - vec2<f32>(0.4, -0.12), ph2 * 0.9), 0.004 + 0.01 * (1.0 - ph2)) * (1.0 - ph2);\nlet r3 = stroke(sd_circle(p - vec2<f32>(0.05, 0.2), ph3 * 0.7), 0.004 + 0.01 * (1.0 - ph3)) * (1.0 - ph3);\nlet rings = (r1 + r2 + r3) * mix(c5, c2, 0.4);\nlet color = tonemap(ink * 1.1 + rings * 1.2);\nreturn mix(bg, color, strength);",
        "name": "Vaporwave Ink Bloom",
