      "custom": {
        "expression": "let intensity = clamp(amount * 0.1, 0.0, 1.0);\nlet radius = length(p);\nlet angle = atan2(p.y, p.x);\nlet fold = abs(fract(angle * 0.95493 + t * 0.035) - 0.5);\nlet tunnel = vec2<f32>(fold * 8.0, -3.4 / (radius + 0.65) - t * 0.3);\nlet drift = vec2<f32>(sin(tunnel.y * 2.0 + t * 0.45), cos(tunnel.x * 3.0 - t * 0.35)) * vec2<f32>(0.19 * intensity);\nlet uv = tunnel + drift;\nlet cell = floor(uv);\nlet q = fract(uv) - vec2<f32>(0.5);\nlet seed = hash(cell);\nlet wobble = 1.0 + 0.065 * sin(t * 1.6 + seed * 6.283);\nlet d = length(q * vec2<f32>(1.0, 1.12) * vec2<f32>(wobble));\nlet body = 1.0 - smoothstep(0.305, 0.33, d);\nlet rim = exp(-abs(d - 0.325) * 75.0);\nlet halo = exp(-abs(d - 0.335) * 15.0);\nlet eyeA = 1.0 - smoothstep(0.026, 0.045, length(q - vec2<f32>(-0.105, 0.065)));\nlet eyeB = 1.0 - smoothstep(0.026, 0.045, length(q - vec2<f32>(0.105, 0.065)));\nlet smileRadius = length((q - vec2<f32>(0.0, 0.005)) * vec2<f32>(1.0, 1.2));\nlet smile = exp(-abs(smileRadius - 0.17) * 90.0) * (1.0 - smoothstep(-0.035, -0.015, q.y));\nlet face = clamp(eyeA + eyeB + smile, 0.0, 1.0);\nlet hue = seed * 0.65 + radius * 0.23 + fold * 0.4 - t * 0.045;\nlet candy = mix(hsv(fract(hue), 0.92, 1.0), mix(c1, c2, seed), 0.18);\nlet neon = hsv(fract(hue + 0.36), 0.86, 1.0);\nlet wave = 0.5 + 0.5 * sin(radius * 17.0 - t * 1.0 + fold * 18.0);\nlet ribbons = pow(wave, 8.0) * (1.0 - body);\nlet base = vec3<f32>(0.009, 0.005, 0.022) + c3 * vec3<f32>(0.025);\nlet fill = candy * vec3<f32>(body * (0.22 + intensity * 0.14));\nlet glow = neon * vec3<f32>(rim * 0.21 + halo * 0.055 + ribbons * 0.055);\nlet ink = 1.0 - face * 0.94;\nlet centerFade = smoothstep(0.0, 0.3, radius);\nlet vignette = 1.0 / (1.0 + radius * radius * 0.13);\nreturn clamp((base + (fill + glow) * vec3<f32>(ink * centerFade)) * vec3<f32>(vignette), vec3<f32>(0.0), vec3<f32>(0.55));",
