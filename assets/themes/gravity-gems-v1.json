      "custom": {
        "expression": "let breeze = wind * (0.32 * t + 0.22 * sin(t * 0.8 + p.y * 1.5));\nlet q = vec2<f32>(p.x - breeze, p.y + t * fall_speed * 0.65) * density;\nlet id = floor(q);\nlet seed = hash(id);\nlet local = fract(q) - vec2<f32>(0.5) - (vec2<f32>(seed, hash(id + vec2<f32>(4.3, 8.1))) - vec2<f32>(0.5)) * 0.28;\nlet angle = seed * 6.283 + t * (0.45 + seed * 0.7) + wind * sin(t + seed * 8.0);\nlet a = vec2<f32>(local.x * cos(angle) - local.y * sin(angle), local.x * sin(angle) + local.y * cos(angle)) / (leaf_size * 0.38);\nlet shape = abs(a.x) / 0.65 + a.y * a.y;\nlet leaf = 1.0 - smoothstep(0.9, 1.04, shape);\nlet vein = (1.0 - smoothstep(0.025, 0.065, abs(a.x))) * (1.0 - smoothstep(0.78, 1.0, abs(a.y)));\nlet branches = (1.0 - smoothstep(0.025, 0.065, abs(fract(a.y * 3.2 - abs(a.x) * 2.0) - 0.5))) * 0.22;\nlet warm = mix(c1, c2, smoothstep(0.15, 0.85, seed));\nlet face = mix(warm, c3, 0.24 * smoothstep(-0.5, 0.5, a.x));\nlet front = mix(face, c5, clamp(vein * 0.65 + branches, 0.0, 0.75));\n\nlet r = vec2<f32>(p.x - breeze * 0.42 + 3.7, p.y + t * fall_speed * 0.28) * density * 1.5;\nlet rid = floor(r);\nlet rs = hash(rid + vec2<f32>(17.2, 9.1));\nlet rl = fract(r) - vec2<f32>(0.5);\nlet ra = rs * 6.283 - t * 0.38;\nlet b = vec2<f32>(rl.x * cos(ra) - rl.y * sin(ra), rl.x * sin(ra) + rl.y * cos(ra)) / (leaf_size * 0.29);\nlet distant = 1.0 - smoothstep(0.88, 1.08, abs(b.x) / 0.6 + b.y * b.y);\nlet haze = cloud(p * 0.65 + vec2<f32>(-t * 0.035, t * 0.025));\nlet base = mix(c4, c3, haze * 0.4) * vec3<f32>(0.62);\nlet back = mix(base, mix(c3, c2, rs) * vec3<f32>(0.75), distant * 0.85);\nlet color = mix(back, front, leaf);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
