      "custom": {
        "expression": "let rowid = floor(p.y * 90.0);\nlet rowhash = hash(vec2<f32>(rowid, floor(t * 8.0)));\nlet shift = (rowhash - 0.5) * 0.08 * step(0.7, rowhash);\nlet sigA = noise(vec2<f32>((p.x + shift) * 6.0 + t * 0.4, p.y * 3.0));\nlet sigB = noise(vec2<f32>(p.x * 4.0 - t * 0.25, p.y * 2.0 + 7.0));\nlet grain = hash(vec2<f32>(floor(p.x * 260.0), floor(p.y * 140.0) + floor(t * 24.0)));\nlet bar = 0.85 + 0.15 * smoothstep(0.0, 0.15, fract(p.y * 0.7 - t * 0.05));\nlet plane_x = fract(t * plane_speed) * 2.4 - 1.2;\nlet plane_y = 0.12 + 0.06 * sin(t * 0.37);\nlet dx = p.x - plane_x;\nlet blip = halo(sd_circle(p - vec2<f32>(plane_x, plane_y), 0.015), 0.04);\nlet ghost = halo(sd_circle(p - vec2<f32>(plane_x - 0.18, plane_y - 0.03), 0.012), 0.03) * 0.5;\nlet block = mix(0.15, 1.0, smoothstep(0.0, 0.3, abs(dx)));\nlet a = smoothstep(0.42, 0.72, sigA + grain * 0.12);\nlet b = smoothstep(0.42, 0.72, sigB + grain * 0.12) * block;\nlet collide = a * b;\nlet sc = 0.7 + 0.3 * smoothstep(0.0, 0.5, fract(p.y * 120.0));\nlet color = c4 * 0.5 + c1 * a * 0.7 + c3 * b * 0.6 + c2 * collide * 1.6 + c5 * grain * grain * 0.5 + c5 * blip * 0.9 + c1 * ghost * 0.5;\nlet result = tonemap(color * sc * bar);\nreturn mix(bg, result, strength);",
        "name": "Dead Channel Crossfade",
