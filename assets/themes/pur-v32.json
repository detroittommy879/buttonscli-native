      "custom": {
        "expression": "let speed = t * 0.12;\nlet uv = p * vec2<f32>(3.0, 3.0) + vec2<f32>(0.0, speed);\nlet cell = floor(uv);\nlet seed = hash(cell);\nlet local = fract(uv);\nlet q = floor(local * vec2<f32>(13.0, 11.0)) - vec2<f32>(6.0, 5.0);\nlet x = abs(q.x);\nlet y = q.y;\nlet body = select(0.0, 1.0, x <= 4.0 && y >= -1.0 && y <= 1.0);\nlet crown = select(0.0, 1.0, x <= 3.0 && y == -2.0);\nlet antenna = select(0.0, 1.0, x == 3.0 && y == -3.0);\nlet arms = select(0.0, 1.0, x == 5.0 && y >= 0.0 && y <= 2.0);\nlet dance = floor(0.5 + 0.5 * sin(t * 1.8 + seed * 6.28318));\nlet feet = select(0.0, 1.0, abs(x - (2.0 + dance)) < 0.5 && y == 2.0);\nlet eyes = select(0.0, 1.0, x == 2.0 && y == -1.0);\nlet alien = clamp(body + crown + antenna + arms + feet - eyes, 0.0, 1.0);\nlet chevron = select(0.0, 1.0, abs(q.x + 2.0 - (2.0 - abs(y))) < 0.5 && abs(y) <= 2.0);\nlet cursor = select(0.0, 1.0, q.x >= 1.0 && q.x <= 4.0 && y == 2.0) * smoothstep(-0.3, 0.3, sin(t * 2.2 + seed * 5.0));\nlet glyph = mix(chevron + cursor, alien, step(0.42, seed));\nlet pixel = smoothstep(0.05, 0.16, fract(local.x * 13.0)) * smoothstep(0.05, 0.16, fract(local.y * 11.0));\nlet tint = mix(mix(c1, c2, seed), palette(seed * 0.35 + t * 0.015 + 0.35), 0.38);\nlet wake = 0.7 + 0.3 * sin(cell.x * 1.7 + cell.y * 0.8 - t * 0.6);\nlet haze = cloud(p * vec2<f32>(1.4) + vec2<f32>(t * 0.025, 0.0));\nlet base = vec3<f32>(0.008, 0.014, 0.024) + c3 * vec3<f32>(0.025 + haze * 0.035);\nreturn clamp(base + tint * vec3<f32>(glyph * pixel * wake * (0.08 + amount * 0.017)), vec3<f32>(0.0), vec3<f32>(0.38));",
