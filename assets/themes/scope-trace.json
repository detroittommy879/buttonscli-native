      "custom": {
        "expression": "let wob = wobble * (0.6 * sin(t * 0.37 + p.x * 2.3) + 0.4 * sin(t * 0.91 - p.x * 5.1));\nlet hz = 0.04 + wob;\nlet floor_mask = 1.0 - step(hz, p.y);\nlet d = max(hz - p.y, 0.015);\nlet depth = 1.0 / d;\nlet gz = depth * 0.35 + t * speed;\nlet gx = p.x * depth * 0.5;\nlet hd = abs(fract(gz + 0.5) - 0.5);\nlet vd = abs(fract(gx + 0.5) - 0.5);\nlet hl = 1.0 - smoothstep(0.0, line_w, hd);\nlet vl = 1.0 - smoothstep(0.0, line_w * 0.8, vd);\nlet row = hash(vec2<f32>(floor(gz), 3.0));\nlet flick = 0.6 + 0.4 * sin(t * 2.0 + row * 6.28);\nlet vis = smoothstep(0.015, 0.4, d);\nlet grid = max(hl, vl * 0.9) * vis * flick;\nlet glow_line = smoothstep(0.5, 0.0, hd) * 0.2 * vis;\nlet floor_col = c2 * (grid * 1.2 + glow_line) + c3 * 0.15 * vis;\nlet horizon = c2 * 0.35 * exp(-abs(p.y - hz) * 18.0);\nlet mist = noise(vec2<f32>(p.x * 3.0 + t * 0.05, p.y * 4.0)) * exp(-abs(p.y - hz) * 6.0);\nlet sky = horizon + c3 * 0.25 * mist;\nlet scene = mix(sky, floor_col, floor_mask);\nreturn mix(bg, tonemap(bg + scene), strength);",
        "name": "Sick Grid",
