      "custom": {
        "expression": "let intensity = clamp(amount * 0.1, 0.0, 1.0);\nlet drift = vec2<f32>(t * 0.013, -t * 0.009);\nlet uv = p * vec2<f32>(3.2) + drift;\nlet tile = floor(uv / vec2<f32>(4.0));\nlet seed = hash(tile);\nlet local = fract(uv / vec2<f32>(4.0)) * vec2<f32>(4.0) - vec2<f32>(2.0);\nlet rotation = step(0.5, seed);\nlet rotated = mix(local, vec2<f32>(-local.y, local.x), vec2<f32>(rotation));\nlet block = floor(rotated + vec2<f32>(1.5, 1.0));\nlet q = fract(rotated + vec2<f32>(1.5, 1.0)) - vec2<f32>(0.5);\nlet bounds = step(0.0, block.x) * (1.0 - step(3.0, block.x)) * step(0.0, block.y) * (1.0 - step(2.0, block.y));\nlet occupied = bounds * max(1.0 - step(1.0, block.y), 1.0 - step(0.1, abs(block.x - 1.0)));\nlet edgeDistance = max(abs(q.x), abs(q.y));\nlet body = (1.0 - smoothstep(0.435, 0.46, edgeDistance)) * occupied;\nlet outline = exp(-abs(edgeDistance - 0.445) * 105.0) * occupied;\nlet studDistance = length(q - vec2<f32>(-0.025, 0.025));\nlet stud = exp(-abs(studDistance - 0.145) * 100.0) * body;\nlet studShade = (1.0 - smoothstep(0.11, 0.15, studDistance)) * body;\nlet hue = seed * 0.85 + 0.04 * sin(t * 0.035);\nlet color = mix(palette(hue), mix(c1, c2, seed), 0.45);\nlet gridQ = abs(fract(uv) - vec2<f32>(0.5));\nlet grid = smoothstep(0.485, 0.5, max(gridQ.x, gridQ.y));\nlet base = vec3<f32>(0.004, 0.006, 0.012) + c3 * vec3<f32>(0.006);\nlet lines = outline * 0.36 + stud * 0.14;\nlet fill = body * 0.015 - studShade * 0.004;\nlet vignette = 1.0 / (1.0 + dot(p, p) * 0.16);\nlet light = color * vec3<f32>((lines + fill) * (0.25 + intensity * 0.75));\nreturn clamp((base + light + c3 * vec3<f32>(grid * 0.005)) * vec3<f32>(vignette), vec3<f32>(0.0), vec3<f32>(0.4));",
