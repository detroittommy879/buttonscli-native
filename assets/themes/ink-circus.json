      "custom": {
        "expression": "let density = 0.8 + amount * 0.23;\nlet column = floor(p.x * density);\nlet seed = hash(vec2<f32>(column, 7.3));\nlet clock = t * gravity * 0.42 + seed * 8.0;\nlet fall = floor(clock) + pow(fract(clock), 2.0);\nlet grid = vec2<f32>(p.x * density, p.y * density + fall);\nlet cell = floor(grid);\nlet id = hash(cell + vec2<f32>(2.7, 9.1));\nlet q = fract(grid) - vec2<f32>(0.5);\nlet angle = sin(clock * 2.4 + id * 14.0) * 0.65 + id * 6.283;\nlet r = vec2<f32>(q.x * cos(angle) - q.y * sin(angle), q.x * sin(angle) + q.y * cos(angle));\nlet size = shape_size * (0.65 + 0.2 * sin(clock * 5.0 + id * 20.0));\nlet round = length(r) - size;\nlet box = max(abs(r.x), abs(r.y)) - size * 0.86;\nlet star = length(r) - size * (0.78 + 0.22 * cos(atan2(r.y, r.x) * 5.0));\nlet d = select(select(round, box, id > 0.33), star, id > 0.66);\nlet body = 1.0 - smoothstep(-0.006, 0.008, d);\nlet eye1 = 1.0 - smoothstep(0.018, 0.03, length(r - vec2<f32>(-0.065, 0.035)));\nlet eye2 = 1.0 - smoothstep(0.018, 0.03, length(r - vec2<f32>(0.065, 0.035)));\nlet grin = (1.0 - smoothstep(0.008, 0.018, abs(length(r - vec2<f32>(0.0, 0.025)) - 0.09))) * (1.0 - smoothstep(-0.025, -0.012, r.y));\nlet accent = select(select(c1, c2, id > 0.33), c3, id > 0.66);\nlet paper = mix((c1 + c2 + c3) / 3.0, vec3<f32>(1.0), 0.7);\nlet ink = mix(bg, accent, 0.08);\nlet dots = step(0.83, sin(p.x * 48.0) * sin(p.y * 48.0));\nlet backdrop = mix(ink, paper, 0.08 + dots * 0.12);\nlet halo = exp(-max(d, 0.0) * 16.0) * (1.0 - body) * glow * 0.22;\nlet face = mix(paper, ink, clamp(eye1 + eye2 + grin, 0.0, 1.0));\nlet activity = smoothstep(0.0, 0.8, amount);\nlet color = clamp(mix(backdrop + accent * halo, face, body * activity), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
