        "expression": "let horizon = -0.28 + wave_height * sin(p.x * 3.2 + t * 1.3);\nlet sky = mix(c3, c4, 0.35 * smoothstep(-0.3, 1.5, p.y));\nlet sun = 1.0 - smoothstep(0.27, 0.28, length(p - vec2<f32>(-0.78, 0.58)));\nlet sea = mix(c4, c3, 0.3 + 0.4 * pow(0.5 + 0.5 * sin(p.y * 48.0 + sin(p.x * 4.0 + t) * 2.0 + t * 2.0), 9.0));\nlet scene = mix(mix(sky, c2, sun), sea, 1.0 - smoothstep(horizon - 0.015, horizon + 0.015, p.y));\n\nlet q = vec2<f32>((fract((p.x - t * plane_speed) / 3.6 + 0.5) - 0.5) * 3.6, p.y - 0.43 - 0.1 * sin(t * 0.8));\nlet plane = 1.0 - smoothstep(0.95, 1.05, min(length(q / vec2<f32>(0.26, 0.035)), min(abs(q.x + q.y * 0.4) / 0.095 + abs(q.y) / 0.23, abs(q.x + 0.18) / 0.055 + abs(q.y) / 0.1)));\nlet flying = mix(scene, c1, plane);\n\nlet bp = vec2<f32>((fract((p.x - 0.68) / 2.9 + 0.5) - 0.5) * 2.9, p.y + 0.37 - 0.045 * sin(t * 1.8));\nlet br = length(bp) / ball_size;\nlet angle = atan2(bp.y, bp.x) + t * 0.65;\nlet panels = mix(mix(c1, c2, step(0.0, sin(angle * 3.0))), c5, step(0.5, cos(angle * 3.0)));\nlet ball = mix(panels, c3, 0.5 * pow(1.0 - abs(sin(angle * 3.0)), 18.0));\nlet color = mix(flying, ball, 1.0 - smoothstep(0.97, 1.01, br));\nreturn mix(bg, color, strength);",
