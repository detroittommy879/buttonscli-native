      "custom": {
        "expression": "var col = vec3<f32>(0.0, 0.0, 0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let scale = (3.0 + 2.5 * k) * shape_scale;\n    let speed = 0.12 + 0.15 * k;\n    let g = p * scale + vec2<f32>(0.0, t * speed * scale * 0.2);\n    let cell = floor(g);\n    let f = fract(g) - 0.5;\n    let s = hash(cell + vec2<f32>(k * 17.0, 3.0));\n    let spin = (0.4 + s) * select(-1.0, 1.0, s > 0.5);\n    let r = rotate(f, t * spin + s * 6.28);\n    let size = 0.12 + 0.2 * fract(s * 7.3);\n    let d = sd_box(r, vec2<f32>(size, size));\n    let line = 1.0 - smoothstep(0.0, 0.025, abs(d));\n    let solid = (1.0 - smoothstep(-0.01, 0.01, d)) * step(0.6, s);\n    let base = mix(mix(c1, c2, k * 0.5), c5, step(0.7, s));\n    col += base * (line + solid * 0.35) * (1.0 - 0.25 * k);\n}\nlet wave = abs(p.y - 0.25 * sin(p.x * 6.0 + t * 0.8));\nlet curve = 1.0 - smoothstep(0.0, 0.012, wave);\ncol += c3 * curve * 0.8;\nlet q = polar(p);\nlet ring = 1.0 - smoothstep(0.0, 0.01, abs(q.x - 0.3 - 0.02 * sin(t)));\ncol += c2 * ring * 0.9;\nlet color = tonemap(col);\nreturn mix(bg, color, strength);",
        "name": "Parallax Prism Drift",
