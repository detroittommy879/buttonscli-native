        "expression": "let scale = 1.2 + amount * 0.12;\nlet uv = p * scale;\nlet cell = floor(uv.x);\nlet q = fract(uv) - vec2<f32>(0.5, 0.5);\nlet phase = t * 1.15 + cell * 1.73;\nlet curveA = 0.28 * sin(q.x * 18.0 + phase) * cos(q.x * 6.0 - phase * 0.7);\nlet curveB = 0.22 * cos(q.x * 25.0 - phase * 1.3) * sin(q.x * 8.0 + phase);\nlet lineA = exp(-abs(q.y - curveA) * 180.0);\nlet lineB = exp(-abs(q.y - curveB) * 220.0);\nlet diagonal = exp(-abs(q.y + q.x * sin(phase) * 0.75) * 280.0);\nlet vertical = exp(-abs(q.x - 0.24 * sin(q.y * 16.0 + phase)) * 210.0);\nlet sharp = clamp(lineA + lineB + diagonal * 0.7 + vertical * 0.65, 0.0, 1.0);\nlet glow = clamp(lineA * 0.18 + lineB * 0.13 + diagonal * 0.08, 0.0, 1.0);\nlet hue = fract(q.x * 0.7 + q.y * 0.9 + cell * 0.19 - t * 0.08);\nlet spectrum = palette(hue);\nlet background = mix(c1, mix(c2, c3, 0.5 + 0.5 * sin(p.x * 1.3 + t * 0.16)), 0.34) * 0.045;\nlet color = background + spectrum * (sharp * 0.48 + glow * 0.12);\nreturn clamp(color, vec3<f32>(0.0), vec3<f32>(0.58));",
        "variables": [
          {
            "max": 10.0,
