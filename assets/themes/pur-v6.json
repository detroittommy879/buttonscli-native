      "custom": {
        "expression": "let tt = t * bubble_speed;\nlet depth = smoothstep(0.5, -0.5, p.y);\nlet w1 = 0.34 + 0.05 * wave_amp * sin(p.x * 5.0 + t * 0.9) + 0.02 * wave_amp * sin(p.x * 12.0 - t * 1.5);\nlet w2 = 0.05 + 0.07 * wave_amp * sin(p.x * 3.5 - t * 0.6 + 1.3);\nlet w3 = -0.22 + 0.08 * wave_amp * sin(p.x * 2.2 + t * 0.45 + 2.7);\nlet air = smoothstep(w1 - 0.01, w1 + 0.01, p.y);\nlet water = mix(c1 * 0.45 + c4 * 0.12, c2 * 0.4 + c4 * 0.05, depth);\nlet air_col = mix(c3 * 0.7, c1 * 0.9, smoothstep(0.5, 0.2, p.y));\nlet surfc = mix(water, air_col, air);\nlet glint = exp(-abs(p.y - w1) * 34.0) * c3;\nlet band2 = exp(-abs(p.y - w2) * 22.0) * c1 * 0.5;\nlet band3 = exp(-abs(p.y - w3) * 16.0) * c5 * 0.25;\nlet caustic = ridged(p * vec2<f32>(6.0, 4.0) + vec2<f32>(t * 0.08, t * 0.05)) * (1.0 - depth) * c3 * 0.25;\nlet fa = vec2<f32>(p.x * 14.0, p.y * 14.0 - tt * 0.25);\nlet ca = floor(fa);\nlet sa = hash(ca + vec2<f32>(3.0, 1.0));\nlet la = fract(fa) - 0.5 - (hash2(ca) - 0.5) * 0.3 + vec2<f32>(0.06 * sin(tt * 1.3 + sa * 6.28), 0.0);\nlet da = sd_circle(la, (0.1 + 0.06 * sa) * bubble_size);\nlet ba = (stroke(da, 0.03) + fill(da) * 0.12) * step(0.45, sa);\nlet cola = mix(c3, c1, sa) * ba * 0.45;\nlet fb = vec2<f32>(p.x * 8.0, p.y * 8.0 - tt * 0.35);\nlet cb = floor(fb);\nlet sb = hash(cb + vec2<f32>(11.0, 5.0));\nlet lb = fract(fb) - 0.5 - (hash2(cb) - 0.5) * 0.3 + vec2<f32>(0.06 * sin(tt * 1.7 + sb * 6.28), 0.0);\nlet db = sd_circle(lb, (0.1 + 0.06 * sb) * bubble_size);\nlet bb = (stroke(db, 0.035) + fill(db) * 0.15) * step(0.4, sb);\nlet colb = mix(c1, c5, sb) * bb * 0.8;\nlet fc = vec2<f32>(p.x * 4.0, p.y * 4.0 - tt * 0.45);\nlet cc = floor(fc);\nlet sc = hash(cc + vec2<f32>(17.0, 9.0));\nlet lc = fract(fc) - 0.5 - (hash2(cc) - 0.5) * 0.3 + vec2<f32>(0.05 * sin(tt * 1.1 + sc * 6.28), 0.0);\nlet dc = sd_circle(lc, (0.1 + 0.06 * sc) * bubble_size);\nlet bc = (stroke(dc, 0.03) + fill(dc) * 0.1 + halo(dc, 0.05) * 0.3) * step(0.4, sc);\nlet colc = mix(c3, c5, sc) * bc * 1.2;\nlet col = surfc + glint + band2 + band3 + caustic + cola + colb + colc;\nreturn mix(bg, tonemap(col * 1.2), strength);",
        "name": "Abyssal Bubbles",
