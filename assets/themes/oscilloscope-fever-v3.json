      "custom": {
        "expression": "let horizon = 0.10;\nlet up = p.y - horizon;\nlet ground = max(-up, 0.0);\nlet below = smoothstep(0.0, 0.02, -up);\n\n// night sky with a warm band along the horizon\nlet skyT = smoothstep(0.0, 0.62, up);\nlet skyCol = mix(c1 * 0.55, c3 * 0.45, skyT) + c4 * stars(p * 24.0, t) * smoothstep(0.05, 0.30, up) * 0.9;\n\n// perspective floor\nlet depth = 1.0 / max(horizon - p.y, 0.05);\nlet u = p.x * depth * 2.2;\nlet v = depth * 0.9 - t * 0.55;\nlet w = vec2<f32>(noise(vec2<f32>(u * 0.45, v * 0.45)), noise(vec2<f32>(u * 0.45 + 31.0, v * 0.45))) - 0.5;\nlet gu = (u + w.x * wobble * 0.25) * density;\nlet gv = (v + w.y * wobble * 0.25) * density;\nlet cell = floor(vec2<f32>(gu, gv));\nlet f = fract(vec2<f32>(gu, gv)) - 0.5;\nlet seed = hash(cell);\nlet fade = 1.0 - smoothstep(9.0, 16.0, depth);\n\n// hand-drawn tile borders\nlet edge = 0.5 - max(abs(f.x), abs(f.y));\nlet lw = 0.02 + 0.012 * depth;\nlet gridline = 1.0 - smoothstep(0.0, lw, edge);\n\n// one small window per tile\nlet off = (hash2(cell + vec2<f32>(3.7, 1.3)) - 0.5) * 0.24;\nlet size = vec2<f32>(0.17, 0.11 + 0.05 * seed);\nlet d = sd_box(f - off, size);\nlet flick = 1.0 - flicker * (0.5 + 0.5 * sin(t * (0.9 + 2.6 * seed) + seed * 6.28318));\nlet lit = step(0.2, seed);\nlet pick = hash(cell + vec2<f32>(9.1, 4.4));\nlet tint = mix(c1, c4, pick * pick);\nlet win = (fill(d) * 0.95 + halo(d, 0.11) * 0.5) * flick * lit * fade * glow;\n\n// floor surface\nlet floorBase = mix(c3, c2 * 0.45, 0.30 + 0.40 * (w.x + 0.5)) * 0.95;\nlet haze = c1 * 0.42 * exp(-ground * 7.0);\nlet floorCol = floorBase + haze + mix(c2, c4, 0.25) * gridline * 0.5 * fade + tint * win;\n\nlet scene = mix(skyCol, floorCol, below);\nreturn mix(bg, tonemap(scene * 1.15), strength);",
