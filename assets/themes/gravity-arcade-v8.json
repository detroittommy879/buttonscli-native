        "expression": "let ga = p * 3.0 * glyph_size + vec2<f32>(t * 0.06, t * 0.02);\nlet ca = floor(ga);\nlet fa = fract(ga) - 0.5;\nlet ha = hash(ca);\nlet ra = rotate(fa, t * (0.2 + 0.3 * ha) + ha * 6.28);\nlet ka = 1.0 + 0.45 * sin(t * 0.9 + ha * 6.28);\nlet ring = stroke(sd_circle(vec2<f32>(ra.x / ka, ra.y * ka), 0.16), 0.012);\nlet bond = vec2<f32>(0.14 * cos(t * 0.5 + ha * 9.0), 0.14 * sin(t * 0.5 + ha * 9.0));\nlet mol = min(min(sd_circle(ra - vec2<f32>(-0.12, 0.0), 0.03), sd_circle(ra - bond, 0.03)), sd_segment(ra, vec2<f32>(-0.12, 0.0), bond));\nlet far = stroke(mol, 0.01) * 0.5 + ring * 0.35;\nlet gb = p * 1.6 * glyph_size - vec2<f32>(t * 0.12, 0.0);\nlet cb = floor(gb);\nlet fb = fract(gb) - 0.5;\nlet hb = hash(cb + vec2<f32>(3.0, 7.0));\nlet rb = rotate(fb, sin(t * 0.7 + hb * 6.28) * 0.8);\nlet corner = min(sd_segment(rb, vec2<f32>(0.0, -0.18), vec2<f32>(0.0, 0.18)), sd_segment(rb, vec2<f32>(0.0, -0.18), vec2<f32>(0.18, -0.18)));\nlet dotb = sd_circle(rb - vec2<f32>(0.24, 0.18), 0.025);\nlet near = stroke(min(corner, dotb), 0.018) * step(0.35, hb);\nlet wave = p.y - 0.14 * cos(p.x * 7.0 + t * 0.6) - 0.05 * cos(p.x * 13.0 - t * 0.9);\nlet wline = stroke(wave, 0.008) * smoothstep(0.9, 0.2, abs(p.x));\nlet color = bg + far * c4 * 0.9 + near * c1 * 1.1 + wline * c5 * 0.8;\nreturn mix(bg, tonemap(color), strength);",
