      "custom": {
        "expression": "let base = bg + c4 * 0.2 * smoothstep(-0.5, 0.5, p.y);\nlet below = p.y - 0.05;\nlet z = 0.12 / max(abs(below), 0.03);\nlet gr = vec2<f32>(p.x * z, z + t * layer_speed * 2.0);\nlet lx = abs(fract(gr.x + 0.5) - 0.5);\nlet lz = abs(fract(gr.y + 0.5) - 0.5);\nlet grid = max(1.0 - smoothstep(0.0, 0.025, lx), 1.0 - smoothstep(0.0, 0.025, lz));\nlet floor_mask = 1.0 - smoothstep(-0.01, 0.01, below);\nlet floor_glow = clamp(1.3 - z * 0.12, 0.0, 1.0);\nlet floor_col = c4 * 1.4 * grid * floor_mask * floor_glow;\nvar sky = vec3<f32>(0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let g = p * (grid_scale * (1.0 + k * 0.7)) + vec2<f32>(t * layer_speed * (0.5 + k * 0.5), t * layer_speed * 0.2 * k);\n    let cell = floor(g);\n    let f = fract(g) - 0.5;\n    let s = hash(cell + vec2<f32>(k * 13.0, 0.0));\n    let r = rotate(f, t * (0.2 + k * 0.1) * (s - 0.5) * 2.0);\n    let d = sd_box(r, vec2<f32>(0.3, 0.3));\n    let edge = 1.0 - smoothstep(0.0, 0.012, abs(d));\n    let visible = step(0.3, s);\n    sky += mix(c1, c2, s) * edge * visible * (0.5 + 0.25 * k);\n}\nlet a = vec2<f32>(-0.9 + 1.8 * fract(t * 0.04), 0.25);\nlet b = a + vec2<f32>(0.25, 0.12 * sin(t * 0.5));\nlet seg = 1.0 - smoothstep(0.003, 0.008, sd_segment(p, a, b));\nlet accent = c3 * seg * 1.2;\nlet scene = base + sky + floor_col + accent;\nreturn mix(bg, tonemap(scene), strength);",
