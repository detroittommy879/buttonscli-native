        "expression": "let hz = -0.03;\nlet below = max(hz - p.y, 0.015);\nlet depth = 1.0 / below;\nlet px = p.x * depth;\nlet fog = exp(-below * 2.5);\nvar hgt = 0.0;\nvar grad = vec2<f32>(0.0, 0.0);\nfor (var i = 0; i < 5; i++) {\n    let k = f32(i);\n    let dir = normalize(vec2<f32>(sin(k * 2.1 + 0.6), 1.0 + 0.3 * k));\n    let freq = (1.2 + k * 1.1) * 0.35;\n    let amp = 1.0 / (1.0 + k * 0.7);\n    let phase = dot(dir, vec2<f32>(px, depth)) * freq + t * wave_speed * (0.5 + 0.2 * k);\n    hgt += sin(phase) * amp;\n    grad += cos(phase) * amp * freq * dir;\n}\nlet fine = noise(vec2<f32>(px * 2.5 - t * 0.4 * wave_speed, depth * 3.0 + t * 0.6 * wave_speed));\nlet shade = clamp(0.5 + 0.25 * hgt * wave_height + 0.2 * (fine - 0.5), 0.0, 1.0);\nlet crest = smoothstep(0.6, 0.95, shade);\nlet sway = clamp(grad.x * wave_height * 0.03 * min(depth, 20.0), -0.2, 0.2);\nlet glint_x = p.x - 0.42 - sway;\nlet glint = smoothstep(0.06, 0.0, abs(glint_x)) * (0.4 + 0.6 * crest) * (0.3 + 0.7 * fog);\nlet body = mix(c1 * 0.6, c2, 0.3 + 0.7 * shade);\nlet reflect_sky = c5 * smoothstep(0.4, 0.0, below) * 0.5;\nlet water = body * (0.45 + 0.55 * fog) + c3 * crest * 0.35 * (0.4 + 0.6 * fog) + reflect_sky + c4 * glint * sun_glint * 0.8;\nlet stars_v = stars(p * 22.0, t);\nlet sky = mix(c5 * 0.45, c1 * 0.3, smoothstep(hz, 0.5, p.y));\nlet moon_d = sd_circle(p - vec2<f32>(0.42, 0.3), 0.05);\nlet moon = fill(moon_d) + halo(moon_d, 0.2) * 0.4;\nlet skyc = sky + c3 * stars_v * 0.8 + c4 * moon;\nlet foam = smoothstep(0.02, 0.0, abs(p.y - hz)) * (0.4 + 0.6 * shade) * c3;\nlet scene = mix(water + foam, skyc, smoothstep(hz - 0.004, hz + 0.004, p.y));\nreturn mix(bg, tonemap(scene), strength);",
