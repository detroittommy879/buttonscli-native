      "custom": {
        "expression": "let tw = t * wave_speed;\nlet base = mix(c4 * 0.35, c2 * 0.45, smoothstep(-0.5, 0.5, p.y));\nlet w1 = 0.34 + 0.03 * sin(p.x * 4.0 + tw * 0.5);\nlet w2 = 0.2 + 0.035 * sin(p.x * 6.5 - tw * 0.8 + 1.3);\nlet w3 = 0.06 + 0.04 * sin(p.x * 10.0 + tw * 1.3 + 2.1);\nlet m1 = smoothstep(-0.008, 0.008, p.y - w1);\nlet m2 = smoothstep(-0.008, 0.008, p.y - w2);\nlet m3 = smoothstep(-0.008, 0.008, p.y - w3);\nlet layer1 = mix(base, c2 * 0.8, m1 * 0.35);\nlet layer2 = mix(layer1, c5 * 0.6, m2 * 0.4);\nlet edge3 = 1.0 - smoothstep(0.0, 0.014, abs(p.y - w3));\nlet layer3 = mix(layer2, c3, m3 * 0.25) + c3 * edge3 * 0.5;\nlet rays = pow(0.5 + 0.5 * sin(p.x * 9.0 + sin(p.y * 3.0 + tw * 0.3) * 2.0), 6.0) * smoothstep(-0.2, 0.5, p.y);\nlet light = layer3 + c3 * rays * 0.25;\nlet thr = clamp(1.0 - 0.35 * bubble_amount, 0.0, 1.0);\nlet ga = vec2<f32>(p.x * 7.0, p.y * 7.0 - t * 0.12);\nlet ca = floor(ga);\nlet sa = hash(ca);\nlet ja = (hash2(ca) - vec2<f32>(0.5, 0.5)) * 0.5;\nlet da = sd_circle(fract(ga) - 0.5 - ja, 0.12 + 0.04 * sa);\nlet fa = stroke(da, 0.025) * step(thr, sa) * 0.5;\nlet gb = vec2<f32>(p.x * 4.5, p.y * 4.5 - t * 0.25);\nlet cb = floor(gb);\nlet sb = hash(cb);\nlet jb = (hash2(cb) - vec2<f32>(0.5, 0.5)) * 0.5;\nlet db = sd_circle(fract(gb) - 0.5 - jb, 0.16);\nlet fb = (stroke(db, 0.03) + fill(db) * 0.08) * step(thr, sb);\nlet gc = vec2<f32>(p.x * 2.5, p.y * 2.5 - t * 0.4);\nlet cc = floor(gc);\nlet sc = hash(cc);\nlet jc = (hash2(cc) - vec2<f32>(0.5, 0.5)) * 0.5;\nlet dc = sd_circle(fract(gc) - 0.5 - jc, 0.2);\nlet fc = (stroke(dc, 0.035) + fill(dc) * 0.08 + halo(dc, 0.03) * 0.15) * step(thr, sc);\nlet bubbles = c2 * fa + c1 * fb * 0.8 + c3 * fc * 1.2;\nlet total = tonemap(light + bubbles);\nreturn mix(bg, total, strength);",
        "name": "Parallax Deep",
        "variables": [
          {
            "max": 2.0,
            "min": 0.5,
            "name": "bubble_amount",
            "value": 1.0
          },
          {
            "max": 2.0,
