    "shaderLabStrength": 75,
    "shaderLabFragmentShader": "precision mediump float;\n\nuniform sampler2D u_composite;\nuniform vec2 u_resolution;\nuniform vec2 u_texel;\nuniform float u_time;\nuniform float u_strength;\n\nvec2 shaderLabUv() {\n  return vec2(\n    gl_FragCoord.x / u_resolution.x,\n    1.0 - gl_FragCoord.y / u_resolution.y\n  );\n}\n\nvec4 sampleComposite(vec2 uv) {\n  return texture2D(u_composite, clamp(uv, vec2(0.0), vec2(1.0)));\n}\n\nvoid main() {\n  vec2 uv = shaderLabUv();\n  float offset = sin(u_time * 6.283185 * 60.0) * 0.005 * u_strength;\n  vec2 shiftedUv = vec2(uv.x, uv.y + offset);\n  vec4 color = sampleComposite(shiftedUv);\n  \n  float interlace = mod(floor(uv.y * u_resolution.y + u_time * 30.0), 2.0);\n  float scanline = sin(uv.y * u_resolution.y * 3.14159 * 24.0) * 0.5 + 0.5;\n  scanline = mix(1.0, scanline * 0.7 + 0.3, u_strength);\n  color.rgb *= mix(1.0, 0.5 + interlace * 0.3, u_strength * 0.8);\n  color.rgb *= scanline;\n  \n  gl_FragColor = color;\n}",
