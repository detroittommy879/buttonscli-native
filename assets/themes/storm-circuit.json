      "custom": {
        "expression": "let sky = cloud(vec2<f32>(p.x * 0.7 + t * 0.035, p.y * 1.3));\nlet bands = floor(sky * 6.0) / 5.0;\nlet base = mix(c1, c2, clamp(bands * 0.8, 0.0, 1.0));\nlet haze = smoothstep(-0.8, 1.4, p.y) * 0.22;\nlet atmosphere = mix(base, c4, haze);\n\nlet rx = (p.x - p.y * 0.23) * rain_density;\nlet column = floor(rx);\nlet drift = 0.75 + hash(vec2<f32>(column, 3.0)) * 0.7;\nlet ry = p.y * 3.3 + t * rain_speed * drift * 3.3;\nlet cell = vec2<f32>(column, floor(ry));\nlet seed = hash(cell);\nlet center = 0.25 + hash(cell + vec2<f32>(7.0, 19.0)) * 0.5;\nlet line = 1.0 - smoothstep(0.018, 0.065, abs(fract(rx) - center));\nlet tail = smoothstep(0.12, 0.18, fract(ry)) * (1.0 - smoothstep(0.56, 0.62, fract(ry)));\nlet rain = line * tail * step(0.24, seed);\nlet rainColor = mix(c3, c5, seed * 0.65);\n\nlet clock = t * thunder_rate;\nlet event = floor(clock);\nlet age = fract(clock);\nlet flash = exp(-age * 38.0) + 0.65 * exp(-abs(age - 0.075) * 100.0);\nlet boltX = (hash(vec2<f32>(event, 11.0)) - 0.5) * 2.8;\nlet height = (p.y + 1.2) * 5.0;\nlet node = floor(height);\nlet a = hash(vec2<f32>(node, event));\nlet b = hash(vec2<f32>(node + 1.0, event));\nlet zigzag = (mix(a, b, fract(height)) - 0.5) * 0.38;\nlet boltDistance = abs(p.x - boltX - zigzag);\nlet core = 1.0 - smoothstep(0.009, 0.023, boltDistance);\nlet halo = exp(-boltDistance * 16.0) * 0.48;\nlet bolt = clamp((core + halo) * flash, 0.0, 1.0);\nlet litSky = mix(atmosphere, c4, clamp(flash * 0.28, 0.0, 0.35));\nlet wet = mix(litSky, rainColor, rain * 0.88);\nlet color = mix(wet, c5, bolt);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
        "name": "Storm Circuit",
