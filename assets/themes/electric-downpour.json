      "custom": {
        "expression": "let sky = cloud(p * 1.6 + vec2<f32>(t * 0.045, -t * 0.025));\nlet mist = cloud(p * 3.0 + vec2<f32>(-t * 0.08, t * 0.035));\nlet horizon = exp(-abs(p.y + 0.45) * 1.4);\nlet base = mix(c1, c2, smoothstep(0.2, 0.85, sky));\nlet atmosphere = mix(base, c3, horizon * mist * 0.32);\nlet storm = mix(atmosphere, c4, pow(sky, 3.0) * 0.32);\n\nlet q = vec2<f32>(p.x - wind * p.y, p.y);\nlet r1 = q * vec2<f32>(42.0 * rain_density, 7.0) + vec2<f32>(0.0, t * 8.0);\nlet id1 = floor(r1);\nlet h1 = hash(id1);\nlet f1 = fract(r1);\nlet streak1 = (1.0 - smoothstep(0.025, 0.095, abs(f1.x - 0.5))) * smoothstep(0.12, 0.85, f1.y) * step(0.36, h1);\nlet r2 = q * vec2<f32>(69.0 * rain_density, 11.0) + vec2<f32>(17.0, t * 12.0);\nlet id2 = floor(r2);\nlet f2 = fract(r2);\nlet streak2 = (1.0 - smoothstep(0.018, 0.075, abs(f2.x - 0.5))) * smoothstep(0.25, 0.95, f2.y) * step(0.56, hash(id2));\n\nlet clock = t * lightning_rate * 0.22;\nlet cycle = floor(clock);\nlet phase = fract(clock);\nlet flash = min(1.0, exp(-phase * 55.0) + 0.65 * exp(-abs(phase - 0.095) * 95.0));\nlet anchor = (hash(vec2<f32>(cycle, 8.3)) - 0.5) * 3.2;\nlet zig = (noise(vec2<f32>(p.y * 15.0, cycle * 11.0)) - 0.5) * 0.24;\nlet path = anchor + 0.13 * p.y + zig;\nlet d = abs(p.x - path);\nlet bolt = exp(-d * 320.0) + 0.32 * exp(-d * 34.0);\nlet branchPath = path + max(0.0, 0.35 - p.y) * 0.58;\nlet branch = exp(-abs(p.x - branchPath) * 240.0) * smoothstep(-0.7, -0.35, p.y) * (1.0 - smoothstep(0.25, 0.4, p.y));\nlet gate = smoothstep(-0.95, -0.65, p.y);\nlet litSky = storm + c4 * vec3<f32>(flash * (0.16 + 0.22 * sky));\nlet rainfall = c3 * vec3<f32>(streak1 * 0.42) + c5 * vec3<f32>(streak2 * 0.30);\nlet electricity = c5 * vec3<f32>((bolt + branch * 0.65) * flash * gate);\nlet color = clamp(litSky + rainfall + electricity, vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
