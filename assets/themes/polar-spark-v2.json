      "custom": {
        "expression": "let sky = clamp(p.y * 0.25 + 0.5, 0.0, 1.0);\nlet base = mix(c1, c3, sky) * vec3<f32>(0.38);\nlet wave = sin(p.x * 1.7 + t * 0.28) * 0.32 + sin(p.x * 3.1 - t * 0.19) * 0.12;\nlet curtain = p.y - wave - 0.35;\nlet ribbon = exp(-abs(curtain) * 3.8);\nlet folds = 0.55 + 0.45 * sin(p.x * 8.0 + sin(p.x * 2.5 + t * 0.3) * 2.0 + t * 0.4);\nlet aurora = mix(c2, c4, 0.5 + 0.5 * sin(p.x * 1.2 + t * 0.16));\nlet veil = aurora * vec3<f32>(ribbon * (0.38 + folds * 0.55) * aurora_glow);\nlet q = p * vec2<f32>(snow_density) + vec2<f32>(sin(t * 0.23) * 0.3 - t * snow_speed * 0.15, t * snow_speed);\nlet cell = floor(q);\nlet seed = hash(cell);\nlet offset = vec2<f32>(hash(cell + vec2<f32>(7.3, 2.1)), hash(cell + vec2<f32>(3.8, 9.4)));\nlet flake = fract(q) - vec2<f32>(0.5) - (offset - vec2<f32>(0.5)) * vec2<f32>(0.5);\nlet size = 0.065 + seed * 0.065;\nlet arm1 = abs(flake.x);\nlet arm2 = abs(dot(flake, vec2<f32>(0.5, 0.8660254)));\nlet arm3 = abs(dot(flake, vec2<f32>(-0.5, 0.8660254)));\nlet crystal = (1.0 - smoothstep(0.009, 0.025, min(arm1, min(arm2, arm3)))) * (1.0 - smoothstep(size * 0.65, size, length(flake)));\nlet halo = exp(-length(flake) * 24.0) * 0.18;\nlet farq = p * vec2<f32>(snow_density * 1.8) + vec2<f32>(-t * snow_speed * 0.22, t * snow_speed * 0.55);\nlet farcell = floor(farq);\nlet farpoint = fract(farq) - vec2<f32>(0.2) - vec2<f32>(hash(farcell), hash(farcell + vec2<f32>(4.0))) * vec2<f32>(0.6);\nlet dust = (1.0 - smoothstep(0.012, 0.045, length(farpoint))) * 0.5;\nlet winter = base + veil + c2 * vec3<f32>(dust);\nlet snow = clamp(crystal * (0.65 + seed * 0.35) + halo, 0.0, 1.0);\nlet color = clamp(mix(winter, c5, snow), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
