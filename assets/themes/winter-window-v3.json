      "custom": {
        "expression": "let g1 = p * 4.0 * density + vec2<f32>(t * 0.03, 0.0);\nlet k1 = floor(g1);\nlet f1 = fract(g1) - 0.5;\nlet s1 = hash(k1);\nlet r1 = rotate(f1, t * spin_speed * (0.15 + 0.3 * s1));\nlet w1 = 0.5 + 0.5 * sin(t * 0.7 + s1 * 6.28);\nlet reach1 = 0.14 + 0.06 * morph_amount * w1;\nlet mol1 = min(sd_circle(r1 - vec2<f32>(-reach1, 0.0), 0.035), sd_circle(r1 - vec2<f32>(reach1, 0.0), 0.035));\nlet bond1 = stroke(sd_segment(r1, vec2<f32>(-reach1, 0.0), vec2<f32>(reach1, 0.0)), 0.01);\nlet ov1 = vec2<f32>(r1.x, r1.y * (1.0 + morph_amount * w1));\nlet ring1 = stroke(sd_circle(ov1, 0.22), 0.01);\nlet layer_far = (c5 * (fill(mol1) + halo(mol1, 0.05) * 0.4) + c1 * (bond1 + ring1) * 0.5) * 0.45;\nlet g2 = p * 2.2 * density + vec2<f32>(-t * 0.08, 0.0);\nlet k2 = floor(g2);\nlet f2 = fract(g2) - 0.5;\nlet s2 = hash(k2);\nlet r2 = rotate(f2, sin(t * 0.4 + s2 * 6.28) * 0.6 * spin_speed);\nlet corner = min(sd_segment(r2, vec2<f32>(0.3, 0.3), vec2<f32>(0.3, -0.3)), sd_segment(r2, vec2<f32>(0.3, -0.3), vec2<f32>(0.0, -0.3)));\nlet wave2 = abs(r2.y - 0.12 * cos(r2.x * 6.28318 + t * 1.5 + s2 * 6.28));\nlet layer_mid = c2 * stroke(corner, 0.012) * 0.7 + c4 * stroke(wave2, 0.01) * 0.6 + c4 * fill(sd_circle(r2 - vec2<f32>(-0.3, 0.25), 0.03));\nlet g3 = p * 1.2 * density + vec2<f32>(t * 0.15, t * 0.02);\nlet k3 = floor(g3);\nlet f3 = fract(g3) - 0.5;\nlet s3 = hash(k3);\nlet r3 = rotate(f3, t * 0.1 * spin_speed);\nlet orbit = vec2<f32>(cos(t * 0.5 + s3 * 6.28), sin(t * 0.5 + s3 * 6.28)) * 0.28;\nlet squash3 = 1.0 + morph_amount * 0.5 * sin(t * 0.6 + s3 * 6.28);\nlet ring3 = stroke(sd_circle(vec2<f32>(r3.x, r3.y * squash3), 0.26), 0.014);\nlet atom = sd_circle(r3 - orbit, 0.035);\nlet layer_near = c3 * ring3 * 0.6 + c1 * fill(atom) + c1 * halo(atom, 0.08) * 0.4;\nlet glow = layer_far + layer_mid * 0.9 + layer_near * 0.8;\nlet vign = clamp(1.0 - 0.6 * dot(p, p), 0.3, 1.0);\nlet tint = tonemap(glow * vign * 1.2);\nreturn mix(bg, tint, strength);",
