      "custom": {
        "expression": "let wave_a = 0.28 + 0.03 * sin(p.x * 4.0 + t * 0.5);\nlet wave_b = 0.02 + 0.04 * sin(p.x * 3.0 - t * 0.35 + 1.3);\nlet wave_c = -0.24 + 0.05 * sin(p.x * 2.2 + t * 0.25 + 2.0);\nlet edge_a = smoothstep(-0.02, 0.02, p.y - wave_a);\nlet edge_b = smoothstep(-0.02, 0.02, p.y - wave_b);\nlet edge_c = smoothstep(-0.02, 0.02, p.y - wave_c);\nlet deep = mix(c4 * 0.5, c4 * 0.9, clamp(p.y + 0.5, 0.0, 1.0));\nlet body = mix(deep, c1 * 0.45, edge_c);\nlet body2 = mix(body, c1 * 0.7, edge_b);\nlet water = mix(body2, c2 * 0.5, edge_a);\nlet crest = stroke(abs(p.y - wave_a), 0.015) * 0.5 + stroke(abs(p.y - wave_b), 0.012) * 0.35;\nlet rays = pow(abs(sin(p.x * 5.0 + sin(t * 0.3) * 2.0 + p.y)), 14.0) * smoothstep(-0.2, 0.4, p.y) * 0.15;\nlet g1 = p * 5.0 + vec2<f32>(0.0, -t * 0.35);\nlet cell1 = floor(g1);\nlet on1 = step(1.0 - 0.5 * bubble_density, hash(cell1));\nlet r1 = 0.12 + 0.06 * hash(cell1 + vec2<f32>(3.1, 7.7));\nlet d1 = sd_circle(fract(g1) - 0.5 - (hash2(cell1) - 0.5) * 0.5, r1);\nlet b1 = (stroke(d1, 0.025) * 0.9 + fill(d1) * 0.12) * on1;\nlet g2 = p * 10.0 + vec2<f32>(0.0, -t * 0.22);\nlet cell2 = floor(g2);\nlet on2 = step(1.0 - 0.5 * bubble_density, hash(cell2 + vec2<f32>(11.0, 2.0)));\nlet r2 = 0.10 + 0.05 * hash(cell2 + vec2<f32>(5.3, 1.9));\nlet d2 = sd_circle(fract(g2) - 0.5 - (hash2(cell2) - 0.5) * 0.5, r2);\nlet b2 = (stroke(d2, 0.03) * 0.7 + fill(d2) * 0.1) * on2;\nlet g3 = p * 18.0 + vec2<f32>(0.0, -t * 0.12);\nlet cell3 = floor(g3);\nlet on3 = step(1.0 - 0.5 * bubble_density, hash(cell3 + vec2<f32>(4.0, 9.0)));\nlet r3 = 0.08 + 0.04 * hash(cell3 + vec2<f32>(8.2, 3.3));\nlet d3 = sd_circle(fract(g3) - 0.5 - (hash2(cell3) - 0.5) * 0.5, r3);\nlet b3 = (stroke(d3, 0.04) * 0.5 + fill(d3) * 0.08) * on3;\nlet scene = water + c3 * crest + c3 * rays + c3 * b1 * 0.5 + c3 * b2 * 0.35 + c2 * b3 * 0.3;\nreturn mix(bg, tonemap(scene), strength);",
