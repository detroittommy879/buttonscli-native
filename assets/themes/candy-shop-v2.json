      "custom": {
        "expression": "let drift = p * vec2<f32>(1.4 + amount * 0.18) + vec2<f32>(0.07 * t, 0.10 * t);\nlet q = drift + vec2<f32>(0.13 * sin(drift.y * 2.0 + t * 0.3), 0.12 * cos(drift.x * 1.7 - t * 0.25));\nlet cell = floor(q);\nlet seed = hash(cell);\nlet uv = fract(q) - vec2<f32>(0.5);\nlet angle = seed * 6.283 + 0.18 * sin(t * 0.4 + seed * 9.0);\nlet v = vec2<f32>(uv.x * cos(angle) - uv.y * sin(angle), uv.x * sin(angle) + uv.y * cos(angle));\nlet radius = length(v * vec2<f32>(1.0, 1.35));\nlet theta = atan2(v.y, v.x);\nlet wobble = 0.023 * sin(theta * 5.0 + t * 1.1 + seed * 12.0);\nlet edge = abs(radius - 0.27 - wobble);\nlet membrane = exp(-edge * 95.0);\nlet halo = exp(-edge * 18.0);\nlet inside = 1.0 - smoothstep(0.21, 0.29 + wobble, radius);\nlet hue = seed + theta * 0.12 + t * 0.035 + noise(q * vec2<f32>(3.0)) * 0.16;\nlet neon = hsv(fract(hue), 0.94, 1.0);\nlet eyes = min(length(v - vec2<f32>(-0.07, 0.045)), length(v - vec2<f32>(0.07, 0.045)));\nlet eyeGlow = 1.0 - smoothstep(0.014, 0.032, eyes);\nlet blink = smoothstep(0.97, 0.995, sin(t * 0.65 + seed * 25.0));\nlet grain = hash(floor(p * vec2<f32>(430.0))) - 0.5;\nlet fog = cloud(p * vec2<f32>(1.7) + vec2<f32>(t * 0.025, -t * 0.02));\nlet background = vec3<f32>(0.006, 0.009, 0.019) + mix(c1, c3, fog) * vec3<f32>(0.025 * fog);\nlet body = neon * vec3<f32>(0.68 * membrane + 0.065 * halo + 0.025 * inside);\nlet face = mix(neon, vec3<f32>(0.55, 0.85, 1.0), 0.6) * vec3<f32>(eyeGlow * 0.36 * (1.0 - blink));\nreturn clamp(background + body + face + vec3<f32>(grain * 0.009), vec3<f32>(0.0), vec3<f32>(1.0));",
