      "custom": {
        "expression": "let rows = floor(p.y * 140.0);\nlet frame = floor(t * 24.0);\nlet line_noise = hash(vec2<f32>(rows, frame));\nlet grain = hash(floor(p * vec2<f32>(260.0, 150.0)) + vec2<f32>(frame * 7.0, 0.0));\nlet thresh = mix(0.9, 0.45, snow_amount);\nlet snow = smoothstep(thresh, thresh + 0.08, grain * (0.4 + 0.6 * line_noise));\nlet snow_color = mix(mix(c1, c2, line_noise), c3, grain);\nlet roll_y = fract(p.y * 0.6 - t * roll_speed);\nlet bar = smoothstep(0.0, 0.2, roll_y) * (1.0 - smoothstep(0.6, 0.9, roll_y));\nlet picture = mix(c4, c5, 0.5 + 0.5 * sin(p.x * 3.0 + t * 0.3 + p.y * 2.0));\nlet blob = 1.0 - smoothstep(0.0, 0.35, length((p - vec2<f32>(0.1 * sin(t * 0.2), 0.05)) * vec2<f32>(1.0, 1.6)));\nlet base = picture * (0.25 + 0.5 * blob + 0.35 * bar);\nlet tear = smoothstep(0.96, 0.99, hash(vec2<f32>(floor(p.y * 8.0), frame + 11.0)));\nlet scan = 0.8 + 0.2 * sin(p.y * 420.0);\nlet lit = base + snow * snow_color * 0.9 + tear * c3 * 0.6;\nlet color = tonemap(lit * scan);\nreturn mix(bg, color, strength);",
