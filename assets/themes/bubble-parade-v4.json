      "custom": {
        "expression": "let x1 = p.x + t * 0.05;\nlet x2 = p.x + t * 0.12;\nlet x3 = p.x + t * 0.22;\nlet sky = mix(c4, c1 * 0.6, smoothstep(-0.5, 0.5, p.y));\nlet g = vec2<f32>(p.x * 5.0 + t * 0.15, p.y * 4.0 + sin(t * 0.3) * 0.2);\nlet cell = floor(g);\nlet seed = hash(cell);\nlet r = ring_size * (0.7 + 0.3 * sin(t * 0.9 + seed * 6.28));\nlet dc = sd_circle(fract(g) - 0.5, r);\nlet rings = stroke(dc, 0.012) + fill(dc) * 0.25;\nlet ring_col = mix(c3, c5, seed) * rings * 0.9;\nlet h1 = -0.08 + 0.07 * sin(x1 * 6.0 + 1.0) + 0.03 * cos(x1 * 13.0 - t * 0.8);\nlet band1 = fill(p.y - h1);\nlet far = mix(c2 * 0.7, c1, 0.5 + 0.5 * sin(x1 * 3.0));\nlet h2 = -0.22 + wave_amp * sin(x2 * 4.0 - t * 0.5) + wave_amp * 0.5 * cos(x2 * 9.0 + t * 0.7);\nlet band2 = fill(p.y - h2);\nlet mid = mix(c2, c3 * 0.6, 0.5 + 0.5 * cos(x2 * 2.0));\nlet crest = stroke(p.y - h2, 0.008) * c5;\nlet h3 = -0.36 + wave_amp * 1.2 * sin(x3 * 3.0 + 2.0);\nlet band3 = fill(p.y - h3);\nlet near = mix(c4, c1, 0.4);\nlet base = sky + ring_col;\nlet s1 = mix(base, far, band1);\nlet s2 = mix(s1, mid, band2) + crest;\nlet s3 = mix(s2, near, band3);\nlet lit = tonemap(s3 * 1.2);\nreturn mix(bg, lit, strength);",
        "name": "Tide and Orbits",
