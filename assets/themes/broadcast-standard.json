      "custom": {
        "expression": "let col_idx = clamp(floor((p.x + 0.9) * 3.9), 0.0, 6.0);\nlet ph = col_idx / 6.0;\nlet bars_c = mix(mix(c1, c2, smoothstep(0.0, 0.4, ph)), mix(c3, c5, smoothstep(0.5, 0.9, ph)), smoothstep(0.35, 0.55, ph));\nlet lower_c = mix(c4, c1, step(0.5, fract(col_idx * 0.5)));\nlet lower = 1.0 - smoothstep(-0.365, -0.355, p.y);\nlet bars_all = mix(bars_c, lower_c, lower);\n\nlet wrap = fract(p.y * 0.6 + t * roll_speed);\nlet roll = 0.7 + 0.3 * smoothstep(0.0, 0.3, wrap);\nlet field = floor(t * 24.0);\nlet line = floor((p.y + 0.5) * 450.0);\nlet interlace = 0.9 + 0.1 * cos(3.14159 * (line + field));\nlet scan = 0.92 + 0.08 * cos(p.y * 5654.8668);\nlet base = bars_all * roll * scan * interlace;\n\nlet y0 = 0.5 - fract(t * 0.13);\nlet w = 1.0 - smoothstep(0.0, 0.05, abs(p.y - y0));\nlet n = hash(floor(p * vec2<f32>(140.0, 70.0)) + vec2<f32>(field * 3.1, 0.0));\nlet static_tint = mix(c4, c2, n);\nlet color_a = mix(base, static_tint, w * noise_amount * 0.8);\n\nlet frame = stroke(sd_box(p - vec2<f32>(-0.62, 0.36), vec2<f32>(0.12, 0.07)), 0.012);\nlet blink = step(0.5, fract(t * 0.8));\nlet lamp = fill(sd_circle(p - vec2<f32>(-0.5, 0.36), 0.02)) * blink;\nlet color_b = mix(color_a, c1, frame * 0.9);\nlet color = mix(color_b, c5, lamp);\nreturn mix(bg, tonemap(color * 1.3), strength);",
