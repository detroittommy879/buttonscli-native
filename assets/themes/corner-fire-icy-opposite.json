    "shaderLabFragmentShader": "precision mediump float;\n\nuniform sampler2D u_composite;\nuniform vec2 u_resolution;\nuniform vec2 u_texel;\nuniform float u_time;\nuniform float u_strength;\n\nvec2 shaderLabUv() {\n  return vec2(\n    gl_FragCoord.x / u_resolution.x,\n    1.0 - gl_FragCoord.y / u_resolution.y\n  );\n}\n\nvec4 sampleComposite(vec2 uv) {\n  return texture2D(u_composite, clamp(uv, vec2(0.0), vec2(1.0)));\n}\n\nvoid main() {\n  vec2 uv = shaderLabUv();\n  float wave = sin((uv.x + u_time * 0.1) * 10.0) * 0.01 * u_strength;\n  float distortion = sin((uv.y + u_time * 0.05) * 5.0) * 0.02 * u_strength;\n  vec2 distortedUv = uv + vec2(distortion, wave);\n  vec4 color = sampleComposite(distortedUv);\n  color.rgb += (sin((uv.x + uv.y + u_time) * 5.0) * 0.05 + 0.05) * u_strength;\n  gl_FragColor = color;\n}",
