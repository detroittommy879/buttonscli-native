      "custom": {
        "expression": "let ow = outline_w;\nlet g1 = p * 3.0 + vec2<f32>(t * 0.06 * drift, 0.0);\nlet k1 = floor(g1);\nlet f1 = fract(g1) - 0.5;\nlet h1 = hash(k1);\nlet r1 = rotate(f1, t * spin * (0.25 + 0.5 * h1) + h1 * 6.28);\nlet ba = vec2<f32>(0.1 * (0.8 + 0.2 * sin(t + h1 * 9.0)), 0.0);\nlet mol = min(min(sd_circle(r1 - ba, 0.035), sd_circle(r1 + ba, 0.035)), sd_segment(r1, -ba, ba) - 0.012);\nlet c_far = mix(c4, c5, h1);\nvar col = bg;\ncol = mix(col, c_far, fill(mol));\ncol = mix(col, bg, stroke(mol, ow * 0.6));\nlet g2 = p * 2.0 + vec2<f32>(-t * 0.12 * drift, 0.0);\nlet k2 = floor(g2);\nlet f2 = fract(g2) - 0.5;\nlet h2 = hash(k2);\nlet m2 = 0.3 * sin(t * 0.8 * spin + h2 * 6.28);\nlet q2 = f2 * vec2<f32>(1.0 + m2, 1.0 - m2);\nlet oval = sd_circle(q2, 0.15 + 0.03 * h2);\ncol = mix(col, mix(c2, c3, h2), fill(oval));\ncol = mix(col, bg, stroke(oval, ow * 0.6));\nlet wave = stroke(p.y + 0.2 - 0.08 * cos(p.x * 14.0 + t * 1.5 * spin), ow * 0.5);\ncol = mix(col, c1, wave);\nlet dotw = sd_circle(p - vec2<f32>(0.35, -0.12 + 0.03 * sin(t * spin * 2.0)), 0.03);\ncol = mix(col, c4, fill(dotw));\nlet g3 = p * 1.4 + vec2<f32>(t * 0.2 * drift, 0.0);\nlet k3 = floor(g3);\nlet f3 = fract(g3) - 0.5;\nlet h3 = hash(k3);\nlet r3 = rotate(f3, sin(t * 0.5 * spin + h3 * 6.28) * 0.6 + floor(h3 * 4.0) * 1.5708);\nlet corner = min(sd_box(r3 - vec2<f32>(-0.08, -0.17), vec2<f32>(0.2, 0.05)), sd_box(r3 - vec2<f32>(-0.22, -0.02), vec2<f32>(0.05, 0.2)));\nlet spark = sd_circle(r3 - vec2<f32>(0.2, 0.2), 0.05 + 0.03 * h3);\nlet sym = min(corner, spark);\ncol = mix(col, mix(c1, c3, h3 * 0.5), fill(sym));\ncol = mix(col, bg, stroke(sym, ow * 0.6));\nreturn mix(bg, col, strength);",
