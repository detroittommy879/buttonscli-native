      "custom": {
        "expression": "let dir = normalize(vec2<f32>(0.82, -0.57));\nlet perp = vec2<f32>(-dir.y, dir.x);\nlet tex = ridged(vec2<f32>(dot(p, perp) * 8.0, dot(p, dir) * 2.0 - t * 1.8));\nvar acc = vec3<f32>(0.0);\n\nfor (var i = 0; i < 5; i++) {\n    let k = f32(i);\n    let s1 = hash(vec2<f32>(k, 2.3));\n    let s2 = hash(vec2<f32>(k, 9.1));\n    let ph = fract(t * (0.20 + 0.22 * s2) * comet_speed + s1);\n    let lane = -0.75 + 1.5 * s2 + 0.08 * sin(t * 0.4 + k * 1.9);\n    let head = perp * lane + dir * (ph * 3.8 - 1.9);\n    let rel = p - head;\n    let along = dot(rel, dir);\n    let acr = dot(rel, perp);\n    let w = 0.011 + 0.010 * s1;\n    let tlen = tail_length * (0.8 + 0.7 * s2);\n    let acn = acr / w;\n    let back = max(-along, 0.0);\n    let body = exp(-acn * acn) * exp(-back * 2.3 / tlen) * exp(-max(along, 0.0) * 26.0);\n    let hot = exp(-dot(rel, rel) * 85.0);\n    let u = clamp(back / tlen, 0.0, 1.0);\n    let tint = mix(mix(c4, c1, smoothstep(0.0, 0.25, u)), c2, smoothstep(0.25, 1.0, u));\n    acc += tint * (body + hot * 2.0);\n}\n\nlet pf = p * 2.0 + vec2<f32>(3.7, 1.3);\nfor (var j = 0; j < 5; j++) {\n    let m = f32(j);\n    let m1 = hash(vec2<f32>(m, 4.7));\n    let m2 = hash(vec2<f32>(m, 12.9));\n    let phb = fract(t * (0.10 + 0.12 * m2) * comet_speed + m1);\n    let lane2 = -0.85 + 1.7 * m2 + 0.06 * sin(t * 0.25 + m * 2.4);\n    let head2 = perp * lane2 + dir * (phb * 3.6 - 1.8);\n    let rel2 = pf - head2;\n    let along2 = dot(rel2, dir);\n    let acr2 = dot(rel2, perp);\n    let w2 = 0.012 + 0.008 * m1;\n    let tlen2 = tail_length * (0.6 + 0.5 * m2);\n    let acn2 = acr2 / w2;\n    let back2 = max(-along2, 0.0);\n    let body2 = exp(-acn2 * acn2) * exp(-back2 * 2.6 / tlen2) * exp(-max(along2, 0.0) * 26.0);\n    let hot2 = exp(-dot(rel2, rel2) * 110.0);\n    let u2 = clamp(back2 / tlen2, 0.0, 1.0);\n    let tint2 = mix(mix(c3, c2, smoothstep(0.0, 0.6, u2)), c5 * 1.8, smoothstep(0.5, 1.0, u2));\n    acc += tint2 * body2 * 0.65 + c2 * hot2 * 0.7;\n}\n\nlet veil = mix(c3, c2, tex) * tex * tex * 0.55;\nlet wash = mix(c3 * 0.14, c2 * 0.07, smoothstep(-0.5, 0.5, p.y));\nlet sharp = 0.55 + 0.85 * tex;\nlet vign = 0.78 + 0.22 * (1.0 - smoothstep(0.45, 1.15, length(p)));\nlet scene = (wash + veil + acc * sharp * glow) * vign;\nreturn mix(bg, tonemap(scene * 1.45), strength);",
