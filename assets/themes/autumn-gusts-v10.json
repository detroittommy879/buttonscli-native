        "expression": "let x = p.x * frequency;\nlet phase = x - t * 1.3;\nlet fundamental = sin(phase);\nlet overtone = sin(x * harmonic_ratio + t * 1.1);\nlet beat = sin(x * 0.47 - t * 0.6);\nlet y1 = 0.46 * fundamental + 0.14 * overtone;\nlet y2 = 0.46 * overtone - 0.14 * fundamental;\nlet y3 = 0.32 * sin(phase + overtone * 1.6) + 0.23 * beat;\nlet d1 = abs(p.y - y1);\nlet d2 = abs(p.y - y2);\nlet d3 = abs(p.y - y3);\nlet ribbon1 = exp(-pow(d1 / ribbon_width, 2.0));\nlet ribbon2 = exp(-pow(d2 / ribbon_width, 2.0));\nlet ribbon3 = exp(-pow(d3 / (ribbon_width * 0.75), 2.0));\nlet halo = exp(-d1 * 3.0) + exp(-d2 * 3.0) + exp(-d3 * 3.0);\nlet weave = 0.5 + 0.5 * sin(x * 0.55 + p.y * 2.3 + t * 0.3);\nlet base = mix(c4, c1, weave) * vec3<f32>(0.24 + 0.08 * beat);\nlet bead_x = (fract((x - t * 1.3) / 6.283185 + 0.25) - 0.5) * 6.283185 / frequency;\nlet beads = exp(-(bead_x * bead_x + d1 * d1) / 0.008);\nlet stripes = 0.82 + 0.18 * sin(p.y * 70.0 + x * 3.0 - t * 4.0);\nlet color = base + mix(c1, c4, weave) * vec3<f32>(halo * 0.11)\n    + c1 * vec3<f32>(ribbon1 * stripes * 0.68)\n    + c2 * vec3<f32>(ribbon2 * stripes * 0.68)\n    + c3 * vec3<f32>(ribbon3 * 0.65)\n    + c5 * vec3<f32>(beads * 0.5);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
