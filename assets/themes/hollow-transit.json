        "expression": "let r = length(p);\nlet angle = atan2(p.y, p.x);\nlet sector = (angle + 3.141593) * 120.0 / 6.283186;\nlet lane = floor(sector);\nlet seed = hash(vec2<f32>(lane, 17.0));\nlet offset = 0.2 + 0.6 * hash(vec2<f32>(lane, 31.0));\nlet filament = exp(-pow(abs(fract(sector) - offset) * 13.0, 2.0));\nlet phase = fract(r * r * 0.65 + t * warp_speed * (0.3 + seed * 0.55) + seed);\nlet tail = pow(phase, 12.0);\nlet head = exp(-pow((phase - 0.94) * 38.0, 2.0));\nlet streaks = filament * (0.65 * tail + 0.65 * head) * (0.35 + 0.65 * seed);\nlet bend = 0.035 * sin(angle * 5.0 + t * 0.37) + 0.018 * sin(angle * 9.0 - t * 0.23);\nlet ring_radius = 0.39 + 0.025 * sin(t * 0.9);\nlet ring_distance = abs(r - ring_radius - bend);\nlet ring = exp(-ring_distance * 45.0) * ring_glow * (0.6 + 0.4 * sin(angle * 3.0 + t * 0.6));\nlet haze = cloud(p * 1.6 + vec2<f32>(t * 0.025, -t * 0.018));\nlet atmosphere = mix(c1, c3, 0.3 + 0.4 * haze) * (0.19 + 0.19 * haze);\nlet star_color = mix(c1, c2, seed);\nlet outer = atmosphere + star_color * streaks + mix(c3, c4, 0.3) * ring * 0.65;\nlet aperture = smoothstep(0.14, 0.29, r);\nlet color = clamp(outer * aperture, vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
