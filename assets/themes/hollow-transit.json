      "custom": {
        "expression": "let r = length(p);\nlet warp = 0.6 * sin(p.x * 9.0 + t * 0.4) + 0.4 * sin(p.y * 13.0 - t * 0.3);\nlet rings = 0.5 + 0.5 * sin(r * 46.0 * ripple_scale - t * 2.2 + warp * 2.0);\nlet fade = exp(-r * 2.2);\nlet water = mix(c4, c3, 0.3 + 0.3 * sin(p.y * 3.0 + t * 0.2 + warp));\nlet ripple_light = mix(c3, c5, rings) * rings * rings * fade * 0.9;\nvar koi_col = vec3<f32>(0.0, 0.0, 0.0);\nfor (var i = 0; i < 8; i++) {\n    let k = f32(i);\n    let seed = hash(vec2<f32>(k, 3.0));\n    let ang = t * koi_speed * (0.6 + 0.4 * seed) + k * 0.785;\n    let ax = 0.45 + 0.25 * seed;\n    let ay = 0.25 + 0.12 * fract(seed * 7.0);\n    let pos = vec2<f32>(ax * cos(ang), ay * sin(2.0 * ang));\n    let vel = vec2<f32>(-ax * sin(ang), 2.0 * ay * cos(2.0 * ang));\n    let heading = atan2(vel.y, vel.x);\n    let local = rotate(p - pos, -heading);\n    let wiggle = 0.015 * sin(local.x * 40.0 - t * 6.0 * koi_speed);\n    let lp = vec2<f32>(local.x, local.y - wiggle);\n    let shape = length(lp / vec2<f32>(0.07 * koi_size, 0.022 * koi_size)) - 1.0;\n    let d = shape * 0.022 * koi_size;\n    let tint = mix(c1, c2, step(0.5, seed));\n    let body = 1.0 - smoothstep(-0.004, 0.004, d);\n    let aura = halo(d, 0.06) * 0.8;\n    koi_col += tint * (body * 1.2 + aura);\n}\nlet color = tonemap(water + ripple_light + koi_col);\nreturn mix(bg, color, strength);",
