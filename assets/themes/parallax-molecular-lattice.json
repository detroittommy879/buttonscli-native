      "custom": {
        "expression": "let tt = t * drift_speed;\nlet g1 = p * 3.0 + vec2<f32>(tt * 0.06, tt * 0.02);\nlet k1 = floor(g1);\nlet s1 = hash(k1);\nlet l1 = fract(g1) - 0.5;\nlet r1 = rotate(l1, tt * (0.2 + 0.3 * s1) + s1 * 6.283);\nlet bond1 = sd_segment(r1, vec2<f32>(-0.12, 0.0), vec2<f32>(0.12, 0.0));\nlet atoms1 = fill(min(sd_circle(r1 - vec2<f32>(-0.12, 0.0), 0.035), sd_circle(r1 - vec2<f32>(0.12, 0.0), 0.035)));\nlet morph = 0.3 + 0.05 * sin(tt * 0.8 + s1 * 6.283);\nlet ring1 = stroke(abs(length(l1 * vec2<f32>(1.0, 1.6)) - morph), 0.008);\nlet near = (atoms1 * c3 + stroke(bond1, 0.01) * c1 * 0.8 + ring1 * c2 * 0.6) * glow;\nlet g2 = p * 6.0 + vec2<f32>(-tt * 0.03, tt * 0.01);\nlet k2 = floor(g2);\nlet s2 = hash(k2);\nlet l2 = fract(g2) - 0.5;\nlet wave = abs(l2.y - 0.15 * cos(l2.x * 12.0 + tt * 0.8 + s2 * 6.283));\nlet corner = min(sd_segment(l2, vec2<f32>(-0.2, -0.2), vec2<f32>(0.2, -0.2)), sd_segment(l2, vec2<f32>(-0.2, -0.2), vec2<f32>(-0.2, 0.2)));\nlet sym = select(wave, corner, s2 > 0.5);\nlet mask2 = select(1.0 - smoothstep(0.3, 0.5, abs(l2.x)), 1.0, s2 > 0.5);\nlet mid = stroke(sym, 0.006) * mask2 * (0.6 + 0.4 * sin(tt * 0.6 + s2 * 6.283));\nlet g3 = p * 9.0 + vec2<f32>(tt * 0.02, 0.0);\nlet k3 = floor(g3);\nlet s3 = hash(k3);\nlet l3 = fract(g3) - 0.5;\nlet dot3 = halo(sd_circle(l3 - vec2<f32>(-0.15, 0.0), 0.03), 0.02);\nlet line3 = stroke(sd_segment(l3, vec2<f32>(-0.15, 0.0), vec2<f32>(0.25, 0.12)), 0.005);\nlet far = (dot3 + line3 * 0.6) * step(0.3, s3);\nlet wash = mix(bg * 0.8, c4 * 0.10 + c2 * 0.06, smoothstep(-0.5, 0.5, p.y));\nlet color = wash + (near + mid * c4 * 0.7 + far * c5 * 0.5) * 0.9;\nlet shaded = color * (1.0 - 0.3 * dot(p, p));\nreturn mix(bg, tonemap(shaded), strength);",
