      "custom": {
        "expression": "let tt = t * speed;\nlet sky = mix(bg, c4 * 0.3, smoothstep(-0.5, 0.5, p.y));\nvar glow = vec3<f32>(0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let s = (4.0 - k) * density;\n    let g = p * s + vec2<f32>(tt * (0.05 + 0.03 * k), -tt * (0.04 + 0.04 * k));\n    let cell = floor(g);\n    let h = hash(cell + vec2<f32>(k * 17.0, 3.0));\n    let kind = floor(h * 4.0);\n    let spin = sin(tt * 0.5 + h * 6.28) * 0.4;\n    let q = rotate(fract(g) - 0.5, spin) / shape_size;\n    let ph = tt * 1.5 + h * 6.28;\n    let head = sd_circle(q, 0.13 + 0.02 * sin(ph));\n    let ear_d = max((abs(abs(q.x) - 0.09) * 0.1 + (q.y - 0.08) * 0.06 - 0.006) / 0.117, 0.08 - q.y);\n    let cat_l = 1.0 - smoothstep(0.008, 0.02, abs(min(head, ear_d)));\n    let dot_l = 1.0 - smoothstep(-0.005, 0.005, sd_circle(q - vec2<f32>(-0.3, 0.0), 0.05));\n    let line_d = max(abs(q.y), abs(q.x) - 0.25);\n    let line_l = 1.0 - smoothstep(0.006, 0.014, line_d);\n    let wy = 0.1 * cos(q.x * 18.0 + ph);\n    let wave_d = max(abs(q.y - wy), abs(q.x) - 0.3);\n    let wave_l = 1.0 - smoothstep(0.006, 0.014, wave_d);\n    let vd = max(abs(q.x + 0.15), abs(q.y) - 0.15);\n    let hd = max(abs(q.y + 0.15), abs(q.x) - 0.15);\n    let corner_l = 1.0 - smoothstep(0.006, 0.014, min(vd, hd));\n    let w0 = 1.0 - step(0.5, kind);\n    let w1 = step(0.5, kind) * (1.0 - step(1.5, kind));\n    let w2 = step(1.5, kind) * (1.0 - step(2.5, kind));\n    let w3 = step(2.5, kind);\n    let light = (w0 * cat_l + w1 * max(dot_l, line_l) + w2 * wave_l + w3 * corner_l) * (0.7 + 0.3 * sin(ph));\n    let col = mix(c1, c2, fract(h * 3.0));\n    let bright = 0.35 + 0.3 * k;\n    glow += col * light * bright;\n}\nreturn mix(bg, tonemap(sky + glow * 1.1), strength);",
