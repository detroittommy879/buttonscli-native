      "custom": {
        "expression": "let tt = t * wave_speed;\nlet grid = abs(fract(p * vec2<f32>(10.0, 6.0)) - 0.5);\nlet grid_line = smoothstep(0.46, 0.5, max(grid.x, grid.y));\nlet base = mix(bg, c4, smoothstep(-0.5, 0.5, p.y) * 0.8) + c2 * grid_line * 0.08;\nvar glow_col = vec3<f32>(0.0);\nfor (var i = 0; i < 4; i++) {\n    let k = f32(i);\n    let f = 1.0 + k * 0.6;\n    let x = p.x * 3.14159 * f + tt * (0.6 + 0.3 * k);\n    let amp = 0.16 - 0.025 * k;\n    let fund = sin(x + k * 1.7);\n    let h2 = sin(2.0 * x - tt * 0.9 + k) * harmonic_mix * 0.45;\n    let h3 = sin(3.0 * x + tt * 0.4) * harmonic_mix * 0.2;\n    let y = (fund + h2 + h3) * amp;\n    let d = abs(p.y - y);\n    let wave_line = 1.0 - smoothstep(0.0015, 0.0045, d);\n    let bloom = exp(-d * 30.0) * 0.5;\n    let tint = mix(mix(c1, c2, smoothstep(0.5, 1.5, k)), mix(c3, c5, smoothstep(2.5, 3.0, k)), smoothstep(1.5, 2.5, k));\n    glow_col += tint * (wave_line + bloom);\n}\nreturn mix(bg, tonemap(base + glow_col * 1.3), strength);",
        "name": "Harmonic Wave",
        "variables": [
          {
            "max": 2.0,
            "min": 0.20000000298023224,
            "name": "wave_speed",
            "value": 1.0
          },
