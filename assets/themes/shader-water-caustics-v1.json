      "custom": {
        "expression": "let bgwash = mix(c4 * 0.45, c2 * 0.12, smoothstep(-0.5, 0.5, p.y));\nvar acc = vec3<f32>(0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let scale = 7.0 - k * 2.0;\n    let speed = 0.05 + 0.08 * k;\n    let g = p * scale + vec2<f32>(t * speed, 0.2 * sin(t * 0.3 + k));\n    let cell = floor(g);\n    let seed = hash(cell + vec2<f32>(k * 17.0, 3.0));\n    let dir = select(-1.0, 1.0, seed > 0.5);\n    let ang = seed * 6.28 + t * (0.3 + seed) * dir;\n    let q = rotate(fract(g) - 0.5, ang);\n    let morph = 0.5 + 0.5 * sin(t * morph_speed + seed * 12.0);\n    let r = 0.12 + 0.07 * hash(cell * 1.7);\n    let oval = length(q * vec2<f32>(1.0, 1.6 + 0.8 * morph)) - r;\n    let corner = min(sd_segment(q, vec2<f32>(-r, -r), vec2<f32>(r, -r)), sd_segment(q, vec2<f32>(-r, -r), vec2<f32>(-r, r))) - 0.02;\n    let dotline = min(sd_circle(q - vec2<f32>(-r * 1.2, 0.0), r * 0.35), sd_segment(q, vec2<f32>(-r * 0.6, 0.0), vec2<f32>(r * 1.4, 0.0)) - 0.02);\n    let wave = abs(q.y - 0.12 * cos(q.x * 18.0 + t * 2.0 + seed * 6.28)) - 0.02;\n    let d1 = mix(oval, corner, morph);\n    let d2 = mix(dotline, wave, 1.0 - morph);\n    let d = mix(d1, d2, smoothstep(0.4, 0.6, hash(cell + vec2<f32>(5.0, 1.0))));\n    let tint = mix(mix(c1, c2, hash(cell * 3.1)), c5, step(0.85, seed));\n    let glow = fill(d) * c3 * 0.6 + halo(d, 0.04) * tint * 0.5;\n    acc += (tint * fill(d) + glow) * (0.5 + 0.3 * k);\n}\nreturn mix(bg, tonemap(bgwash + acc), strength);",
