        "expression": "let x = p.x * (3.0 + amount * 0.65);\nlet drift = t * 0.7;\nlet envelope = 0.18 + 0.52 * noise(vec2<f32>(p.x * 1.2 - t * 0.3, t * 0.18));\nlet a = envelope * (0.68 * sin(x * 4.1 + drift + noise(vec2<f32>(x * 0.8, t * 0.6)) * 12.0) + 0.32 * sin(x * 11.3 - t * 2.0));\nlet b = envelope * (0.65 * sin(x * 3.7 - drift + noise(vec2<f32>(x * 0.9 + 17.0, t * 0.5)) * 14.0) + 0.35 * cos(x * 9.7 + t * 1.5));\nlet d = envelope * (0.72 * cos(x * 4.8 + drift + noise(vec2<f32>(x * 0.7 + 31.0, t * 0.4)) * 11.0) + 0.28 * sin(x * 13.1 - t * 1.8));\nlet da = abs(p.y - a);\nlet db = abs(p.y - b);\nlet dd = abs(p.y - d);\nlet lineA = 0.62 * exp(-da * 170.0) + 0.085 * exp(-da * 22.0);\nlet lineB = 0.58 * exp(-db * 190.0) + 0.075 * exp(-db * 25.0);\nlet lineC = 0.55 * exp(-dd * 210.0) + 0.07 * exp(-dd * 28.0);\nlet colorA = hsv(fract(0.48 + p.x * 0.035 + t * 0.018), 0.92, 1.0);\nlet colorB = hsv(fract(0.89 - p.x * 0.04 - t * 0.014), 0.95, 1.0);\nlet colorC = hsv(fract(0.08 + p.x * 0.025 + t * 0.012), 0.96, 1.0);\nlet gridPos = abs(fract(p * vec2<f32>(6.0, 9.0) + vec2<f32>(0.5)) - vec2<f32>(0.5));\nlet grid = exp(-min(gridPos.x, gridPos.y) * 140.0);\nlet base = mix(c1, c3, 0.5 + 0.5 * sin(p.x * 0.6)) * vec3<f32>(0.022) + c2 * vec3<f32>(grid * 0.012);\nlet signal = colorA * vec3<f32>(lineA) + colorB * vec3<f32>(lineB) + colorC * vec3<f32>(lineC);\nreturn clamp(base + signal, vec3<f32>(0.0), vec3<f32>(0.8));",
