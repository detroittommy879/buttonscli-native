      "custom": {
        "expression": "let period = floor(t * 0.5);\nlet within = fract(t * 0.5);\nlet roll = hash(vec2<f32>(period, 7.0));\nlet flash = exp(-within * 6.0) * step(0.45, roll) * flash_power;\nlet bx = (hash(vec2<f32>(period, 2.0)) - 0.5) * 1.2;\nlet jag = (noise(vec2<f32>(p.y * 9.0, period)) - 0.5) * 0.3;\nlet bd = abs(p.x - bx - jag);\nlet bolt = smoothstep(0.012, 0.0, bd) * smoothstep(-0.45, 0.4, p.y) * flash;\nlet glow = exp(-bd * 10.0) * smoothstep(-0.4, 0.5, p.y) * flash;\nlet cl = fbm(p * vec2<f32>(2.5, 4.0) + vec2<f32>(t * 0.04, 0.0));\nlet cloud_mask = smoothstep(-0.2, 0.45, p.y);\nlet cloud = smoothstep(0.3, 0.75, cl) * cloud_mask;\nlet cloudcol = (mix(c1, c2, cl) * 0.9 + c3 * flash * 0.9) * cloud;\nlet sky = mix(c1 * 0.45, c2 * 0.5, smoothstep(-0.5, 0.5, p.y));\nlet horizon = c4 * 0.3 * (1.0 - smoothstep(-0.5, -0.1, p.y));\nvar rain = vec3<f32>(0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let sc = 7.0 + 6.0 * k;\n    let spd = (0.6 + 0.6 * k) * rain_speed;\n    let q = vec2<f32>(p.x * sc + k * 5.3, p.y * sc * 0.35 + t * spd);\n    let cell = floor(q);\n    let seed = hash(cell + vec2<f32>(k * 11.0, 0.0));\n    let yy = fract(q.y);\n    let dx = abs(fract(q.x) - 0.5);\n    let streak = smoothstep(0.07, 0.0, dx) * smoothstep(0.0, 0.15, yy) * smoothstep(0.85, 0.4, yy) * step(1.0 - rain_density * 0.5, seed);\n    rain += streak * mix(c3, c2, k * 0.5) * (0.35 + 0.3 * k);\n}\nlet vignette = clamp(1.1 - 0.6 * dot(p, p), 0.0, 1.0);\nlet color = tonemap((sky + horizon + cloudcol + rain * 0.9 + bolt * c3 * 2.0 + glow * c5 * 0.8) * vignette);\nreturn mix(bg, color, strength);",
