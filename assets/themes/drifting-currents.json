      "custom": {
        "expression": "let phase = t * drift_speed;\nlet wash = mix(c4 * 0.8, c2 * 0.15, smoothstep(-0.5, 0.5, p.y));\nvar col = vec3<f32>(0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let depth = 1.0 + k * 0.6;\n    let q = p * depth + vec2<f32>(phase / depth + k * 0.37, k * 0.21);\n    let cx = floor(q.x * wave_freq);\n    let wq = (cx + 0.5) / wave_freq;\n    let wl = 0.12 * sin(q.x * wave_freq * 0.8 + t * 0.7 + k * 2.1) + 0.05 * sin(q.x * wave_freq * 2.1 - t * 0.5);\n    let wc = 0.12 * sin(wq * wave_freq * 0.8 + t * 0.7 + k * 2.1) + 0.05 * sin(wq * wave_freq * 2.1 - t * 0.5);\n    let line = smoothstep(0.035, 0.0, abs(q.y - wl));\n    let gate = step(0.45, hash(vec2<f32>(cx, k)));\n    let pt = smoothstep(0.04, 0.012, length(q - vec2<f32>(wq, wc + 0.2))) * gate;\n    let ac = vec2<f32>(fract(phase * 0.25 + k * 0.33) * 2.4 - 1.2, 0.3 * sin(t * 0.5 + k * 2.0));\n    let s = alien_size / depth;\n    let alien = smin(sd_circle(p - ac, s), sd_circle(p - ac - vec2<f32>(0.0, s * 0.9), s * 0.5), s * 0.5);\n    let sp = vec2<f32>(0.7 * cos(phase * 0.6 + k * 2.0), 0.25 * sin(phase * 0.9 + k));\n    let r = rotate(p - sp, t * 0.4 * (k + 1.0));\n    let sym = smoothstep(0.006, -0.006, sd_box(r, vec2<f32>(0.02, 0.004)));\n    let lc = mix(c2, c3, k * 0.5);\n    let ec = mix(c5, c1, k * 0.5);\n    col += lc * (line * 0.7 + pt) / depth;\n    col += ec * (smoothstep(0.005, -0.005, alien) + halo(alien, s) * 0.4) / depth;\n    col += c1 * sym * 0.6 / depth;\n}\nreturn mix(bg, tonemap(wash + col), strength);",
