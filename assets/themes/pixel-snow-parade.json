        "expression": "let grain = 260.0 * grain_size;\nlet frame = floor(t * (8.0 + 18.0 * line_speed));\nlet grid = p * grain + vec2<f32>(0.0, t * line_speed * 5.0);\nlet jitter = vec2<f32>(frame * 17.0, -frame * 11.0);\nlet cell = floor(grid + jitter);\nlet rnd = hash2(cell);\nlet gray = pow(rnd.x, 1.15);\nlet tintA = mix(c1, c5, smoothstep(0.0, 0.48, rnd.y));\nlet tintB = mix(tintA, c2, smoothstep(0.45, 0.85, rnd.y));\nlet tint = mix(tintB, c3, smoothstep(0.84, 1.0, rnd.y));\nlet neutral = vec3<f32>(gray, gray, gray);\nlet snow = mix(neutral, tint * (0.35 + 1.05 * gray), chroma_level);\nlet roll = wave_height * sin(p.x * 5.0 + t * 0.18 * line_speed) + 0.2 * sin(t * 0.07 * line_speed);\nlet bandD = (p.y - roll) * 7.0;\nlet band = exp(-bandD * bandD);\nlet scan = 0.86 + 0.14 * sin(p.y * grain * 3.14159);\nlet color = (mix(c4 * 0.75, snow, 0.86 + 0.14 * band) + tint * band * 0.22) * scan;\nreturn mix(bg, tonemap(color * 1.2), strength);",
