    "shaderLabFragmentShader": "\nprecision mediump float;\n\nuniform sampler2D u_composite;\nuniform vec2 u_resolution;\nuniform vec2 u_texel;\nuniform float u_time;\nuniform float u_strength;\n\nvoid main() {\n  vec2 uv = vec2(\n    gl_FragCoord.x / u_resolution.x,\n    1.0 - gl_FragCoord.y / u_resolution.y\n  );\n\n  vec4 center = texture2D(u_composite, uv);\n  vec4 left = texture2D(u_composite, uv + vec2(-u_texel.x, 0.0));\n  vec4 right = texture2D(u_composite, uv + vec2(u_texel.x, 0.0));\n  vec4 up = texture2D(u_composite, uv + vec2(0.0, u_texel.y));\n  vec4 down = texture2D(u_composite, uv + vec2(0.0, -u_texel.y));\n\n  float surroundAlpha = (left.a + right.a + up.a + down.a) * 0.25;\n  float erosion = smoothstep(0.28, 0.95, surroundAlpha) * u_strength * 0.7;\n  float alpha = max(0.0, center.a - erosion);\n\n  gl_FragColor = vec4(center.rgb, alpha);\n}\n",
