      "custom": {
        "expression": "var yc = 0.0;\nvar glowAcc = vec3<f32>(0.0, 0.0, 0.0);\nfor (var i = 0; i < 4; i++) {\n    let k = f32(i);\n    let harm = 2.0 * k + 1.0;\n    let amp = 0.12 * wave_height / (1.0 + 0.9 * k);\n    let yk = amp * sin(p.x * harm * 9.0 - t * (1.0 + 0.6 * k) * harm * 0.5);\n    yc += yk;\n    let dk = abs(p.y - yk);\n    let tone = mix(c2, c3, k / 3.0);\n    glowAcc += tone * (exp(-dk * 80.0) * 0.35 + exp(-dk * 16.0) * 0.08);\n}\nlet dm = abs(p.y - yc);\nlet core = 1.0 - smoothstep(0.0012, 0.0035, dm);\nlet haloMain = exp(-dm * 45.0) * c1 * 0.5 + exp(-dm * 12.0) * c2 * 0.12;\nlet head = exp(-abs(p.x - (fract(t * 0.1) * 2.2 - 1.1)) * 3.0);\nlet sparkHash = hash(vec2<f32>(floor(p.x * 60.0), floor(t * 8.0)));\nlet sparks = step(1.0 - spark_density, sparkHash) * exp(-dm * 60.0) * c5;\nlet g = abs(fract(p * vec2<f32>(10.0, 6.0)) - 0.5);\nlet grid = smoothstep(0.46, 0.5, max(g.x, g.y)) * 0.05;\nlet wash = mix(c4, c2 * 0.25, 0.5 + 0.5 * sin(p.x * 2.5 + p.y * 3.0 + t * 0.05)) * 0.6;\nlet base = bg + wash + c2 * grid;\nlet lit = glowAcc + haloMain * (1.0 + head) + core * mix(vec3<f32>(1.0, 1.0, 1.0), c3, 0.3) * (0.6 + head) + sparks;\nreturn mix(bg, tonemap(base + lit), strength);",
