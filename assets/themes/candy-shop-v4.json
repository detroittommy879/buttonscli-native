      "custom": {
        "expression": "let x = p.x * (2.0 + amount * 0.55);\nlet pulse = pow(0.5 + 0.5 * sin(t * 3.8), 6.0);\nlet modA = noise(vec2<f32>(x * 0.55 - t * 0.7, t * 0.3));\nlet modB = noise(vec2<f32>(x * 0.8 + 17.0, t * 0.55));\nlet waveA = (0.2 + modA * 0.55 + pulse * 0.12) * sin(x * 10.0 + t * 3.2 + modB * 16.0);\nlet waveB = (0.16 + modB * 0.48) * sin(x * 24.0 - t * 5.0 + modA * 10.0);\nlet waveC = (0.12 + modA * 0.4) * cos(x * 38.0 + t * 6.0);\nlet a = waveA + waveB * 0.32;\nlet b = waveA * 0.62 + waveC * 0.42;\nlet lineA = exp(-abs(p.y - a) * 210.0);\nlet lineB = exp(-abs(p.y - b) * 250.0);\nlet glowA = exp(-abs(p.y - a) * 35.0);\nlet glowB = exp(-abs(p.y - b) * 40.0);\nlet cell = floor(p.x * 42.0);\nlet height = 0.03 + 0.5 * pow(noise(vec2<f32>(cell * 0.41, t * 1.6)), 2.2);\nlet column = 1.0 - smoothstep(0.18, 0.45, abs(fract(p.x * 42.0) - 0.5));\nlet bars = column * (1.0 - smoothstep(height, height + 0.018, abs(p.y)));\nlet cyan = hsv(0.52 + modA * 0.08, 0.95, 1.0);\nlet magenta = hsv(0.88 + modB * 0.08, 0.95, 1.0);\nlet background = mix(c1, c3, 0.5) * vec3<f32>(0.006);\nlet color = background + cyan * vec3<f32>(lineA + glowA * 0.08) + magenta * vec3<f32>(lineB + glowB * 0.07) + mix(cyan, magenta, 0.5) * vec3<f32>(bars * 0.035);\nreturn clamp(color, vec3<f32>(0.0), vec3<f32>(1.0));",
        "variables": [
