      "custom": {
        "expression": "var col = vec3<f32>(0.0);\nfor (var i = 0; i < 6; i++) {\n    let k = f32(i);\n    let s = k / 5.0;\n    let y = 0.34 - k * 0.14 + 0.08 * sin(p.x * (2.0 + k * 0.4) + t * (0.4 + 0.1 * k) + k * 1.3) + 0.03 * sin(p.x * 9.0 - t * 1.1 + k * 2.0);\n    let d = abs(p.y - y);\n    let core = 1.0 - smoothstep(0.0012, 0.0045, d);\n    let glow = exp(-d * 45.0) * 0.35;\n    let shade = mix(c2, c1, s);\n    col += shade * (core + glow);\n}\nlet sweep = fract(t * 0.05);\nlet xs = sweep * 1.8 - 0.9;\nlet scan = c5 * (1.0 - smoothstep(0.001, 0.004, abs(p.x - xs))) * 0.5;\nlet gl = abs(fract(p * vec2<f32>(6.0, 4.0)) - 0.5);\nlet grid = c5 * smoothstep(0.485, 0.5, max(gl.x, gl.y)) * 0.1;\nlet hot = c3 * (1.0 - smoothstep(0.0012, 0.004, abs(p.y + 0.3 + 0.05 * sin(p.x * 5.0 + t * 0.7)))) * 0.8;\nreturn mix(bg, tonemap(col * 1.2 + scan + grid + hot), strength);",
        "name": "Scope Trace",
