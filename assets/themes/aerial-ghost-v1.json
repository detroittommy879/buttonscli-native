        "expression": "let plane = vec2<f32>(fract(t * 0.075 * flyby_speed) * 6.0 - 3.0, 0.48);\nlet proximity = exp(-plane.x * plane.x * 0.65);\nlet grain = hash(floor(p * vec2<f32>(460.0, 310.0)) + vec2<f32>(floor(t * 29.0)));\nlet bend = sin(p.y * 19.0 - t * 6.0) * 0.045 * proximity;\nlet signal = sin((p.x + bend) * 4.8 + p.y * 2.0 + t * 0.6);\nlet broadcast = mix(mix(c4, c1, smoothstep(-0.65, 0.65, signal)), mix(c2, c3, 0.5), 0.45 * smoothstep(0.1, 0.9, sin(p.x * 3.4 - p.y * 4.5 - t * 0.8)));\nlet ghost = ghost_strength * proximity * smoothstep(0.65, 0.95, sin((p.x + bend + 0.25) * 4.8 + p.y * 2.0 + t * 0.6));\nlet screen = broadcast * vec3<f32>((0.84 + 0.16 * sin(p.y * 430.0)) * (0.85 + (grain - 0.5) * static_amount * 0.7)) + c3 * vec3<f32>(ghost * 0.25);\nlet q = p - plane;\nlet aircraft = 1.0 - smoothstep(0.85, 1.2, min(length(q / vec2<f32>(0.19, 0.018)), abs(q.x + q.y * 0.34) / 0.037 + abs(q.y) / 0.15));\nlet a = p - vec2<f32>(0.78, -0.35);\nlet mast = (1.0 - smoothstep(0.009, 0.02, abs(a.x))) * (1.0 - smoothstep(0.48, 0.5, abs(a.y)));\nlet bars = (1.0 - smoothstep(0.04, 0.12, abs(fract((a.y + 0.02) * 9.0) - 0.5))) * (1.0 - smoothstep(0.12, 0.15, abs(a.x))) * (1.0 - smoothstep(0.3, 0.36, abs(a.y - 0.12)));\nreturn mix(bg, clamp(mix(screen, c4 * vec3<f32>(0.16), max(aircraft, max(mast, bars)) * 0.93), vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
