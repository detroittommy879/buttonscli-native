      "custom": {
        "expression": "let warp = noise(vec2<f32>(p.x * 2.0 + t * 0.1, p.y * 1.5)) - 0.5;\nvar acc = vec3<f32>(0.0);\nfor (var i = 0; i < 6; i++) {\n    let k = f32(i);\n    let phase = k * 0.9 + warp * 2.0;\n    let freq = 2.0 + 0.4 * k;\n    let base = (k - 2.5) * 0.09;\n    let wave_y = base + wave_amp * sin(p.x * freq + t * (wave_speed + 0.05 * k) + phase) * (1.0 - 0.1 * k);\n    let dist = abs(p.y - wave_y - warp * 0.05);\n    let crisp = 1.0 - smoothstep(0.0, line_width * (1.0 + 0.3 * k), dist);\n    let glow_band = exp(-dist * 28.0) * 0.35;\n    let tint = mix(mix(c3, c2, k / 5.0), c5, step(4.0, k));\n    acc += tint * (crisp + glow_band) * (0.6 + 0.4 * k / 5.0);\n}\nlet wash = mix(c4 * 0.6, c3 * 0.35, smoothstep(-0.5, 0.5, p.y));\nlet color = wash + acc * mix(c1, c2, 0.5);\nreturn mix(bg, tonemap(color * 1.2), strength);",
