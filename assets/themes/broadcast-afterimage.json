      "custom": {
        "expression": "let wobble = sin(p.y * 27.0 + t * 0.7) * 0.005 * tracking;\nlet q = vec2<f32>(p.x + wobble, p.y);\nlet wash = mix(c1 * 1.3, c4 * 0.55, smoothstep(-0.5, 0.5, q.y));\nlet frame_d = sd_box(q, vec2<f32>(0.69, 0.35));\nlet frame = fill(frame_d);\nlet inner = fill(frame_d + 0.025);\nlet panel = mix(c1 * 1.4, c5 * 0.72, inner);\nlet x = q.x + 0.69;\nlet bar1 = smoothstep(0.20, 0.205, x);\nlet bar2 = smoothstep(0.40, 0.405, x);\nlet bar3 = smoothstep(0.60, 0.605, x);\nlet bar4 = smoothstep(0.80, 0.805, x);\nlet bar5 = smoothstep(1.00, 1.005, x);\nlet bar6 = smoothstep(1.20, 1.205, x);\nlet bars_a = mix(c5, c2, bar1);\nlet bars_b = mix(bars_a, c4, bar2);\nlet bars_c = mix(bars_b, c3, bar3);\nlet bars_d = mix(bars_c, c2 * 0.72, bar4);\nlet bars_e = mix(bars_d, c4 * 0.72, bar5);\nlet bars = mix(bars_e, c3 * 0.72, bar6);\nlet upper = smoothstep(-0.08, -0.075, q.y);\nlet lower = mix(c1 * 1.7, c4 * 0.65, smoothstep(-0.25, -0.245, q.y));\nlet card = mix(lower, bars, upper);\nlet circle_d = sd_circle(q - vec2<f32>(0.0, 0.035), 0.19);\nlet disk = fill(circle_d);\nlet disk_inside = fill(circle_d + 0.012);\nlet disk_color = mix(c1, c5 * 0.88, disk_inside);\nlet cross_x = 1.0 - smoothstep(0.003, 0.006, abs(q.x));\nlet cross_y = 1.0 - smoothstep(0.003, 0.006, abs(q.y - 0.035));\nlet cross = max(cross_x, cross_y) * disk_inside;\nlet center = mix(disk_color, c3, cross);\nlet card_with_disk = mix(card, center, disk);\nlet bordered = mix(panel, card_with_disk, inner);\nlet scene = mix(wash, bordered, frame);\nlet line_phase = q.y * 640.0 + 0.35 * sin(t * 0.7);\nlet lines = 0.5 + 0.5 * cos(line_phase);\nlet line_shade = 1.0 - scanlines * 0.18 * lines;\nlet roll = 1.0 - smoothstep(0.0, 0.018, abs(q.y - 0.65 * sin(t * 0.11)));\nlet final_color = scene * line_shade * (1.0 - roll * tracking * 0.18);\nreturn mix(bg, final_color, strength);",
