{
  "version": 1,
  "metadata": {
    "id": "pane-focus-compass-coral",
    "name": "Opposite Shores / Coral",
    "nativeThemeVersion": 1,
    "description": "Warm and cool colors alternate around a quiet center. Coral pane; stable hue, dark background, gentle contrast."
  },
  "theme": {
    "mode": "dark",
    "app": {
      "shell": {
        "background": "#090c12",
        "backgroundSecondary": "#171212",
        "buttonBackground": "#171212",
        "border": "#473131",
        "textMain": "#e5eaf2",
        "textDim": "#a4afbf",
        "accent": "#e88d8c",
        "accentHover": "#eaa6a5",
        "paneDivider": {
          "color": "#e88d8c",
          "thickness": 2.0
        }
      },
      "tabs": {
        "background": "#090c12",
        "idleBackground": "#171212",
        "activeBackground": "#473131",
        "activeBorder": "#e88d8c"
      },
      "presetDock": {
        "background": "#171212",
        "buttonBackground": "#171212",
        "buttonHover": "#473131",
        "buttonText": "#e5eaf2",
        "accent": "#e88d8c"
      },
      "settings": {
        "background": "#0d111a"
      },
      "statusBar": {
        "background": "#090c12",
        "border": "#473131",
        "text": "#bac5d4",
        "warning": "#e8ce8a"
      }
    },
    "terminal": {
      "background": "#0b0808",
      "foreground": "#e5eaf2",
      "ansiColors": {
        "black": "#586174",
        "red": "#ed919b",
        "green": "#a3d6a0",
        "yellow": "#e8ce8a",
        "blue": "#95b9f1",
        "magenta": "#ceb0ec",
        "cyan": "#94d6d9",
        "white": "#dce3ed",
        "brightBlack": "#99a3b6",
        "brightRed": "#ffb0b9",
        "brightGreen": "#c1ebbc",
        "brightYellow": "#f5e2ac",
        "brightBlue": "#bad2ff",
        "brightMagenta": "#e0c7ff",
        "brightCyan": "#b6eceb",
        "brightWhite": "#f6f8fc"
      },
      "useGradient": true,
      "gradientType": "linear",
      "gradientAngle": 135.0,
      "gradientColors": [
        "#030408",
        "#130d0c",
        "#3a2424",
        "#2f1e1e"
      ],
      "gradientAnimation": false
    }
