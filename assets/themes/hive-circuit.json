      "custom": {
        "expression": "let q = p * density;\nlet r = vec2<f32>(1.0, 1.7320508);\nlet h = r * 0.5;\nlet ga = (fract(q / r) - 0.5) * r;\nlet gb = (fract((q - h) / r) - 0.5) * r;\nlet gv = select(gb, ga, length(ga) < length(gb));\nlet cell = q - gv;\nlet e = abs(gv);\nlet hd = max(dot(e, vec2<f32>(0.5, 0.8660254)), e.x);\nlet edge = max(0.5 - hd, 0.0);\nlet idh = hash(cell);\nlet on = step(0.45, idh);\nlet lane = hash(vec2<f32>(floor(cell.y * 0.5), 7.0)) * 3.0;\nlet front = fract(cell.x * 0.12 - t * pulse_speed + lane);\nlet pk = exp(-front * 12.0) * on;\nlet body = mix(c4, c2 * 0.25, idh * 0.6) * (0.6 + 0.4 * on);\nlet edge_col = mix(c1, c2, hash(cell + vec2<f32>(3.1, 7.7)));\nlet line_glow = exp(-edge * 60.0) + exp(-edge * 12.0) * 0.3 * glow_amount;\nlet packet = c5 * pk * 1.4 + c1 * pk * 0.4 * (0.5 + idh);\nlet color = body + edge_col * line_glow * (0.5 + 0.5 * on) + packet;\nreturn mix(bg, tonemap(color), strength);",
        "name": "Hive Circuit",
