{
  "version": 1,
  "metadata": {
    "id": "pane-focus-dusk-mulberry",
    "name": "Velvet Dusk / Mulberry",
    "nativeThemeVersion": 1,
    "description": "Slow horizontal folds with distinct dusk colors. Mulberry pane; stable hue, dark background, gentle contrast."
  },
  "theme": {
    "mode": "dark",
    "app": {
      "shell": {
        "background": "#090c12",
        "backgroundSecondary": "#151215",
        "buttonBackground": "#151215",
        "border": "#3f303e",
        "textMain": "#e5eaf2",
        "textDim": "#a4afbf",
        "accent": "#ca8ac5",
        "accentHover": "#d4a4d0",
        "paneDivider": {
          "color": "#ca8ac5",
          "thickness": 2.0
        }
      },
      "tabs": {
        "background": "#090c12",
        "idleBackground": "#151215",
        "activeBackground": "#3f303e",
        "activeBorder": "#ca8ac5"
      },
      "presetDock": {
        "background": "#151215",
        "buttonBackground": "#151215",
        "buttonHover": "#3f303e",
        "buttonText": "#e5eaf2",
        "accent": "#ca8ac5"
      },
      "settings": {
        "background": "#0d111a"
      },
      "statusBar": {
        "background": "#090c12",
        "border": "#3f303e",
        "text": "#bac5d4",
        "warning": "#e8ce8a"
      }
    },
    "terminal": {
      "background": "#0a080a",
      "foreground": "#e5eaf2",
      "ansiColors": {
        "black": "#586174",
        "red": "#ed919b",
        "green": "#a3d6a0",
        "yellow": "#e8ce8a",
        "blue": "#95b9f1",
        "magenta": "#ceb0ec",
        "cyan": "#94d6d9",
        "white": "#dce3ed",
        "brightBlack": "#99a3b6",
        "brightRed": "#ffb0b9",
        "brightGreen": "#c1ebbc",
        "brightYellow": "#f5e2ac",
        "brightBlue": "#bad2ff",
        "brightMagenta": "#e0c7ff",
        "brightCyan": "#b6eceb",
        "brightWhite": "#f6f8fc"
      },
      "useGradient": true,
      "gradientType": "linear",
      "gradientAngle": 135.0,
      "gradientColors": [
        "#030408",
        "#110c11",
        "#322331",
        "#291d28"
      ],
      "gradientAnimation": false
    }
  },
  "effects": {
    "masterDisabled": false,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "simpleNoiseEnabled": false,
    "shaderBackground": {
      "version": 1,
      "preset": "aurora",
      "strength": 0.9,
      "speed": 0.22,
      "scale": 1.0,
      "animated": true,
      "colors": [
        "#030408",
        "#110c11",
        "#322331",
        "#291d28",
        "#3f2b3d"
      ],
      "theme_colors": false,
      "custom": {
        "name": "Pane Focus / Velvet Fold",
        "expression": "let bend = sin(p.y * 1.7 + t * 0.12) * 0.18;\nlet fold = 0.5 + 0.5 * sin(p.x * folds + bend + t * 0.08);\nlet haze = smoothstep(0.1, 1.0, clamp(p.y * 0.4 + 0.5, 0.0, 1.0));\nlet base = mix(c1, c2, 0.45 + haze * 0.3);\nlet silk = mix(c3, c4, haze * 0.4);\nreturn mix(bg, mix(base, silk, fold * depth) + c5 * fold * fold * 0.04, strength);",
        "y_up": true,
        "variables": [
          {
            "name": "folds",
            "min": 0.5,
            "max": 6.0,
            "value": 2.2
          },
          {
            "name": "depth",
            "min": 0.2,
            "max": 1.0,
            "value": 0.85
          }
        ]
      }
    }
  }
}
