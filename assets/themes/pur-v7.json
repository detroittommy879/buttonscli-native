      "custom": {
        "expression": "let intensity = clamp(amount / 10.0, 0.0, 1.0);\nlet uv = p * vec2<f32>(1.3 + intensity * 0.9);\nlet tile = floor(uv + vec2<f32>(0.5));\nlet q = fract(uv + vec2<f32>(0.5)) - vec2<f32>(0.5);\nlet seed = hash(tile);\nlet clock = t * 0.65 + seed * 6.28318;\nlet orbit = vec2<f32>(cos(clock), sin(clock * 1.13)) * vec2<f32>(0.19);\nlet a = q - orbit;\nlet b = q + orbit;\nlet ra = length(a);\nlet rb = length(b);\nlet angle = atan2(q.y, q.x);\nlet radius = length(q);\nlet gravity = 0.032 / (ra + 0.07) - 0.032 / (rb + 0.07);\nlet wave = sin(ra * 48.0 - clock * 3.0 + gravity * 5.0) + sin(rb * 53.0 - clock * 3.7 - gravity * 5.0);\nlet interference = pow(0.5 + 0.5 * cos(wave * 4.0 + radius * 16.0), 24.0);\nlet spiral = pow(0.5 + 0.5 * sin(angle * 5.0 - radius * 31.0 + clock * 2.0 + gravity * 7.0), 32.0);\nlet ringRadius = 0.25 + 0.055 * sin(clock * 1.4);\nlet ring = exp(-abs(radius - ringRadius - 0.022 * sin(angle * 7.0 + clock)) * 155.0);\nlet cores = exp(-ra * 95.0) + exp(-rb * 95.0);\nlet envelope = 1.0 - smoothstep(0.32, 0.49, radius);\nlet pulse = 0.72 + 0.28 * sin(clock * 1.8 - radius * 13.0);\nlet hue = angle / 6.28318 + radius * 1.7 + gravity * 0.45 + seed * 0.7 - t * 0.065;\nlet spectrum = palette(hue);\nlet counter = palette(hue + 0.38);\nlet backdrop = mix(c1, mix(c2, c3, 0.5 + 0.5 * sin(t * 0.18 + p.x)), 0.35) * vec3<f32>(0.025);\nlet filaments = spectrum * vec3<f32>(interference * 0.26 * pulse) + counter * vec3<f32>(spiral * 0.42 * pulse);\nlet energy = filaments + palette(hue + 0.16) * vec3<f32>(ring * 0.65) + vec3<f32>(0.22, 0.42, 0.65) * vec3<f32>(cores);\nlet color = backdrop + energy * vec3<f32>(envelope * (0.55 + intensity * 0.45));\nreturn clamp(color, vec3<f32>(0.0), vec3<f32>(0.78));",
