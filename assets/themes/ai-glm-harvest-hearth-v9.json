      "custom": {
        "expression": "let sp = t * flow_speed;\nlet w = flow(p * 2.2 + vec2<f32>(sp * 0.3, 0.0), sp);\nlet clouds = fbm(p * 1.5 + vec2<f32>(w * depth_shift * 2.0, sp * 0.1));\nlet deep = mix(c4, c2 * 0.7, smoothstep(0.3, 0.8, clouds));\nlet wash = mix(deep, c1 * 0.8, smoothstep(0.5, 0.9, w) * 0.5);\nlet ring_d = length(p - vec2<f32>(0.4 * sin(sp * 0.3), 0.1 + 0.05 * cos(sp * 0.2))) - 0.25;\nlet ring = stroke(ring_d, 0.012) * 0.7 * c5;\nvar glow = vec3<f32>(0.0);\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let depth = 1.0 + k * 0.7 + depth_shift * k;\n    let g = vec2<f32>(p.x * 4.0 / depth, p.y * 3.0 / depth - sp * (0.12 + 0.08 * k) + k * 3.7);\n    let cell = floor(g);\n    let seed = hash(cell + vec2<f32>(k * 11.0, 2.0));\n    let wob = vec2<f32>(0.18 * sin(sp * 0.6 + seed * 6.28), 0.0);\n    let d = sd_circle(fract(g) - 0.5 - wob, 0.1 * blob_size * (0.6 + 0.4 * seed));\n    let tint = mix(c1, c3, seed);\n    let lit = step(0.35, seed);\n    glow += tint * halo(d, 0.08 / depth) * lit / depth;\n}\nlet color = wash + glow * 1.2 + ring;\nreturn mix(bg, tonemap(color), strength);",
