      "custom": {
        "expression": "let bg = mix(c1 * 0.07, c2 * 0.05, cloud(p * 1.3 + vec2<f32>(t * 0.08, t * 0.05)));\nlet grain = (hash(floor(p * 220.0) + vec2<f32>(floor(t * 14.0), 0.0)) - 0.5) * 0.06;\n\nlet sp = 1.7 + amount * 0.45;\nlet g = p * sp;\nlet cid = floor(g);\nlet f = fract(g) - 0.5;\nlet rnd = hash(cid + vec2<f32>(11.0, 7.0));\nlet ang = t * (0.4 + rnd * 0.8) + rnd * 6.2831853;\nlet off = 0.27 * vec2<f32>(cos(ang), sin(ang));\nlet q = f - off;\nlet rad = 0.15 + 0.10 * rnd;\nlet cd = length(q) - rad;\nlet ring = (1.0 - smoothstep(0.0, 0.045, abs(cd))) * (0.55 + 0.45 * rnd);\nlet ccol = mix(c3, palette(rnd * 0.6 + t * 0.04), 0.45);\n\nlet tg = p * (1.2 + amount * 0.22) + vec2<f32>(t * 0.12, -t * 0.09);\nlet tid = floor(tg);\nlet tf = fract(tg) - 0.5;\nlet tr = hash(tid + vec2<f32>(37.0, 5.0));\nlet rot = t * (0.5 + tr) + tr * 6.2831853;\nlet cs = cos(rot);\nlet sn = sin(rot);\nlet tp = vec2<f32>(tf.x * cs - tf.y * sn, tf.x * sn + tf.y * cs);\nlet toff = 0.22 * vec2<f32>(sin(t * 0.6 + tr * 6.0), cos(t * 0.45 + tr * 5.0));\nlet q2 = (tp - toff) * (2.4 + tr * 1.4);\nlet td = max(-q2.y - 0.5, abs(q2.x) * 0.8660254 + q2.y * 0.5 - 0.5);\nlet tri = 1.0 - smoothstep(0.0, 0.20, td);\nlet tcol = mix(c2, palette(tr * 0.5 + 0.3 + t * 0.03), 0.5);\n\nlet col = bg + vec3<f32>(grain) + ccol * ring * 0.55 + tcol * tri * 0.30;\nreturn clamp(col, vec3<f32>(0.0), vec3<f32>(1.0));",
