      "custom": {
        "expression": "let col_idx = clamp(floor((p.x + 0.9) * 3.9), 0.0, 6.0);\nlet ph = col_idx / 6.0;\nlet bars_c = mix(mix(c5, c3, smoothstep(0.0, 0.3, ph)), mix(c2, c1, smoothstep(0.55, 1.0, ph)), smoothstep(0.3, 0.65, ph));\nlet lower_c = mix(c4, c1 * 0.75, step(0.5, fract(col_idx * 0.5)));\nlet lower = 1.0 - smoothstep(-0.365, -0.355, p.y);\nlet bars_all = mix(bars_c, lower_c, lower);\nlet wrap = fract(p.y * 0.6 - t * roll_speed);\nlet roll = mix(0.76, 1.0, smoothstep(0.0, 0.14, wrap));\nlet field = floor(t * 30.0);\nlet line = floor(p.y * 450.0 + 0.5 * fract(field * 0.5));\nlet interlace = mix(0.88, 1.0, step(0.5, fract(line * 0.5 + field * 0.5)));\nlet scan = 0.94 + 0.06 * cos(p.y * 565.48);\nlet base = bars_all * roll * interlace * scan;\nlet y0 = fract(t * 0.13) - 0.5;\nlet band = 1.0 - smoothstep(0.015, 0.055, abs(p.y - y0));\nlet grain = hash(floor(p * vec2<f32>(140.0, 70.0)) + vec2<f32>(field * 3.1, 0.0));\nlet static_tint = mix(c4, c5, grain);\nlet color_a = mix(base, static_tint, band * noise_amount * 0.7);\nlet frame_d = sd_box(p - vec2<f32>(-0.62, 0.36), vec2<f32>(0.12, 0.07));\nlet frame = stroke(frame_d, 0.012);\nlet blink = step(0.5, fract(t * 0.8));\nlet lamp = fill(sd_circle(p - vec2<f32>(-0.5, 0.36), 0.02)) * blink;\nlet color_b = mix(color_a, c4, frame * 0.95);\nlet color = mix(color_b, c3, lamp);\nreturn mix(bg, color, strength);",
        "name": "Broadcast 900",
