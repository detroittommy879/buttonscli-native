      "custom": {
        "expression": "let env = 0.6 + 0.4 * sin(p.x * 1.7 + t * 0.35);\nvar y = 0.0;\nvar tg = vec3<f32>(0.0);\nfor (var i = 0; i < 5; i++) {\n    let k = f32(i) + 1.0;\n    let dir = select(1.0, -1.0, i == 1 || i == 3);\n    let yk = 0.12 / k * env * sin(p.x * k * 9.0 + dir * t * (0.8 + 0.5 * k));\n    y += yk;\n    let dk = abs(p.y - yk);\n    let tint = mix(mix(c2, c1, 0.5), c5, f32(i) * 0.2);\n    tg += tint * (0.0002 / (dk * dk + 0.0002)) * 0.3;\n}\nlet dc = abs(p.y - y);\nlet core = exp(-dc * dc * 250000.0);\nlet halo_w = 0.00025 / (dc * dc + 0.00025);\nlet spark = sin(p.x * 140.0 + t * 17.0) * sin(p.x * 53.0 - t * 11.0);\nlet sparks = spark * spark * halo_w * 1.5 * mix(c1, c3, 0.5);\nlet line = vec3<f32>(1.0, 0.97, 1.0) * core * 1.3 + sparks;\nlet haze = mix(c4 * 0.9, c2 * 0.35, smoothstep(-0.5, 0.5, p.y));\nlet grid = pow(abs(sin(p.x * 45.0) * sin(p.y * 45.0)), 8.0) * 0.25;\nlet scan = 0.9 + 0.1 * sin(p.y * 1200.0);\nlet col = (haze + grid * c2 * 0.5) * scan + line + tg * glow_amount + halo_w * c1 * 0.15;\nlet vignette = clamp(1.2 - 1.1 * dot(p, p), 0.0, 1.0);\nreturn mix(bg, tonemap(col * 1.1) * vignette, strength);",
        "name": "Neon Harmonic Scope",
