      "custom": {
        "expression": "let density = 1.2 + amount * 0.22;\nlet grid = p * density;\nlet row = floor(grid.y);\nlet cell = vec2<f32>(grid.x + 0.5 * sin(row * 2.7), grid.y);\nlet id = floor(cell);\nlet seed = hash(id);\nlet q0 = fract(cell) - vec2<f32>(0.5);\nlet bob = 0.035 * sin(t * 2.0 + seed * 6.28);\nlet q = q0 - vec2<f32>(0.0, bob);\nlet angle = 0.12 * sin(t * 1.4 + seed * 9.0);\nlet v = vec2<f32>(q.x * cos(angle) - q.y * sin(angle), q.x * sin(angle) + q.y * cos(angle));\nlet body = 1.0 - smoothstep(0.92, 1.0, length(v / vec2<f32>(0.35, 0.29)));\nlet ribs = 0.78 + 0.22 * cos(v.x * 31.0);\nlet pumpkin = mix(c1, c2, 0.35 + 0.25 * sin(seed * 9.0 + t)) * vec3<f32>(ribs);\nlet stem = (1.0 - smoothstep(0.025, 0.045, abs(v.x - 0.015))) * smoothstep(0.22, 0.26, v.y) * (1.0 - smoothstep(0.35, 0.38, v.y));\nlet eye_left = 1.0 - smoothstep(0.045, 0.062, length((v - vec2<f32>(-0.12, 0.075)) * vec2<f32>(1.0, 1.4)));\nlet eye_right = 1.0 - smoothstep(0.045, 0.062, length((v - vec2<f32>(0.12, 0.075)) * vec2<f32>(1.0, 1.4)));\nlet mouth_outer = 1.0 - smoothstep(0.92, 1.0, length((v - vec2<f32>(0.0, -0.10)) / vec2<f32>(0.19, 0.13)));\nlet mouth_inner = smoothstep(0.93, 1.0, length((v - vec2<f32>(0.0, -0.025)) / vec2<f32>(0.20, 0.12)));\nlet face = max(max(eye_left, eye_right), mouth_outer * mouth_inner) * body;\nlet party = 0.5 + 0.5 * sin(grid.x * 2.0 - grid.y * 2.5 + t * 0.6);\nlet backdrop = mix(vec3<f32>(0.13, 0.035, 0.24), vec3<f32>(0.30, 0.07, 0.35), party);\nlet sparkle = pow(max(0.0, sin(grid.x * 17.0 + t) * sin(grid.y * 19.0 - t * 0.7)), 24.0);\nlet base = backdrop + c3 * vec3<f32>(sparkle * 0.24);\nlet painted = mix(mix(base, vec3<f32>(0.30, 0.65, 0.13), stem), pumpkin, body);\nlet color = mix(painted, vec3<f32>(1.0, 0.72, 0.10) * vec3<f32>(0.85 + 0.15 * sin(t * 4.0 + seed * 12.0)), face);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
