      "custom": {
        "expression": "let warp = 0.025 * vec2<f32>(sin(p.y * 5.0 + t * 0.12), cos(p.x * 4.0 - t * 0.09));\nlet g0 = (p + warp) * scale_density;\nlet row = floor(g0.y);\nlet g = vec2<f32>(g0.x + 0.5 * row, g0.y);\nlet cell = floor(g);\nlet q = fract(g) - vec2<f32>(0.5, 0.5);\nlet seed = hash(cell);\nlet ctr = vec2<f32>(0.0, 0.08);\nlet v = q - ctr;\nlet d = sd_circle(v, 0.42);\nlet body = fill(d);\nlet rim = stroke(d, 0.025);\nlet dir = normalize(v + vec2<f32>(0.0001, 0.0001));\nlet light = normalize(vec2<f32>(cos(t * 0.05), 0.8 + 0.4 * sin(t * 0.031)));\nlet facing = max(dot(dir, light), 0.0);\nlet band = 0.5 + 0.5 * sin(p.x * 2.0 + p.y * 1.2 - t * 0.11);\nlet glint = pow(facing, 8.0) * rim * glint_gain * (0.6 + 0.4 * band);\nlet tone = mix(c1, c2, smoothstep(-0.5, 0.5, q.y));\nlet base = mix(c4, tone, 0.55 + 0.25 * seed);\nlet shade = 0.7 + 0.5 * clamp(-d * 2.0, 0.0, 1.0);\nlet scale_col = base * shade;\nlet gap = mix(c4, c2, 0.15) * 0.6;\nlet surface = mix(gap, scale_col, body);\nlet color = surface + c3 * glint * 0.9 + c5 * rim * 0.15;\nreturn mix(bg, tonemap(color), strength);",
        "name": "Pearl Scale Drift",
        "variables": [
          {
            "max": 12.0,
            "min": 4.0,
            "name": "scale_density",
