        "expression": "let time = t * motion;\nlet warp = vec2<f32>(\n    sin(p.y * 2.8 + time * 0.9) + 0.4 * cos(p.x * 3.5 - time),\n    cos(p.x * 2.4 - time * 0.8) + 0.4 * sin(p.y * 3.8 + time)\n);\nlet q = (p + warp * (bend * 0.28)) * shape_density;\nlet angle = 0.35 * sin(time * 0.45);\nlet r = vec2<f32>(\n    q.x * cos(angle) - q.y * sin(angle),\n    q.x * sin(angle) + q.y * cos(angle)\n);\nlet drift = r + vec2<f32>(time * 0.15, time * 0.23);\nlet cell = floor(drift);\nlet local = fract(drift) - vec2<f32>(0.5);\nlet seed = hash(cell);\nlet spin = time * (0.35 + seed * 0.45) + seed * 6.28318;\nlet v = vec2<f32>(\n    local.x * cos(spin) - local.y * sin(spin),\n    local.x * sin(spin) + local.y * cos(spin)\n);\nlet square = max(abs(v.x), abs(v.y));\nlet diamond = (abs(v.x) + abs(v.y)) * 0.72;\nlet circle = length(v);\nlet metric = mix(mix(square, diamond, smoothstep(0.15, 0.65, seed)), circle, smoothstep(0.65, 0.95, seed));\nlet radius = 0.29 + 0.055 * sin(time * 1.7 + seed * 9.0);\nlet edge = abs(metric - radius);\nlet outline = 1.0 - smoothstep(0.018, 0.055, edge);\nlet halo = exp(-edge * 15.0) * glow;\nlet fill = 1.0 - smoothstep(radius - 0.025, radius, metric);\nlet hue = 0.5 + 0.5 * sin(r.x * 1.3 + r.y * 1.7 + time * 0.65 + seed * 3.0);\nlet hot = mix(c1, c2, smoothstep(0.05, 0.8, hue));\nlet cool = mix(c5, c3, smoothstep(0.1, 0.9, hue));\nlet ink = mix(hot, cool, 0.5 + 0.5 * sin(seed * 14.0 + time * 0.4));\nlet field = 0.5 + 0.5 * sin(q.x * 2.7 - q.y * 2.1 + time + bend * sin(q.y * 3.0));\nlet base = mix(c5, c1, field) * 0.38;\nlet body = mix(base, ink * 0.72, fill * 0.85);\nlet rim = mix(ink, c4, 0.35 + 0.3 * sin(seed * 12.0 + time));\nlet color = clamp(body + rim * (outline * 0.65 + halo * 0.35), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
