        "expression": "let q = p * (4.0 / scale_size);\nlet row = floor(q.y);\nlet fy = fract(q.y) * 0.72;\nlet x0 = (fract(q.x + row * 0.5) - 0.5) * 1.5;\nlet x1 = (fract(q.x + (row - 1.0) * 0.5) - 0.5) * 1.5;\nlet d0 = abs(length(vec2<f32>(x0, fy)) - 0.95);\nlet d1 = abs(length(vec2<f32>(x1, fy + 0.72)) - 0.95);\nlet edge_distance = min(d0, d1);\nlet rim = exp(-edge_distance * 76.0);\nlet halo = exp(-edge_distance * 13.0);\nlet breath = 0.5 + 0.5 * sin(t * 0.62 + p.y * 1.1 + sin(p.x * 0.8));\nlet mist = cloud(p * 0.85 + vec2<f32>(t * 0.025, -t * 0.018));\nlet violet = 0.5 + 0.5 * sin(q.y * 0.58 + q.x * 0.26 + mist * 2.7);\nlet base = mix(c1, c2, violet * 0.82);\nlet sheen = pow(clamp(fy / 0.72, 0.0, 1.0), 1.8);\nlet body = mix(base, c3, sheen * 0.22 + mist * 0.15);\nlet wave = sin(q.x * 0.83 + q.y * 0.61 - t * 0.49 + sin(q.y * 0.91 + t * 0.23) * 2.0);\nlet interference = pow(0.5 + 0.5 * wave, 22.0);\nlet fleck_cell = floor(q * 9.0);\nlet seed = hash(fleck_cell);\nlet fleck_pos = fract(q * 9.0) - vec2<f32>(0.5);\nlet fleck = exp(-dot(fleck_pos, fleck_pos) * 95.0);\nlet twinkle = pow(0.5 + 0.5 * sin(t * 1.3 + seed * 91.0), 8.0);\nlet silver = rim * interference * smoothstep(0.78, 0.98, noise(q * 1.2 + vec2<f32>(t * 0.08, 0.0)));\nlet dust = fleck * step(0.965, seed) * twinkle;\nlet glow = 0.65 + breathing * breath * 0.55;\nlet color = body + mix(c4, c3, violet) * (rim * 0.32 + halo * 0.15) * glow + c5 * (silver * 0.85 + dust * 0.65) * glint_rate;\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
