  "effects": {
    "masterDisabled": false,
    "staticEnabled": false,
    "scanlinesEnabled": false,
    "rowBandingEnabled": false,
    "simpleNoiseEnabled": false,
    "shaderBackground": {
      "version": 1,
      "preset": "aurora",
      "strength": 0.9,
      "speed": 0.22,
      "scale": 1.0,
      "animated": true,
      "colors": [
        "#030408",
        "#0d1212",
        "#243434",
        "#1e2b2a",
        "#2d4140"
      ],
      "theme_colors": false,
      "custom": {
        "name": "Pane Focus / Orbital Halo",
        "expression": "let center = vec2<f32>(0.65 + sin(t * 0.08) * 0.08, -0.45);\nlet radius = length((p - center) * vec2<f32>(0.7, 1.0));\nlet arc = exp(-abs(radius - orbit) * 3.0);\nlet wash = exp(-radius * 0.8);\nlet base = mix(c1, c2, wash);\nlet halo = mix(c3, c4, clamp(radius * 0.3, 0.0, 1.0));\nreturn mix(bg, mix(base, halo, 0.25 + arc * depth * 0.55) + c5 * arc * 0.04, strength);",
        "y_up": true,
        "variables": [
          {
            "name": "orbit",
            "min": 0.2,
            "max": 1.8,
            "value": 0.8
          },
          {
            "name": "depth",
            "min": 0.2,
            "max": 1.0,
            "value": 0.85
          }
        ]
      }
    }
  }
}
