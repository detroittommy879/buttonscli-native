      "custom": {
        "expression": "let cell = floor(p.x * reef_density / 0.8 + 0.5);\nlet seed = hash(vec2<f32>(cell, 4.7));\nlet height = 0.75 + seed * 0.65;\nlet y = (p.y + 0.75) / height;\nlet bend = sin(t * 0.65 + cell * 1.8 + y * 1.5) * 0.065 * sway * smoothstep(-0.5, 0.65, y);\nlet x = (fract(p.x * reef_density / 0.8 + 0.5) - 0.5) * 0.8 - bend;\nlet q = vec2<f32>(x, y - 0.25);\nlet prongs = length(vec2<f32>(abs(q.x) - 0.14, q.y - clamp(q.y, 0.0, 0.42)));\nlet curve = max(abs(length(q) - 0.14), q.y);\nlet stem = length(vec2<f32>(q.x, q.y - clamp(q.y, -0.72, -0.14)));\nlet d = min(stem, min(prongs, curve));\nlet body = 1.0 - smoothstep(0.009, 0.025, d);\nlet aura = exp(-d * 17.0) * 0.38 * glow;\nlet pulse = 0.73 + 0.27 * sin(t * 0.8 + cell * 2.4 + y * 3.0);\nlet metal = mix(c2, c3, smoothstep(-0.5, 0.72, y));\nlet phase = fract(t * ring_speed * 0.2 + seed);\nlet radius = 0.035 + phase * 0.15;\nlet ring_center = 0.67 + phase * 1.45;\nlet ring_pos = vec2<f32>((abs(x) - 0.14) / radius, (y - ring_center) / (radius * 0.32));\nlet ring_edge = abs(length(ring_pos) - 1.0);\nlet rings = exp(-ring_edge * 12.0) * sin(phase * 3.141593) * 0.32;\nlet haze = cloud(p * 1.4 + vec2<f32>(t * 0.025, -t * 0.035));\nlet water = mix(c1, c2, 0.16 + haze * 0.37);\nlet seabed = exp(-abs(p.y + 0.9) * 2.7);\nlet glint = pow(max(0.0, sin(y * 31.0 + cell * 8.1 - t * 0.5)), 22.0) * body * step(0.72, seed);\nlet color = water + c2 * vec3<f32>(seabed * 0.19) + metal * vec3<f32>((body * 0.7 + aura) * pulse) + mix(c3, c5, phase) * vec3<f32>(rings * glow) + c4 * vec3<f32>(glint * 0.7);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
