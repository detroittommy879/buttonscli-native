        "expression": "let drift = p * density + vec2<f32>(0.12 * t, -0.18 * t);\nlet cell = floor(drift / 2.6);\nlet seed = hash(cell);\nlet phase = seed * 6.283185;\nlet offset = vec2<f32>(sin(t * 0.37 + phase), cos(t * 0.29 + phase)) * 0.22;\nlet local = drift - (cell + vec2<f32>(0.5)) * 2.6 - offset;\nlet angle = phase + t * (seed - 0.5) * 0.28;\nlet rotated = vec2<f32>(\n    local.x * cos(angle) - local.y * sin(angle),\n    local.x * sin(angle) + local.y * cos(angle)\n);\nlet elastic = stretch * smoothstep(0.42, 0.75, seed);\nlet elongation = 1.0 + elastic * (0.3 + 0.45 * sin(t * 0.9 + phase));\nlet q = rotated / vec2<f32>(elongation, 1.0 / sqrt(elongation));\nlet a = abs(q);\nlet hex = max(a.y, dot(a, vec2<f32>(0.8660254, 0.5)));\nlet edge = abs(hex - 0.54);\nlet theta = atan2(q.y, q.x);\nlet double_mask = smoothstep(-0.12, 0.12, sin(theta * 3.0));\nlet inner_edge = abs(hex - 0.425);\nlet inner = (1.0 - smoothstep(0.012, 0.030, inner_edge)) * double_mask;\nlet bonds = 1.0 - smoothstep(0.016, 0.035, edge);\nlet vertex_angle = floor((theta - 0.5235988) / 1.04719755 + 0.5) * 1.04719755 + 0.5235988;\nlet vertex = vec2<f32>(cos(vertex_angle), sin(vertex_angle)) * 0.623538;\nlet atom_distance = length(q - vertex);\nlet atoms = 1.0 - smoothstep(0.036, 0.064, atom_distance);\nlet ink = max(max(bonds, inner), atoms);\nlet halo = exp(-edge * 20.0) + 0.5 * exp(-atom_distance * 12.0);\nlet tint_a = mix(c1, c2, smoothstep(0.1, 0.4, seed));\nlet tint_b = mix(c3, c4, smoothstep(0.4, 0.7, seed));\nlet tint = mix(mix(tint_a, tint_b, step(0.4, seed)), c5, smoothstep(0.8, 1.0, seed));\nlet ambient = mix(c3, c1, 0.5 + 0.5 * sin(p.y * 0.7 + t * 0.12)) * 0.045;\nlet color = clamp(ambient + tint * (ink * 0.94 + halo * (0.025 + glow * 0.22)), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
