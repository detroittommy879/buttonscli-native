      "custom": {
        "expression": "let clock = t * fall_speed;\nlet mist = cloud(p * 3.0 + vec2<f32>(sin(t * 0.07) * 0.4, cos(t * 0.09) * 0.3));\nlet wash = mix(c4 * 0.55, c2 * 0.65, smoothstep(0.2, 0.85, mist));\nlet sky = wash + c1 * 0.12 * (0.5 + 0.5 * sin(p.x * 4.0 + p.y * 2.0 + t * 0.13));\n\nlet rain_grid = vec2<f32>((p.x + p.y * 0.23) * 19.0 * density, p.y * 5.0 + clock * 2.2);\nlet rain_cell = floor(rain_grid);\nlet rain_seed = hash(rain_cell);\nlet rain_local = fract(rain_grid) - 0.5;\nlet rain_x = (rain_seed - 0.5) * 0.48;\nlet rain_dist = sd_segment(rain_local, vec2<f32>(rain_x, -0.3), vec2<f32>(rain_x, 0.3));\nlet rain_mask = smoothstep(0.12, 0.38, rain_seed);\nlet rain_core = 1.0 - smoothstep(0.007, 0.025, rain_dist);\nlet rain_light = rain_core + halo(rain_dist, 0.065) * glow * 0.5;\nlet rain_color = mix(c2, c1, rain_seed) * rain_light * rain_mask;\n\nlet far_grid = p * vec2<f32>(18.0, 14.0) * density + vec2<f32>(clock * 0.12, clock * 0.36);\nlet far_cell = floor(far_grid);\nlet far_seed = hash(far_cell + vec2<f32>(37.0, 8.0));\nlet far_offset = (hash2(far_cell) - 0.5) * 0.55;\nlet far_dist = length(fract(far_grid) - 0.5 - far_offset) - (0.018 + far_seed * 0.028);\nlet far_snow = fill(far_dist) * smoothstep(0.3, 0.5, far_seed);\nlet far_light = mix(c2, c3, far_seed) * far_snow * 0.65;\n\nlet near_grid = p * vec2<f32>(8.0, 6.0) * density + vec2<f32>(clock * 0.23, clock * 0.68);\nlet near_cell = floor(near_grid);\nlet near_seed = hash(near_cell + vec2<f32>(4.0, 91.0));\nlet sway = vec2<f32>(0.13 * sin(t * 0.8 + near_seed * 6.28318), 0.0);\nlet near_offset = (hash2(near_cell + vec2<f32>(8.0, 2.0)) - 0.5) * 0.35;\nlet near_dist = length(fract(near_grid) - 0.5 - near_offset - sway) - (0.035 + near_seed * 0.035);\nlet near_mask = smoothstep(0.25, 0.5, near_seed);\nlet flake = fill(near_dist) + halo(near_dist, 0.065) * glow * 0.55;\nlet snow_color = mix(c3, c5, near_seed * 0.4) * flake * near_mask;\nlet color = tonemap(sky + rain_color * 1.5 + far_light + snow_color * 1.6);\nreturn mix(bg, color, strength);",
