        "expression": "let density = 0.7 + amount * 0.2;\nlet grid = p * density;\nlet cell = floor(grid);\nlet seed = hash(cell);\nlet q = fract(grid) - vec2<f32>(0.5);\nlet sz = 0.35 + shape_size * 0.6;\nlet qq = q / sz;\nlet body = 1.0 - smoothstep(0.42, 0.48, length(qq * vec2<f32>(1.0, 1.12)));\nlet ribs = 0.75 + 0.25 * cos(qq.x * 11.0 + seed * 6.28);\nlet eyeX = 0.26 + hash(cell + vec2<f32>(3.0, 7.0)) * 0.1;\nlet eyeY = 0.08 + hash(cell + vec2<f32>(9.0, 1.0)) * 0.12;\nlet eSz = 0.05 + hash(cell + vec2<f32>(5.0, 2.0)) * 0.06;\nlet eyes = 1.0 - smoothstep(eSz, eSz + 0.05, length(vec2<f32>(abs(qq.x) - eyeX, qq.y - eyeY)));\nlet mW = 0.35 + hash(cell + vec2<f32>(7.0, 4.0)) * 0.1;\nlet mY = 0.22 + hash(cell + vec2<f32>(2.0, 6.0)) * 0.08;\nlet mouth = (1.0 - smoothstep(0.05, 0.1, abs(qq.y + mY + 0.12 * cos(qq.x * 5.0 + seed * 6.28)))) * (1.0 - smoothstep(mW - 0.05, mW, abs(qq.x)));\nlet flameH = 0.3 + glow * 0.25;\nlet fy = (qq.y - 0.55) / flameH;\nlet fx = qq.x + 0.07 * sin(t * gravity * 4.0 + fy * 5.0 + seed * 6.28);\nlet flame = (1.0 - smoothstep(0.1, 0.2, abs(fx) + abs(fy - 0.35) * 0.3)) * step(0.0, fy);\nlet flicker = 0.65 + 0.35 * sin(t * gravity * 9.0 + seed * 6.28);\nlet stem = (1.0 - smoothstep(0.03, 0.06, abs(qq.x))) * (1.0 - smoothstep(0.58, 0.62, qq.y)) * step(0.52, qq.y);\nlet night = mix(bg, vec3<f32>(0.14, 0.04, 0.22), 0.7) + stars(p * 3.0, t) * 0.4 * vec3<f32>(0.9, 0.8, 0.7);\nlet skin = mix(c1, vec3<f32>(1.0, 0.45, 0.05), 0.6) * ribs;\nlet lit = mix(c2, vec3<f32>(1.0, 0.78, 0.15), 0.8);\nlet stemCol = vec3<f32>(0.2, 0.45, 0.08);\nlet color = mix(night, skin, body) + lit * ((eyes + mouth) * body + flame * flicker) + stemCol * stem;\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
