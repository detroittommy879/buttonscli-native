      "custom": {
        "expression": "var col = mix(bg, c4 * 0.12, smoothstep(-0.5, 0.5, p.y));\nfor (var i = 0; i < 3; i++) {\n    let k = f32(i);\n    let s = 2.5 + 2.2 * k;\n    let g = vec2<f32>(p.x * s + t * (0.03 + 0.05 * k) + k * 3.7, p.y * s);\n    let cell = floor(g);\n    let seed = hash(cell + vec2<f32>(k * 11.0, 2.0));\n    let here = step(1.0 - density, seed);\n    let bob = 0.06 * sin(t * (0.3 + 0.2 * seed) + seed * 6.28);\n    let q = (fract(g) - 0.5 - vec2<f32>(0.0, bob)) / pet_size;\n    let m = 0.5 + 0.5 * sin(t * morph_speed + seed * 6.28 + k);\n    let ear = min(sd_circle(q - vec2<f32>(-0.08, 0.09), 0.045), sd_circle(q - vec2<f32>(0.08, 0.09), 0.045));\n    let cat = smin(sd_circle(q, 0.11), ear, 0.03);\n    let oval = length(q * vec2<f32>(1.0, 1.7)) - 0.12;\n    let pc = polar(q);\n    let flower = pc.x - (0.11 + 0.025 * cos(pc.y * 31.4159));\n    let d = mix(mix(cat, oval, smoothstep(0.2, 0.45, m)), flower, smoothstep(0.6, 0.85, m));\n    let tint = mix(c1, c3, hash(cell + vec2<f32>(5.0, k)));\n    let layer = mix(0.4, 1.0, k / 2.0);\n    let body = 1.0 - smoothstep(-0.01, 0.01, d);\n    col += (tint * body * 0.8 + tint * halo(d, 0.05) * 0.35) * here * layer;\n}\nreturn mix(bg, tonemap(col), strength);",
