      "custom": {
        "expression": "let drift = t * (0.16 + gravity * 0.23);\nlet density = 1.2 + amount * 0.25;\nlet q = (p + vec2<f32>(0.18 * sin(p.y * 1.8 + t * 0.8) - t * 0.06, drift)) * vec2<f32>(density);\nlet seed = hash(floor(q));\nlet v = (fract(q) - vec2<f32>(0.5)) / vec2<f32>(0.13 + shape_size * 0.52);\nlet dome = 0.13 + 0.68 * sqrt(max(0.0, 1.0 - v.x * v.x));\nlet scallop = 0.10 + 0.075 * cos(v.x * 9.424778);\nlet canopy = (1.0 - smoothstep(0.96, 1.02, abs(v.x))) * smoothstep(scallop - 0.025, scallop + 0.025, v.y) * (1.0 - smoothstep(dome - 0.025, dome + 0.025, v.y));\nlet shaft = (1.0 - smoothstep(0.025, 0.055, abs(v.x))) * smoothstep(-0.72, -0.67, v.y) * (1.0 - smoothstep(0.58, 0.64, v.y));\nlet fabric = mix(mix(c1, c3, step(0.34, seed)), c2, step(0.78, seed));\nlet weather = cloud(p * vec2<f32>(1.1) + vec2<f32>(t * 0.045, 0.0));\nlet rainQ = vec2<f32>(p.x * 10.0 + p.y * 1.5, p.y * 5.0 + drift * 7.0);\nlet rain = (1.0 - smoothstep(0.025, 0.075, abs(fract(rainQ.x) - 0.5))) * (1.0 - smoothstep(0.62, 0.77, fract(rainQ.y))) * step(0.72, hash(floor(rainQ))) * (0.2 + amount * 0.055);\nlet sky = mix(c1, c3, weather) * vec3<f32>(0.27 + weather * 0.19) + c2 * vec3<f32>(rain) + fabric * vec3<f32>(exp(-dot(v, v) * 1.7) * glow * 0.3);\nlet color = mix(mix(sky, c3, shaft), fabric, canopy);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
