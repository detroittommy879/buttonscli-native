      "custom": {
        "expression": "let tau = 6.2831853;\nlet hour = t / 3600.0;\nlet drift_a = tau * fract(hour * round(112.0 * wind_speed));\nlet drift_b = tau * fract(hour * round(49.0 * wind_speed));\nlet sway = tau * fract(hour * round(24.0 * wind_speed));\n\nlet bow = stroke_bend * (2.2 * sin(5.4 * p.y + 0.95 * p.x - sway)\n    + 0.65 * sin(9.0 * p.y + 2.0 * p.x));\nlet skew = 0.85 * stroke_bend * sin(4.7 * p.y - 2.3 * p.x + sway);\nlet carrier = 106.5 * p.x - 16.5 * p.y + bow;\nlet offset = 5.5 * p.x - 2.5 * p.y + skew;\nlet phase_a = stroke_density * carrier + offset - drift_a;\nlet phase_b = stroke_density * carrier - offset - drift_b;\nlet grating_a = sin(phase_a);\nlet grating_b = sin(phase_b);\nlet overprint = 0.5 * (grating_a + grating_b);\nlet beat = 0.5 + 0.5 * cos(2.0 * offset - (drift_a - drift_b));\n\nlet grain = hash(floor(p * 340.0)) - 0.5;\nlet tooth = noise(p * vec2<f32>(72.0, 18.0)) - 0.5;\nlet ink = grain * paper_grain;\nlet wash = mix(c2, c3, smoothstep(0.12, 0.88, beat));\nlet ground = mix(c1, wash, 0.54 + 0.15 * beat);\nlet olive_hatch = smoothstep(0.28, 0.88, grating_b + 0.13 * tooth + 0.16 * ink);\nlet ochre_hatch = smoothstep(0.28, 0.88, grating_a + 0.13 * tooth + 0.16 * ink);\nlet underprint = mix(ground, c2, 0.34 * olive_hatch);\nlet print_layer = mix(underprint, c3, 0.37 * ochre_hatch);\nlet crest = smoothstep(0.22, 0.93, overprint + 0.1 * tooth + 0.15 * ink);\nlet color = mix(print_layer, c4, 0.78 * crest);\nreturn mix(bg, color * (1.0 + 0.20 * ink + 0.06 * tooth), strength);",
        "name": "Wheat Interference",
