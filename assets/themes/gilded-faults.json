      "custom": {
        "expression": "let clock = t * (6.2831853 / 3600.0);\nlet drift = vec2<f32>(sin(clock * 47.0), cos(clock * 59.0));\nlet g = rotate(p, -0.19) * (5.7 / plate_size);\nlet strain = vec2<f32>(1.0 + 0.045 * drift.x, 1.0 - 0.038 * drift.y);\nlet warp_at = g * 0.68 + drift * 0.19;\nlet warp = vec2<f32>(noise(warp_at), noise(warp_at + vec2<f32>(19.3, 7.1)));\nlet q = g * strain + (warp - vec2<f32>(0.5)) * 0.61 + drift * 0.14;\nlet cell = voronoi(q);\nlet probe = voronoi(q + vec2<f32>(-0.020, 0.021));\nlet slope = clamp((probe.y - cell.y) / 0.028, -1.0, 1.0);\n\nlet breath = 0.5 + 0.5 * sin(clock * 87.0 + dot(q, vec2<f32>(0.73, -0.51)));\nlet lip = cell.y - fault_width * (0.76 + 0.48 * breath);\nlet face = smoothstep(-0.006, 0.012, lip);\nlet bevel = 1.0 - smoothstep(0.009, 0.069, lip);\nlet spill = exp(-max(lip, 0.0) * 20.0);\n\nlet oxide = fbm(q * 3.3 + vec2<f32>(cell.z * 13.0, 4.6));\nlet grain = noise(rotate(q, cell.z * 2.6) * vec2<f32>(12.0, 92.0));\nlet pits = smoothstep(0.73, 0.92, noise(q * 48.0));\nlet polish = clamp(0.34 + cell.z * 0.29 + (oxide - 0.45) * 1.16\n    + (grain - 0.5) * 0.16 - pits * 0.25 - cell.x * 0.13, 0.17, 0.96);\nlet bronze = mix(c1, c2, polish);\nlet cut = bronze * (1.0 - bevel * 0.44 * max(-slope, 0.0));\n\nlet wave = sin(dot(p, vec2<f32>(9.0, 4.2)) + warp.x * 0.75\n    - clock * round(141.0 * sheen_speed));\nlet flash = smoothstep(0.83, 0.998, wave) * violet_sheen;\nlet current = noise(q * 5.7 + drift * 0.64);\nlet heart = 1.0 - smoothstep(0.003, fault_width * 0.8, cell.y);\nlet honey = mix(c3 * 0.74, c5, heart * (0.32 + 0.48 * current));\nlet melt = mix(honey, c4, flash * (0.53 + 0.24 * heart));\nlet glint = bevel * smoothstep(0.04, 0.92, slope);\nlet rim = mix(c3, c4, flash * 0.82);\nlet plate = mix(cut, rim, spill * 0.12 + glint * 0.49);\nreturn mix(bg, mix(melt, plate, face), strength);",
