      "custom": {
        "expression": "let hz = -0.03;\nlet below = max(hz - p.y, 0.015);\nlet depth = 1.0 / below;\nlet px = p.x * depth;\nlet fog = exp(-below * 2.5);\nlet w1 = noise(vec2<f32>(px * 0.8 + t * 0.15 * wave_speed, depth * 2.0 - t * 0.5 * wave_speed));\nlet w2 = noise(vec2<f32>(px * 1.7 - t * 0.25 * wave_speed, depth * 4.0 + t * 0.7 * wave_speed));\nlet ripple = w1 * 0.6 + w2 * 0.4;\nlet crest = smoothstep(0.55, 0.8, ripple);\nlet glint_x = p.x - 0.42 + (w2 - 0.5) * 0.12 * (1.0 + depth * 0.2);\nlet glint = smoothstep(0.1, 0.0, abs(glint_x)) * (0.3 + 0.7 * fog) * (0.5 + 0.5 * crest);\nlet water = mix(c1 * 0.7, c2, ripple) * (0.5 + 0.5 * fog) + c3 * crest * 0.3 + c4 * glint * 0.7;\nlet stars_v = stars(p * 22.0, t);\nlet sky = mix(c5 * 0.45, c1 * 0.3, smoothstep(hz, 0.5, p.y));\nlet moon_d = sd_circle(p - vec2<f32>(0.42, 0.3), 0.05);\nlet moon = fill(moon_d) + halo(moon_d, 0.2) * 0.4;\nlet skyc = sky + c3 * stars_v * 0.8 + c4 * moon;\nlet foam = smoothstep(0.02, 0.0, abs(p.y - hz)) * (0.4 + 0.6 * ripple) * c3;\nlet scene = mix(water + foam, skyc, smoothstep(hz - 0.004, hz + 0.004, p.y));\nreturn mix(bg, tonemap(scene), strength);",
