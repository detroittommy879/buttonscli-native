        "expression": "let drift = flow(p * 2.2 + vec2<f32>(0.0, t * 0.04), t * 0.25);\nlet swirl = fbm(p * 1.6 + vec2<f32>(t * 0.03, -t * 0.02));\nlet band = smoothstep(0.3, 0.7, drift);\nlet ribbon = mix(c2, c1, smoothstep(0.4, 0.65, swirl));\nlet wash = mix(c4 * 1.2, ribbon, band * 0.9);\nlet glow = mix(wash, c3, smoothstep(0.62, 0.8, drift) * 0.7);\nlet sparkle = stars(p * 14.0, t * 0.5) * (0.4 + 0.6 * noise(p * 3.0 + vec2<f32>(t * 0.1, 0.0)));\nlet snow = c5 * sparkle * 0.8;\nlet vignette = clamp(1.1 - 1.1 * dot(p, p), 0.0, 1.0);\nlet color = tonemap((glow + snow) * vignette * 1.3);\nreturn mix(bg, color, strength);",
