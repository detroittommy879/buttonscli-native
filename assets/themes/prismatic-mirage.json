      "custom": {
        "expression": "let density = 1.2 + amount * 0.27;\nlet flow = p + vec2<f32>(sin(p.y * 2.3 + t * 0.24) * cos(p.x * 1.7 - t * 0.17) * 0.16, t * gravity * 0.12);\nlet grid = flow * vec2<f32>(density);\nlet staggered = grid + vec2<f32>(floor(grid.y) * 0.5, 0.0);\nlet seed = hash(floor(staggered));\nlet q = fract(staggered) - vec2<f32>(0.5);\nlet d = max(abs(q.x) * 0.866025 + q.y * 0.5, -q.y) - shape_size * (0.78 + seed * 0.16) * 0.68;\nlet fill = 1.0 - smoothstep(-0.009, 0.009, d);\nlet halo = exp(-max(d, 0.0) * 17.0) * (1.0 - fill);\nlet mist = cloud(flow * vec2<f32>(1.8) + vec2<f32>(t * 0.035, -t * 0.025));\nlet hue = fract(flow.x * 0.075 + flow.y * 0.11 + mist * 0.42 + t * 0.025);\nlet contours = 0.5 + 0.5 * sin(sin(flow.x * 3.1 + sin(flow.y * 3.8 - t * 0.31) * 1.8 + mist * 4.0) * 7.0 + mist * 12.0 - t * 0.45);\nlet base = hsv(hue, 0.78, 0.48 + contours * 0.22);\nlet prism = hsv(fract(hue + seed * 0.35 + 0.13 * smoothstep(-0.007, 0.007, q.x + q.y * 0.24) + 0.04 * sin(length(q) * 72.0 - t * 1.2)), 0.77, 0.85);\nlet activity = smoothstep(0.0, 0.8, amount);\nlet scene = mix(base, prism, fill * activity);\nlet color = clamp(scene + hsv(fract(hue + 0.18 + seed * 0.2), 0.65, 1.0) * vec3<f32>(activity * (exp(-abs(d) * 95.0) * 0.27 + halo * glow * 0.19)), vec3<f32>(0.0), vec3<f32>(1.0));\nreturn mix(bg, color, strength);",
