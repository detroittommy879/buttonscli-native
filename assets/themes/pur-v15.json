      "custom": {
        "expression": "let power = clamp(amount * 0.1, 0.0, 1.0);\nlet uv = p * vec2<f32>(1.55) + vec2<f32>(t * 0.028, -t * 0.045);\nlet tile = floor(uv);\nlet seed = hash(tile);\nlet local = (fract(uv) - vec2<f32>(0.5)) * vec2<f32>(3.8);\nlet turn = select(local, vec2<f32>(-local.y, local.x), seed > 0.5);\nlet q = select(turn, -turn, fract(seed * 7.13) > 0.5);\nlet bar = abs(q - vec2<f32>(0.0, 0.5)) - vec2<f32>(1.45, 0.45);\nlet stem = abs(q - vec2<f32>(0.0, -0.5)) - vec2<f32>(0.45);\nlet db = length(max(bar, vec2<f32>(0.0))) + min(max(bar.x, bar.y), 0.0);\nlet ds = length(max(stem, vec2<f32>(0.0))) + min(max(stem.x, stem.y), 0.0);\nlet d = min(db, ds);\nlet fill = 1.0 - smoothstep(-0.018, 0.018, d);\nlet outline = exp(-abs(d) * 75.0);\nlet aura = exp(-max(d, 0.0) * 12.0);\nlet brick = fract(q + vec2<f32>(0.5, 0.0)) - vec2<f32>(0.5);\nlet studRadius = length(brick);\nlet stud = (1.0 - smoothstep(0.19, 0.215, studRadius)) * fill;\nlet studRim = exp(-abs(studRadius - 0.205) * 80.0) * fill;\nlet studLight = clamp(dot(brick, vec2<f32>(-0.8, 1.0)) + 0.25, 0.0, 0.6);\nlet seam = exp(-abs(abs(brick.x) - 0.5) * 90.0) * fill;\nlet color = mix(palette(seed * 0.85 + t * 0.012), mix(c1, c2, seed), 0.22);\nlet pulse = 0.85 + 0.15 * sin(t * 1.3 + seed * 12.0);\nlet grid = fract(uv * vec2<f32>(3.8));\nlet wires = exp(-min(min(grid.x, 1.0 - grid.x), min(grid.y, 1.0 - grid.y)) * 110.0);\nlet base = vec3<f32>(0.006, 0.008, 0.018) + c3 * vec3<f32>(wires * 0.018);\nlet body = fill * (0.055 + stud * 0.035 + studLight * stud * 0.08) * (1.0 - seam * 0.65);\nlet light = (outline * 0.42 + studRim * 0.16 + aura * 0.025) * pulse;\nlet vignette = 1.0 / (1.0 + dot(p, p) * 0.13);\nreturn clamp((base + color * vec3<f32>((body + light) * (0.35 + power * 0.65))) * vec3<f32>(vignette), vec3<f32>(0.0), vec3<f32>(0.65));",
