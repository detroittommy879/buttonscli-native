      "custom": {
        "expression": "let time = t * storm_speed;\nlet drift = p * vec2<f32>(1.3, 1.8) + vec2<f32>(time * 0.09, time * 0.04);\nlet clouds = cloud(drift + vec2<f32>(cloud(drift), 0.0));\nlet billows = smoothstep(0.25, 0.8, clouds);\nlet sky = mix(c1, c2, billows) * vec3<f32>(0.55 + 0.38 * billows);\nlet horizon = exp(-abs(p.y + 0.65) * 1.6);\nlet atmosphere = mix(sky, c5, 0.17 * horizon);\n\nlet epoch = floor(time * 0.65);\nlet lane = floor((p.x + 1.4) / 2.8);\nlet seed = hash(vec2<f32>(lane, epoch));\nlet local_x = p.x - lane * 2.8;\nlet bolt_x = (seed - 0.5) * 1.6 + 0.14 * sin(p.y * 11.0 + seed * 30.0) + 0.07 * sin(p.y * 29.0 + seed * 17.0);\nlet bolt_distance = abs(local_x - bolt_x);\nlet flash_phase = fract(time * 0.65 + seed * 0.45);\nlet flash = pow(max(0.0, sin(flash_phase * 3.141593)), 18.0);\nlet flicker = 0.68 + 0.32 * sin(time * 63.0 + seed * 19.0);\nlet visibility = smoothstep(-1.3, -0.9, p.y) * (0.14 + flash * flicker);\nlet core = exp(-bolt_distance * 185.0);\nlet halo = exp(-bolt_distance * 14.0) * lightning_glow;\nlet branch_x = bolt_x + max(0.0, 0.35 - p.y) * 0.48 + 0.035 * sin(p.y * 42.0);\nlet branch = exp(-abs(local_x - branch_x) * 155.0) * smoothstep(-0.7, -0.4, p.y) * (1.0 - smoothstep(0.25, 0.4, p.y));\nlet lightning = c4 * vec3<f32>((core + branch * 0.55) * visibility) + c3 * vec3<f32>(halo * visibility * 0.65);\n\nlet rain_uv = vec2<f32>((p.x + p.y * 0.18) * 43.0 * rain_density, p.y * 9.0 + time * 10.0);\nlet rain_cell = floor(rain_uv);\nlet rain_random = hash(rain_cell);\nlet rain_pos = fract(rain_uv);\nlet streak = exp(-abs(rain_pos.x - 0.5) * 48.0) * smoothstep(0.05, 0.25, rain_pos.y) * (1.0 - smoothstep(0.55, 0.95, rain_pos.y));\nlet rain = streak * step(0.43, rain_random) * (0.35 + rain_random * 0.65);\nlet color = atmosphere + lightning + c3 * vec3<f32>(rain * 0.65) + c2 * vec3<f32>(flash * 0.16 * billows);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
        "name": "Electric Downpour",
