      "custom": {
        "expression": "let wash = mix(c4, c2 * 0.45, smoothstep(-0.5, 0.5, p.y));\nlet far_g = p * density * 0.5 + vec2<f32>(t * 0.05 * drift, t * 0.08 * drift);\nlet far_cell = floor(far_g);\nlet far_s = hash(far_cell);\nlet far_d = sd_circle(fract(far_g) - 0.5, 0.06 + 0.1 * far_s);\nlet far_glow = halo(far_d, 0.12) * (0.4 + 0.6 * far_s) * 0.6;\nlet shimmer = 0.5 + 0.5 * sin(t * 0.8 + far_s * 6.28);\nlet mid_g = vec2<f32>(p.x * density, p.y * density + t * 0.15 * drift);\nlet mid_cell = floor(mid_g);\nlet mid_s = hash(mid_cell + vec2<f32>(3.0, 1.0));\nlet mid_rot = rotate(fract(mid_g) - 0.5, t * 0.3 * drift * (mid_s - 0.5));\nlet mid_d = sd_box(mid_rot, vec2<f32>(0.28, 0.28));\nlet mid_line = stroke(mid_d, 0.05) * step(0.45, mid_s);\nlet near_g = vec2<f32>(p.x * density * 0.3 + t * 0.2 * drift, p.y * density * 0.3 + t * 0.25 * drift);\nlet near_cell = floor(near_g);\nlet near_s = hash(near_cell + vec2<f32>(11.0, 5.0));\nlet near_d = sd_circle(fract(near_g) - 0.5, 0.1 + 0.12 * near_s);\nlet near_orb = fill(near_d) * step(0.6, near_s);\nlet near_halo = halo(near_d, 0.2) * step(0.6, near_s);\nlet layers = c1 * far_glow * shimmer + mix(c2, c1, mid_s) * mid_line * 0.9 + mix(c3, c5, near_s) * near_orb * 0.8 + c5 * near_halo * 0.5;\nlet color = wash + layers;\nreturn mix(bg, tonemap(color * 1.2), strength);",
        "name": "Verdant Parallax",
        "variables": [
          {
            "max": 3.0,
            "min": 0.0,
            "name": "drift",
            "value": 1.0
          },
