        "expression": "let trip = m * 0.1;\nlet drift = p * vec2<f32>(density) + vec2<f32>(t * 0.045, -t * 0.035);\nlet uv = drift + vec2<f32>(sin(drift.y * 3.2 + t * 0.7), cos(drift.x * 2.8 - t * 0.6)) * vec2<f32>(wobble * (0.04 + trip * 0.18));\nlet seed = hash(floor(uv));\nlet q = fract(uv) - vec2<f32>(0.5);\nlet hue = seed + t * 0.025 + trip * 0.12 * sin(t * 0.4 + seed * 9.0);\nlet candy = mix(c1 * vec3<f32>(4.0) + vec3<f32>(0.22, 0.10, 0.28), palette(hue), 0.7);\nlet ground = mix(c2 * vec3<f32>(2.0) + vec3<f32>(0.06, 0.025, 0.10), palette(hue + 0.45) * vec3<f32>(0.33), 0.55);\nlet d = length(max(abs(q) - vec2<f32>(0.21, 0.19), vec2<f32>(0.0))) - 0.15;\nlet body = 1.0 - smoothstep(-0.008, 0.012, d);\nlet ripple = 0.5 + 0.5 * sin(length(q) * (24.0 + trip * 28.0) - t * 2.0 + seed * 8.0);\nlet face = mix(ground + candy * vec3<f32>(exp(-15.0 * abs(d)) * glow * 0.32), candy * vec3<f32>(0.73 + 0.25 * ripple), body);\nlet eyes = 1.0 - smoothstep(0.052, 0.065, length(vec2<f32>(abs(q.x) - 0.12, q.y + 0.075)));\nlet smile = (1.0 - smoothstep(0.012, 0.024, abs(length(q - vec2<f32>(0.0, 0.015)) - 0.175))) * smoothstep(0.025, 0.065, q.y - 0.015);\nlet third = (1.0 - smoothstep(0.027, 0.043, length(q - vec2<f32>(0.0, -0.225)))) * trip;\nlet color = mix(mix(mix(face, vec3<f32>(0.72, 0.83, 0.65), eyes), c3, smile), palette(hue + 0.5), third);\nreturn mix(bg, clamp(color, vec3<f32>(0.0), vec3<f32>(1.0)), strength);",
