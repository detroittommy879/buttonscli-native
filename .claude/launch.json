{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321,
      "url": "http://localhost:4321"
    },
    {
      "name": "shader-playground",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "shader-playground"
      ],
      "port": 8765
    },
    {
      "name": "homepage-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        ".private/site-preview/html"
      ],
      "port": 8766
    }
  ]
}
